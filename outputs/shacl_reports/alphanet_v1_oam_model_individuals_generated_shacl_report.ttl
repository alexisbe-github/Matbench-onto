@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_architecture> ;
            sh:resultMessage "only a MachineLearningArchitecture should have an architecture configuration." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureConfigurationSubjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:n56915e75172a4e47b635cbc20e53ecfbb1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_model_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:n56915e75172a4e47b635cbc20e53ecfbb1 ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_architecture> ;
            sh:resultMessage "arch:hasMachineLearningArchitecture must point to a MachineLearningArchitecture." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureObjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#alphanet_v1_mptrj_alphanet_architecture> ] .

_:n56915e75172a4e47b635cbc20e53ecfbb1 sh:class arch:MachineLearningArchitecture ;
    sh:message "every ModelVariant should link to a MachineLearningArchitecture." ;
    sh:minCount 1 ;
    sh:path arch:hasMachineLearningArchitecture .

