@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_model_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:nb3a282b5769f4ac2ba691e8a64d7041ab1 ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/trainingonto-individuals#hienet_mptrj_training> ;
            sh:resultMessage "train:usesDataset must have a MachineLearningTrainingRun as subject." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape train:UsesDatasetSubjectShape ;
            sh:value <https://k.loria.fr/ontologies/trainingonto-individuals#hienet_mptrj_training> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> ;
            sh:resultMessage "arch:hasMachineLearningArchitecture must point to a MachineLearningArchitecture." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureObjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nb3a282b5769f4ac2ba691e8a64d7041ab1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> ;
            sh:resultMessage "only a MachineLearningArchitecture should have an architecture configuration." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureConfigurationSubjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> ] .

_:nb3a282b5769f4ac2ba691e8a64d7041ab1 sh:class arch:MachineLearningArchitecture ;
    sh:message "every ModelVariant should link to a MachineLearningArchitecture." ;
    sh:minCount 1 ;
    sh:path arch:hasMachineLearningArchitecture .

