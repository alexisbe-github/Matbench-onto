@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_model_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape _:nc35660f2ae4d4b2ba2676d17cd679959b1 ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_variant> ;
            sh:resultMessage "every ModelVariant should link to a MachineLearningArchitecture." ;
            sh:resultPath arch:hasMachineLearningArchitecture ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape _:nc35660f2ae4d4b2ba2676d17cd679959b1 ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_architecture> ;
            sh:resultMessage "only a MachineLearningArchitecture should have an architecture configuration." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureConfigurationSubjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_architecture> ],
        [ a sh:ValidationResult ;
            sh:focusNode <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_architecture> ;
            sh:resultMessage "arch:hasMachineLearningArchitecture must point to a MachineLearningArchitecture." ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:ClassConstraintComponent ;
            sh:sourceShape arch:HasArchitectureObjectShape ;
            sh:value <https://k.loria.fr/ontologies/architectureonto-individuals#sevennet_0_nequip_architecture> ] .

_:nc35660f2ae4d4b2ba2676d17cd679959b1 sh:class arch:MachineLearningArchitecture ;
    sh:message "every ModelVariant should link to a MachineLearningArchitecture." ;
    sh:minCount 1 ;
    sh:path arch:hasMachineLearningArchitecture .

