trind:mace_mp_0b3_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MACE-MP-0b3"^^xsd:string ;
    train:generatedBy trind:mace_mp_0_pretraining .

archind:mace_mp_0_mace_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MACE architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 128 ;
    arch:hasLayerCount 2 .

dataind:atomic_numbers_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic numbers"^^xsd:string .

dataind:atomic_positions_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic positions"^^xsd:string .

dataind:cell_parameters_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "cell parameters"^^xsd:string .

dataind:crystal_structure_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "crystal structure"^^xsd:string .

dataind:dft_labelling_method a owl:NamedIndividual,
        data:LabellingMethod ;
    rdfs:label "DFT"^^xsd:string .

dataind:energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "energy"^^xsd:string .

dataind:forces_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "forces"^^xsd:string .

dataind:kappa_103_phonon_benchmark_set a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "kappa-103 phonon benchmark set"^^xsd:string .

dataind:materials_project a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials Project"^^xsd:string .

dataind:mptrj a owl:NamedIndividual,
        data:LabeledDataset,
        train:TrainingDataset ;
    rdfs:label "MPtrj"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 1500000 ;
    data:usesAttributeAsInputFeature dataind:atomic_numbers_attribute,
        dataind:atomic_positions_attribute,
        dataind:cell_parameters_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:forces_attribute,
        dataind:stress_attribute ;
    data:wasDerivedFromDataset dataind:materials_project .

dataind:stress_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "stress"^^xsd:string .

evalind:kappa_sre_metric_type a owl:NamedIndividual,
        eval:MetricType ;
    rdfs:label "κ_SRE"^^xsd:string .

