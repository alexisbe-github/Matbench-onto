archind:pet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "PET"^^xsd:string ;
    arch:hasVariant archind:pet_oam_xl_1_0_0_pet_model_variant,
        archind:pet_oam_xl_1_0_0_variant .

evalind:pet_oam_xl_1_0_0_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "pet_oam_xl_1_0_0_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:pet_oam_xl_1_0_0_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:pet_oam_xl_1_0_0_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:pet_oam_xl_1_0_0_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
