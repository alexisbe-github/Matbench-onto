trind:pet_mad_lora_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "pet_mad_lora_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning of pre-trained PET-MAD using Low-Rank Adaptation (LoRA) with rank 8 and scaling parameter 0.5 on system-specific datasets for six case studies: lithium thiophosphate, gallium arsenide, high-entropy alloy CoCrFeMnNi, liquid water, succinic acid, and barium titanate"^^xsd:string ;
    train:hasHyperparameterValue trind:pet_mad_lora_finetuning_ase_optimizer_value,
        trind:pet_mad_lora_finetuning_attention_heads_value,
        trind:pet_mad_lora_finetuning_batch_size_value,
        trind:pet_mad_lora_finetuning_cell_filter_value,
        trind:pet_mad_lora_finetuning_cutoff_function_value,
        trind:pet_mad_lora_finetuning_cutoff_radius_value,
        trind:pet_mad_lora_finetuning_cutoff_value,
        trind:pet_mad_lora_finetuning_cutoff_width_value,
        trind:pet_mad_lora_finetuning_d_feedforward_value,
        trind:pet_mad_lora_finetuning_d_head_value,
        trind:pet_mad_lora_finetuning_d_node_value,
        trind:pet_mad_lora_finetuning_d_pet_value,
        trind:pet_mad_lora_finetuning_energy_loss_weight_value,
        trind:pet_mad_lora_finetuning_epochs_value,
        trind:pet_mad_lora_finetuning_learning_rate_value,
        trind:pet_mad_lora_finetuning_loss_function_type_value,
        trind:pet_mad_lora_finetuning_lr_scheduler_value,
        trind:pet_mad_lora_finetuning_max_force_value,
        trind:pet_mad_lora_finetuning_max_steps_value,
        trind:pet_mad_lora_finetuning_message_passing_layers_value,
        trind:pet_mad_lora_finetuning_mlp_neurons_value,
        trind:pet_mad_lora_finetuning_num_attention_layers_value,
        trind:pet_mad_lora_finetuning_num_gnn_layers_value,
        trind:pet_mad_lora_finetuning_num_neighbors_adaptive_value,
        trind:pet_mad_lora_finetuning_token_size_value,
        trind:pet_mad_lora_finetuning_transformer_layers_per_message_passing_value ;
    train:trainsModelVariant archind:pet_oam_xl_1_0_0_pet_model_variant ;
    train:usesDataset dataind:batio3,
        dataind:gaas,
        dataind:hea25s,
        dataind:lps,
        dataind:succinic_acid,
        dataind:water .

trind:pet_mad_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pet_mad_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of PET-MAD on the MAD dataset (95,595 structures) using the PET graph neural network architecture with 2.8M parameters, trained for 1500 epochs with Adam optimizer and RMSE loss"^^xsd:string ;
    train:hasHyperparameterValue trind:pet_mad_pretraining_ase_optimizer_value,
        trind:pet_mad_pretraining_attention_heads_value,
        trind:pet_mad_pretraining_batch_size_value,
        trind:pet_mad_pretraining_cell_filter_value,
        trind:pet_mad_pretraining_cutoff_function_value,
        trind:pet_mad_pretraining_cutoff_radius_value,
        trind:pet_mad_pretraining_cutoff_value,
        trind:pet_mad_pretraining_cutoff_width_value,
        trind:pet_mad_pretraining_d_feedforward_value,
        trind:pet_mad_pretraining_d_head_value,
        trind:pet_mad_pretraining_d_node_value,
        trind:pet_mad_pretraining_d_pet_value,
        trind:pet_mad_pretraining_energy_loss_weight_value,
        trind:pet_mad_pretraining_epochs_value,
        trind:pet_mad_pretraining_learning_rate_value,
        trind:pet_mad_pretraining_loss_function_type_value,
        trind:pet_mad_pretraining_lr_scheduler_value,
        trind:pet_mad_pretraining_max_force_value,
        trind:pet_mad_pretraining_max_steps_value,
        trind:pet_mad_pretraining_message_passing_layers_value,
        trind:pet_mad_pretraining_mlp_neurons_value,
        trind:pet_mad_pretraining_num_attention_layers_value,
        trind:pet_mad_pretraining_num_gnn_layers_value,
        trind:pet_mad_pretraining_num_neighbors_adaptive_value,
        trind:pet_mad_pretraining_token_size_value,
        trind:pet_mad_pretraining_transformer_layers_per_message_passing_value ;
    train:trainsModelVariant archind:pet_oam_xl_1_0_0_pet_model_variant ;
    train:usesDataset dataind:mad ;
    train:usesLoss trind:root_mean_square_error ;
    train:usesOptimizer trind:adam .

archind:pet_oam_xl_1_0_0_pet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "PET architecture configuration"^^xsd:string .

