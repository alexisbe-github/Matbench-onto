trind:dpa4_pro_mptrj_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "dpa4_pro_mptrj_pretraining"^^xsd:string ;
    rdfs:comment "DPA4-Pro trained on MPtrj with conservative energy-gradient path using HybridMuon optimizer, bf16 mixed precision, warmup-stable-decay learning rate schedule, without DeNS or direct-force pretraining"^^xsd:string ;
    train:hasHyperparameterValue trind:dpa4_pro_mptrj_pretraining_angular_order_value,
        trind:dpa4_pro_mptrj_pretraining_ase_optimizer_value,
        trind:dpa4_pro_mptrj_pretraining_attention_heads_value,
        trind:dpa4_pro_mptrj_pretraining_cell_filter_value,
        trind:dpa4_pro_mptrj_pretraining_cutoff_radius_value,
        trind:dpa4_pro_mptrj_pretraining_focus_count_value,
        trind:dpa4_pro_mptrj_pretraining_graph_construction_radius_value,
        trind:dpa4_pro_mptrj_pretraining_hidden_width_value,
        trind:dpa4_pro_mptrj_pretraining_interaction_depth_value,
        trind:dpa4_pro_mptrj_pretraining_learning_rate_schedule_value,
        trind:dpa4_pro_mptrj_pretraining_loss_weights_value,
        trind:dpa4_pro_mptrj_pretraining_max_force_value,
        trind:dpa4_pro_mptrj_pretraining_max_neighbors_value,
        trind:dpa4_pro_mptrj_pretraining_max_steps_value,
        trind:dpa4_pro_mptrj_pretraining_mixing_precision_value,
        trind:dpa4_pro_mptrj_pretraining_optimizer_value,
        trind:dpa4_pro_mptrj_pretraining_radial_basis_size_value ;
    train:trainsModelVariant archind:dpa_4_0_1_pro_mptrj_dpa4_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:conservativeenergygradientloss ;
    train:usesObjectiveFunction trind:conservativeenergygradientloss ;
    train:usesOptimizer trind:hybridmuon .

