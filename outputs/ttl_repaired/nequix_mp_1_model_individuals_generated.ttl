trind:nequix_mp_1_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "nequix_mp_1_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:nequix_mp_1_training_run_ase_optimizer_value,
        trind:nequix_mp_1_training_run_batch_size_value,
        trind:nequix_mp_1_training_run_cell_filter_value,
        trind:nequix_mp_1_training_run_ema_decay_value,
        trind:nequix_mp_1_training_run_grad_clip_norm_value,
        trind:nequix_mp_1_training_run_graph_construction_radius_value,
        trind:nequix_mp_1_training_run_hidden_irreps_value,
        trind:nequix_mp_1_training_run_layer_norm_value,
        trind:nequix_mp_1_training_run_lmax_value,
        trind:nequix_mp_1_training_run_max_force_value,
        trind:nequix_mp_1_training_run_max_neighbors_value,
        trind:nequix_mp_1_training_run_max_steps_value,
        trind:nequix_mp_1_training_run_n_epochs_value,
        trind:nequix_mp_1_training_run_optimizer_value,
        trind:nequix_mp_1_training_run_radial_basis_size_value,
        trind:nequix_mp_1_training_run_radial_mlp_layers_value,
        trind:nequix_mp_1_training_run_radial_mlp_size_value,
        trind:nequix_mp_1_training_run_radial_polynomial_p_value,
        trind:nequix_mp_1_training_run_warmup_epochs_value,
        trind:nequix_mp_1_training_run_warmup_factor_value,
        trind:nequix_mp_1_training_run_weight_decay_value ;
    train:trainsModelVariant archind:nequix_mp_1_nequix_model_variant ;
    train:usesOptimizer trind:muon .

