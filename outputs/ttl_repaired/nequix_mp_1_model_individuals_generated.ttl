archind:nequix_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Nequix"^^xsd:string ;
    arch:hasVariant archind:nequix_mp_1_nequix_model_variant,
        archind:nequix_mp_1_variant .

evalind:nequix_mp_1_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "nequix_mp_1_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:nequix_mp_1_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:nequix_mp_1_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:nequix_mp_1_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
