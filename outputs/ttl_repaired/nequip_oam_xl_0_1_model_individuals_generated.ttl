trind:allegro_spice2_training a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "allegro_spice2_training"^^xsd:string ;
    rdfs:comment "Training of Allegro models on the SPICE 2 dataset containing over two million atomic configurations of organic systems with energies and forces calculated using DFT with the ωB97M-D3(BJ) functional. Models were trained on a subset limited to systems with neutral total charge."^^xsd:string ;
    train:hasHyperparameterValue trind:allegro_spice2_training_ase_optimizer_value,
        trind:allegro_spice2_training_batch_size_value,
        trind:allegro_spice2_training_cell_filter_value,
        trind:allegro_spice2_training_epochs_value,
        trind:allegro_spice2_training_gradient_clip_val_value,
        trind:allegro_spice2_training_graph_construction_radius_value,
        trind:allegro_spice2_training_initial_learning_rate_value,
        trind:allegro_spice2_training_learning_rate_schedule_value,
        trind:allegro_spice2_training_loss_value,
        trind:allegro_spice2_training_max_force_value,
        trind:allegro_spice2_training_max_neighbors_value,
        trind:allegro_spice2_training_max_steps_value,
        trind:allegro_spice2_training_maximum_rotation_order_value,
        trind:allegro_spice2_training_n_features_value,
        trind:allegro_spice2_training_n_layers_value,
        trind:allegro_spice2_training_n_radial_bessel_basis_value,
        trind:allegro_spice2_training_number_of_allegro_layers_value,
        trind:allegro_spice2_training_number_of_tensor_features_value,
        trind:allegro_spice2_training_optimizer_value,
        trind:allegro_spice2_training_parity_value,
        trind:allegro_spice2_training_polynomial_cutoff_value,
        trind:allegro_spice2_training_radial_cutoff_value,
        trind:allegro_spice2_training_sph_harmonics_l_max_value,
        trind:allegro_spice2_training_type_embed_num_features_value,
        trind:allegro_spice2_training_weight_decay_value,
        trind:allegro_spice2_training_zbl_potential_value ;
    train:trainsModelVariant archind:nequip_oam_xl_0_1_equivariantmessagepassingneuralnetworkarchitecture_model_variant ;
    train:usesDataset dataind:spice_2 .

trind:allegro_spice2_training_ase_optimizer_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training ase_optimizer value"^^xsd:string ;
    prov:value "GOQN"^^xsd:string ;
    train:ofHyperparameter trind:ase_optimizer .

trind:allegro_spice2_training_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training batch_size value"^^xsd:string ;
    prov:value 640 ;
    train:ofHyperparameter trind:batch_size .

trind:allegro_spice2_training_cell_filter_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training cell_filter value"^^xsd:string ;
    prov:value "FrechetCellFilter"^^xsd:string ;
    train:ofHyperparameter trind:cell_filter .

trind:allegro_spice2_training_epochs_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training epochs value"^^xsd:string ;
    prov:value 30 ;
    train:ofHyperparameter trind:epochs .

trind:allegro_spice2_training_gradient_clip_val_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training gradient_clip_val value"^^xsd:string ;
    prov:value "0.25"^^xsd:float ;
    train:ofHyperparameter trind:gradient_clip_val .

trind:allegro_spice2_training_graph_construction_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training graph_construction_radius value"^^xsd:string ;
    prov:value "6.0"^^xsd:float ;
    train:ofHyperparameter trind:graph_construction_radius .

trind:allegro_spice2_training_initial_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training initial_learning_rate value"^^xsd:string ;
    prov:value "0.005"^^xsd:float ;
    train:ofHyperparameter trind:initial_learning_rate .

trind:allegro_spice2_training_learning_rate_schedule_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training learning_rate_schedule value"^^xsd:string ;
    prov:value "ReduceLROnPlateau - factor=0.1, patience=100, min_lr=1e-6"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate_schedule .

trind:allegro_spice2_training_loss_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training loss value"^^xsd:string ;
    prov:value "Huber - delta=0.01 for energy, delta=0.1 for stress, stratified delta (0.01, 0.007, 0.004, 0.001) for force"^^xsd:string ;
    train:ofHyperparameter trind:loss .

trind:allegro_spice2_training_max_force_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training max_force value"^^xsd:string ;
    prov:value "0.005"^^xsd:float ;
    train:ofHyperparameter trind:max_force .

trind:allegro_spice2_training_max_neighbors_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training max_neighbors value"^^xsd:string ;
    prov:value "INF"^^xsd:float ;
    train:ofHyperparameter trind:max_neighbors .

trind:allegro_spice2_training_max_steps_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training max_steps value"^^xsd:string ;
    prov:value 500 ;
    train:ofHyperparameter trind:max_steps .

trind:allegro_spice2_training_maximum_rotation_order_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training maximum_rotation_order value"^^xsd:string ;
    prov:value 3 ;
    train:ofHyperparameter trind:maximum_rotation_order .

trind:allegro_spice2_training_n_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training n_features value"^^xsd:string ;
    prov:value "320 (l=0 scalars), 96 (l=1 vectors), 64 (l=2 tensors), 32 (l=3,4 tensors)"^^xsd:string ;
    train:ofHyperparameter trind:n_features .

trind:allegro_spice2_training_n_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training n_layers value"^^xsd:string ;
    prov:value 6 ;
    train:ofHyperparameter trind:n_layers .

trind:allegro_spice2_training_n_radial_bessel_basis_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training n_radial_bessel_basis value"^^xsd:string ;
    prov:value 8 ;
    train:ofHyperparameter trind:n_radial_bessel_basis .

trind:allegro_spice2_training_number_of_allegro_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training number_of_allegro_layers value"^^xsd:string ;
    prov:value 3 ;
    train:ofHyperparameter trind:number_of_allegro_layers .

trind:allegro_spice2_training_number_of_tensor_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_spice2_training number_of_tensor_features value"^^xsd:string ;
    prov:value 128 ;
    train:ofHyperparameter trind:number_of_tensor_features .

trind:allegro_spice2_training_optimizer_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
