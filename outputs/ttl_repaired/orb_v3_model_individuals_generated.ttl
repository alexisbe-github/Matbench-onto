archind:orb_v3_orb_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "ORB architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 512 .

