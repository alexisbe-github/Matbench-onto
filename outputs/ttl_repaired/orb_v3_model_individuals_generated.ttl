archind:orb_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ORB"^^xsd:string ;
    arch:hasVariant archind:orb_v3_orb_model_variant,
        archind:orb_v3_variant .

evalind:orb_v3_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "orb_v3_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:orb_v3_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:orb_v3_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:orb_v3_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "orb_v3_matbench_discovery_phonon_thermal_conductivity_contribution"^^xsd:string ;
    eval:evaluatesModelVariant archind:orb_v3_variant ;
    eval:evaluatesTask evalind:phonon_thermal_conductivity_contribution_task ;
    eval:producesBenchmarkResult evalind:orb_v3_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:orb_v3_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "orb_v3_matbench_discovery_relaxed_structure_matching_rmsd"^^xsd:string ;
    eval:evaluatesModelVariant archind:orb_v3_variant ;
    eval:evaluatesTask evalind:relaxed_structure_matching_rmsd_task ;
    eval:producesBenchmarkResult evalind:orb_v3_matbench_discovery_relaxed_structure_matching_rmsd_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:orb_v3_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "orb_v3_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:orb_v3_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:orb_v3_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:orb_v3_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "orb_v3_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:orb_v3_training_run_ase_optimizer_value,
        trind:orb_v3_training_run_batch_size_value,
        trind:orb_v3_training_run_cell_filter_value,
        trind:orb_v3_training_run_ema_decay_value,
        trind:orb_v3_training_run_features_value,
        trind:orb_v3_training_run_gradient_clip_value,
        trind:orb_v3_training_run_graph_construction_radius_value,
        trind:orb_v3_training_run_initial_learning_rate_value,
        trind:orb_v3_training_run_learning_rate_schedule_value,
        trind:orb_v3_training_run_loss_value,
        trind:orb_v3_training_run_max_force_value,
        trind:orb_v3_training_run_max_neighbors_value,
        trind:orb_v3_training_run_max_steps_value,
        trind:orb_v3_training_run_n_layers_value,
        trind:orb_v3_training_run_num_rbfs_value,
        trind:orb_v3_training_run_optimizer_value ;
    train:trainsModelVariant archind:orb_v3_orb_model_variant ;
    train:usesLoss trind:mae ;
    train:usesOptimizer trind:adam .

archind:orb_attention_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "attention layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:orb_attention_layers_component_configuration .

archind:orb_attention_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "attention layers component configuration"^^xsd:string .

archind:orb_confidence_head_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "confidence head component configuration"^^xsd:string .

archind:orb_gns_backbone_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "GNS backbone"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:orb_gns_backbone_component_configuration .

archind:orb_gns_backbone_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "GNS backbone component configuration"^^xsd:string .

archind:orb_gns_component a owl:NamedIndividual,
