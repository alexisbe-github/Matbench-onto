        trind:pretraining_on_inorganic_crystals_loss_weight_force_value,
        trind:pretraining_on_inorganic_crystals_loss_weight_regularization_value,
        trind:pretraining_on_inorganic_crystals_loss_weight_stress_value,
        trind:pretraining_on_inorganic_crystals_max_force_value,
        trind:pretraining_on_inorganic_crystals_max_neighbors_value,
        trind:pretraining_on_inorganic_crystals_max_spherical_harmonics_order_value,
        trind:pretraining_on_inorganic_crystals_max_steps_value,
        trind:pretraining_on_inorganic_crystals_n_layers_value,
        trind:pretraining_on_inorganic_crystals_n_radial_bessel_basis_value,
        trind:pretraining_on_inorganic_crystals_node_feature_dimensions_value,
        trind:pretraining_on_inorganic_crystals_num_convolution_layers_value,
        trind:pretraining_on_inorganic_crystals_optimizer_type_value,
        trind:pretraining_on_inorganic_crystals_optimizer_value,
        trind:pretraining_on_inorganic_crystals_sph_harmonics_l_max_value ;
    train:trainsModelVariant archind:sevennet_omni_i12_nequip_model_variant ;
    train:usesDataset dataind:alex,
        dataind:mptrj,
        dataind:omat24 ;
    train:usesLoss trind:energy_force_stress_regularization_loss ;
    train:usesOptimizer trind:adam .

