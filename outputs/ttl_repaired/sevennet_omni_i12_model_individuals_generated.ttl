@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:sevennet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "SevenNet"^^xsd:string ;
    arch:hasVariant archind:sevennet_omni_i12_nequip_model_variant,
        archind:sevennet_omni_i12_variant .

evalind:sevennet_omni_i12_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_omni_i12_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:sevennet_omni_i12_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:sevennet_omni_i12_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:sevennet_omni_i12_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_omni_i12_matbench_discovery_phonon_thermal_conductivity_contribution"^^xsd:string ;
    eval:evaluatesModelVariant archind:sevennet_omni_i12_variant ;
    eval:evaluatesTask evalind:phonon_thermal_conductivity_contribution_task ;
    eval:producesBenchmarkResult evalind:sevennet_omni_i12_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:sevennet_omni_i12_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_omni_i12_matbench_discovery_relaxed_structure_matching_rmsd"^^xsd:string ;
    eval:evaluatesModelVariant archind:sevennet_omni_i12_variant ;
    eval:evaluatesTask evalind:relaxed_structure_matching_rmsd_task ;
    eval:producesBenchmarkResult evalind:sevennet_omni_i12_matbench_discovery_relaxed_structure_matching_rmsd_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:sevennet_omni_i12_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_omni_i12_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:sevennet_omni_i12_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:sevennet_omni_i12_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:full_multidomain_training a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "full_multidomain_training"^^xsd:string ;
    rdfs:comment "Final training stage on all 15 databases (242M structures) with selective task regularization and domain-bridging set, using curriculum learning and multi-task training across diverse material domains and computational protocols."^^xsd:string ;
    train:hasHyperparameterValue trind:full_multidomain_training_ase_optimizer_value,
        trind:full_multidomain_training_batch_size_value,
        trind:full_multidomain_training_cell_filter_value,
        trind:full_multidomain_training_epochs_value,
        trind:full_multidomain_training_graph_construction_radius_value,
        trind:full_multidomain_training_initial_learning_rate_value,
        trind:full_multidomain_training_learning_rate_schedule_value,
        trind:full_multidomain_training_learning_rate_value,
        trind:full_multidomain_training_loss_value,
        trind:full_multidomain_training_loss_weight_energy_value,
        trind:full_multidomain_training_loss_weight_force_value,
        trind:full_multidomain_training_loss_weight_regularization_value,
        trind:full_multidomain_training_loss_weight_stress_value,
        trind:full_multidomain_training_max_force_value,
        trind:full_multidomain_training_max_neighbors_value,
        trind:full_multidomain_training_max_spherical_harmonics_order_value,
        trind:full_multidomain_training_max_steps_value,
        trind:full_multidomain_training_n_layers_value,
        trind:full_multidomain_training_n_radial_bessel_basis_value,
        trind:full_multidomain_training_node_feature_dimensions_value,
        trind:full_multidomain_training_num_convolution_layers_value,
        trind:full_multidomain_training_optimizer_type_value,
        trind:full_multidomain_training_optimizer_value,
        trind:full_multidomain_training_sph_harmonics_l_max_value ;
    train:trainsModelVariant archind:sevennet_omni_i12_nequip_model_variant ;
    train:usesDataset dataind:alex,
        dataind:dbs,
        dataind:mad,
        dataind:matpes,
        dataind:matpes_r2scan,
        dataind:mp_aloe,
        dataind:mp_r2scan,
        dataind:mptrj,
        dataind:oc20,
        dataind:oc22,
        dataind:odac23,
        dataind:omat24,
        dataind:omol25,
        dataind:qcml,
        dataind:spice ;
    train:usesLoss trind:energy_force_stress_regularization_loss ;
    train:usesOptimizer trind:adam .

trind:molecular_extension_training a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "molecular_extension_training"^^xsd:string ;
    rdfs:comment "Second curriculum stage extending the pretrained model with molecular data (OMol25) and domain-bridging set structures derived from OMol25."^^xsd:string ;
    train:hasHyperparameterValue trind:molecular_extension_training_ase_optimizer_value,
        trind:molecular_extension_training_batch_size_value,
        trind:molecular_extension_training_cell_filter_value,
        trind:molecular_extension_training_epochs_value,
        trind:molecular_extension_training_graph_construction_radius_value,
        trind:molecular_extension_training_initial_learning_rate_value,
        trind:molecular_extension_training_learning_rate_schedule_value,
        trind:molecular_extension_training_learning_rate_value,
        trind:molecular_extension_training_loss_value,
        trind:molecular_extension_training_loss_weight_energy_value,
        trind:molecular_extension_training_loss_weight_force_value,
        trind:molecular_extension_training_loss_weight_regularization_value,
        trind:molecular_extension_training_loss_weight_stress_value,
        trind:molecular_extension_training_max_force_value,
        trind:molecular_extension_training_max_neighbors_value,
        trind:molecular_extension_training_max_spherical_harmonics_order_value,
        trind:molecular_extension_training_max_steps_value,
        trind:molecular_extension_training_n_layers_value,
        trind:molecular_extension_training_n_radial_bessel_basis_value,
        trind:molecular_extension_training_node_feature_dimensions_value,
        trind:molecular_extension_training_num_convolution_layers_value,
        trind:molecular_extension_training_optimizer_type_value,
        trind:molecular_extension_training_optimizer_value,
        trind:molecular_extension_training_sph_harmonics_l_max_value ;
    train:trainsModelVariant archind:sevennet_omni_i12_nequip_model_variant ;
    train:usesDataset dataind:alex,
        dataind:dbs,
        dataind:mptrj,
        dataind:omat24,
        dataind:omol25 ;
    train:usesLoss trind:energy_force_stress_regularization_loss ;
    train:usesOptimizer trind:adam .

trind:pretraining_on_inorganic_crystals a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pretraining_on_inorganic_crystals"^^xsd:string ;
    rdfs:comment "Pretraining stage on inorganic crystal databases (MPtrj, sAlex, OMat24) using the SevenNet-MF multi-fidelity architecture, producing the intermediate model 7net-ompa."^^xsd:string ;
    train:hasHyperparameterValue trind:pretraining_on_inorganic_crystals_ase_optimizer_value,
