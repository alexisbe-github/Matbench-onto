archind:equiformer_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Equiformer"^^xsd:string ;
    arch:hasVariant archind:equiformer_v3_mp_equiformerv3_model_variant,
        archind:equiformer_v3_mp_variant .

evalind:equiformer_v3_mp_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "equiformer_v3_mp_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:equiformer_v3_mp_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:equiformer_v3_mp_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

