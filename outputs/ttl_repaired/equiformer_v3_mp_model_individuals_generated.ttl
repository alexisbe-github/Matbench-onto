trind:direct_pretraining_mptrj a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "direct_pretraining_mptrj"^^xsd:string ;
    rdfs:comment "Direct pre-training of EquiformerV3 on MPtrj dataset with DeNS auxiliary task, dropout, and stochastic depth for 70 epochs using FP16"^^xsd:string ;
    train:hasHyperparameterValue trind:direct_pretraining_mptrj_ase_optimizer_value,
        trind:direct_pretraining_mptrj_attention_alpha_hidden_size_value,
        trind:direct_pretraining_mptrj_attention_value_hidden_size_value,
        trind:direct_pretraining_mptrj_attention_value_size_per_head_value,
        trind:direct_pretraining_mptrj_batch_size_value,
        trind:direct_pretraining_mptrj_cell_filter_value,
        trind:direct_pretraining_mptrj_cutoff_radius_value,
        trind:direct_pretraining_mptrj_dens_coefficient_value,
        trind:direct_pretraining_mptrj_dens_corruption_ratio_value,
        trind:direct_pretraining_mptrj_dens_noise_std_value,
        trind:direct_pretraining_mptrj_dens_probability_value,
        trind:direct_pretraining_mptrj_dens_standard_deviation_value,
        trind:direct_pretraining_mptrj_dropout_rate_value,
        trind:direct_pretraining_mptrj_embedding_dimension_value,
        trind:direct_pretraining_mptrj_energy_coefficient_value,
        trind:direct_pretraining_mptrj_ffn_hidden_size_after_swiglu_s2_activation_value,
        trind:direct_pretraining_mptrj_force_coefficient_value,
        trind:direct_pretraining_mptrj_gradient_clipping_norm_threshold_value,
        trind:direct_pretraining_mptrj_graph_construction_radius_value,
        trind:direct_pretraining_mptrj_grid_resolution_attention_value,
        trind:direct_pretraining_mptrj_grid_resolution_ffn_value,
        trind:direct_pretraining_mptrj_learning_rate_value,
        trind:direct_pretraining_mptrj_lmax_value,
        trind:direct_pretraining_mptrj_max_force_value,
        trind:direct_pretraining_mptrj_max_neighbors_value,
        trind:direct_pretraining_mptrj_max_steps_value,
        trind:direct_pretraining_mptrj_maximum_degree_value,
        trind:direct_pretraining_mptrj_maximum_number_of_neighbors_value,
        trind:direct_pretraining_mptrj_maximum_order_value,
        trind:direct_pretraining_mptrj_mmax_value,
        trind:direct_pretraining_mptrj_model_ema_decay_value,
        trind:direct_pretraining_mptrj_num_attention_heads_value,
        trind:direct_pretraining_mptrj_num_blocks_value,
        trind:direct_pretraining_mptrj_number_of_attention_heads_value,
        trind:direct_pretraining_mptrj_number_of_epochs_value,
        trind:direct_pretraining_mptrj_number_of_radial_bases_value,
        trind:direct_pretraining_mptrj_number_of_transformer_blocks_value,
        trind:direct_pretraining_mptrj_stochastic_depth_value,
        trind:direct_pretraining_mptrj_stress_coefficient_value,
        trind:direct_pretraining_mptrj_warmup_epochs_value,
        trind:direct_pretraining_mptrj_weight_decay_value ;
    train:trainsModelVariant archind:equiformer_v3_mp_equiformerv3_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesOptimizer trind:adamw .

