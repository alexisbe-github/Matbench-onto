        train:MachineLearningHyperparameterValue ;
    rdfs:label "megnet MEGNet embedding_dimension value"^^xsd:string ;
    train:ofHyperparameter trind:embedding_dimension .

trind:megnet_megnet_learning_rate_value a owl:NamedIndividual,
