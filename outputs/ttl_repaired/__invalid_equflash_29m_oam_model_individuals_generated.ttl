        train:Checkpoint ;
    rdfs:label "equflash-29M-oam"^^xsd:string ;
    train:generatedBy trind:equflash_pretraining .

trind:sevennet_l2i5_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "SevenNet-l2i5"^^xsd:string ;
    train:generatedBy trind:sevennet_pretraining .

archind:equflash_29m_oam_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "equflash_29m_oam"^^xsd:string ;
    dcterms:source <https://openreview.net/pdf?id=wiQe95BPaB> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\equflash_29m_oam.yml" ;
    arch:hasParameterNumber 28741188 ;
    arch:hasMachineLearningArchitecture archind:equflash_29m_oam_architecture .

