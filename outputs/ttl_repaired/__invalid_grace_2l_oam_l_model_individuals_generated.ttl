trind:oam_finetuning a owl:NamedIndividual,
        train:MachineLearningTrainingRun,
        train:MachineLearningFinetuningRun ;
    rdfs:label "oam_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning of OMat-base models on combined MPTraj and sAlex datasets with increased energy loss weight"^^xsd:string ;
    train:hasHyperparameterValue trind:grace_1l_oam_grace_1l_batch_size_value,
        trind:grace_1l_oam_grace_1l_chemical_embedding_dimension_value,
        trind:grace_1l_oam_grace_1l_cutoff_radius_value,
        trind:grace_1l_oam_grace_1l_learning_rate_value,
        trind:grace_1l_oam_grace_1l_lmax_per_product_order_value,
        trind:grace_1l_oam_grace_1l_loss_weights_value,
        trind:grace_1l_oam_grace_1l_max_angular_momentum_value,
        trind:grace_1l_oam_grace_1l_num_densities_value,
        trind:grace_1l_oam_grace_1l_num_radial_functions_value,
        trind:grace_1l_oam_grace_1l_product_order_value,
        trind:grace_1l_oam_grace_1l_radial_basis_functions_value,
        trind:grace_1l_oam_grace_2l_batch_size_value,
        trind:grace_1l_oam_grace_2l_chemical_embedding_dimension_value,
        trind:grace_1l_oam_grace_2l_cutoff_radius_value,
        trind:grace_1l_oam_grace_2l_learning_rate_value,
        trind:grace_1l_oam_grace_2l_lmax_per_product_order_layer1_value,
        trind:grace_1l_oam_grace_2l_lmax_per_product_order_layer2_value,
        trind:grace_1l_oam_grace_2l_loss_weights_value,
        trind:grace_1l_oam_grace_2l_max_angular_momentum_value,
        trind:grace_1l_oam_grace_2l_num_densities_value,
        trind:grace_1l_oam_grace_2l_num_equivariant_functions_value,
        trind:grace_1l_oam_grace_2l_num_radial_functions_value,
        trind:grace_1l_oam_grace_2l_product_order_value,
        trind:grace_1l_oam_grace_2l_radial_basis_functions_value ;
    train:initializedFromModelMaterialization trind:omat_base_models_materialization ;
    train:trainsModelVariant archind:grace_1l_oam_grace_1l_model_variant,
        archind:grace_1l_oam_grace_2l_model_variant ;
    train:usesDataset dataind:mptraj,
        dataind:salex ;
    train:usesLoss trind:huberloss ;
    train:usesObjectiveFunction trind:multicomponentloss ;
    train:usesOptimizer trind:adam .

