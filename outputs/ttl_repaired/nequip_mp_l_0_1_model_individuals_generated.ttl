trind:allegro_spice2_large a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "allegro_spice2_large"^^xsd:string ;
    rdfs:comment "Large Allegro model trained on neutral-total-charge subset of SPICE 2"^^xsd:string ;
    train:hasHyperparameterValue trind:allegro_spice2_large_ase_optimizer_value,
        trind:allegro_spice2_large_batch_size_value,
        trind:allegro_spice2_large_cell_filter_value,
        trind:allegro_spice2_large_epochs_value,
        trind:allegro_spice2_large_gradient_clip_val_value,
        trind:allegro_spice2_large_graph_construction_radius_value,
        trind:allegro_spice2_large_initial_learning_rate_value,
        trind:allegro_spice2_large_learning_rate_schedule_value,
        trind:allegro_spice2_large_loss_value,
        trind:allegro_spice2_large_max_force_value,
        trind:allegro_spice2_large_max_neighbors_value,
        trind:allegro_spice2_large_max_rotation_order_value,
        trind:allegro_spice2_large_max_steps_value,
        trind:allegro_spice2_large_n_features_value,
        trind:allegro_spice2_large_n_layers_value,
        trind:allegro_spice2_large_n_radial_bessel_basis_value,
        trind:allegro_spice2_large_num_layers_value,
        trind:allegro_spice2_large_optimizer_value,
        trind:allegro_spice2_large_parity_value,
        trind:allegro_spice2_large_polynomial_cutoff_value,
        trind:allegro_spice2_large_radial_cutoff_value,
        trind:allegro_spice2_large_sph_harmonics_l_max_value,
        trind:allegro_spice2_large_tensor_features_value,
        trind:allegro_spice2_large_type_embed_num_features_value,
        trind:allegro_spice2_large_weight_decay_value,
        trind:allegro_spice2_large_zbl_potential_value ;
    train:trainsModelVariant archind:nequip_mp_l_0_1_allegro_model_variant ;
    train:usesDataset dataind:spice_2 ;
    train:usesLoss trind:huber_delta_0_01_for_energy_delta_0_1_for_stress_stratified_delta_0_01_0_007_0_004_0_001_for_force ;
    train:usesOptimizer trind:adamw .

