archind:nequip_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "NequIP"^^xsd:string ;
    arch:hasVariant archind:nequip_mp_l_0_1_allegro_model_variant,
        archind:nequip_mp_l_0_1_nequip_model_variant,
        archind:nequip_mp_l_0_1_variant .

evalind:nequip_mp_l_0_1_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "nequip_mp_l_0_1_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:nequip_mp_l_0_1_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:nequip_mp_l_0_1_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:nequip_mp_l_0_1_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
