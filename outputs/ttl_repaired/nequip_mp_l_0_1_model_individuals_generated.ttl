    eval:producesBenchmarkResult evalind:nequip_mp_l_0_1_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:nequip_mp_l_0_1_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
