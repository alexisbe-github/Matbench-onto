archind:hienet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "HIENet"^^xsd:string ;
    arch:hasVariant archind:hienet_hienet_model_variant,
        archind:hienet_variant .

dataind:aupt_sqs a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "AuPt_SQS"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:composition_attribute,
        dataind:crystal_structure_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute .

dataind:crmov a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "CrMoV"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:composition_attribute,
        dataind:crystal_structure_attribute,
        dataind:temperature_attribute ;
    data:usesAttributeAsTargetFeature dataind:miscibility_gap_attribute,
        dataind:phase_stability_attribute .

dataind:matbench_discovery a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Matbench_Discovery"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:crystal_structure_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_above_hull_attribute,
        dataind:thermodynamic_stability_attribute .

dataind:materials_project_elasticity a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials_Project_Elasticity"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 1763 ;
    data:usesAttributeAsInputFeature dataind:crystal_structure_attribute ;
    data:usesAttributeAsTargetFeature dataind:bulk_modulus_attribute,
        dataind:elastic_tensor_attribute ;
    data:wasDerivedFromDataset dataind:materials_project .

dataind:mptrj_train a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "MPtrj_train"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 1501000 ;
    data:usesAttributeAsInputFeature dataind:atomic_number_attribute,
        dataind:atomic_positions_attribute,
        dataind:edge_vectors_attribute,
        dataind:interatomic_distances_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:forces_attribute,
        dataind:stress_tensor_attribute ;
    data:wasDerivedFromDataset dataind:mptrj .

dataind:mptrj_validation a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "MPtrj_validation"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 79000 ;
    data:usesAttributeAsInputFeature dataind:atomic_number_attribute,
        dataind:atomic_positions_attribute,
        dataind:edge_vectors_attribute,
        dataind:interatomic_distances_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:forces_attribute,
        dataind:stress_tensor_attribute ;
    data:wasDerivedFromDataset dataind:mptrj .

dataind:phonondb a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "PhononDB"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 10000 ;
    data:usesAttributeAsInputFeature dataind:crystal_structure_attribute,
        dataind:supercell_matrices_attribute,
