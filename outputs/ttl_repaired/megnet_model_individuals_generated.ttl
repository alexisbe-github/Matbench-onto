@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:megnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MEGNet"^^xsd:string ;
    arch:hasVariant archind:megnet_megnet_model_variant,
        archind:megnet_variant .

evalind:megnet_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "megnet_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:megnet_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:megnet_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:megnet_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "megnet_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:megnet_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:megnet_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:megnet_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "megnet_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:megnet_training_run_batch_size_value,
        trind:megnet_training_run_dense_layer_units_value,
        trind:megnet_training_run_early_stopping_patience_value,
        trind:megnet_training_run_embedding_dimension_value,
        trind:megnet_training_run_graph_construction_radius_value,
        trind:megnet_training_run_learning_rate_value,
        trind:megnet_training_run_max_neighbors_value,
        trind:megnet_training_run_number_of_megnet_blocks_value,
        trind:megnet_training_run_radius_cutoff_value,
        trind:megnet_training_run_set2set_hidden_units_value ;
    train:trainsModelVariant archind:megnet_megnet_model_variant .

archind:megnet_denselayer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "DenseLayer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:megnet_denselayer_component_configuration .

archind:megnet_denselayer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "DenseLayer component configuration"^^xsd:string .

archind:megnet_embeddinglayer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "EmbeddingLayer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:megnet_embeddinglayer_component_configuration .

archind:megnet_embeddinglayer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "EmbeddingLayer component configuration"^^xsd:string .

archind:megnet_graphnetworkmodule_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "GraphNetworkModule"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:megnet_graphnetworkmodule_component_configuration .

archind:megnet_graphnetworkmodule_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "GraphNetworkModule component configuration"^^xsd:string .

archind:megnet_megnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MEGNet architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 3 .

archind:megnet_megnetblock_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "MEGNetBlock"^^xsd:string ;
