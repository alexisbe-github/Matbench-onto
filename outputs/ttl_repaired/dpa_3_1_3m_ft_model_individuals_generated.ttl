archind:dpa_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "DPA"^^xsd:string ;
    arch:hasVariant archind:dpa_3_1_3m_ft_dpa3_model_variant,
        archind:dpa_3_1_3m_ft_variant .

dataind:omat24 a owl:NamedIndividual,
        data:Dataset,
        data:LabeledDataset ;
    rdfs:label "OMat24"^^xsd:string ;
    data:hasDataRepresentation dataind:atomic_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:angle_attribute,
        dataind:atomic_number_attribute,
        dataind:interatomic_distance_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:forces_attribute,
        dataind:stress_tensor_attribute ;
    data:wasDerivedFromDataset dataind:materials_project .

evalind:dpa_3_1_3m_ft_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "dpa_3_1_3m_ft_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:dpa_3_1_3m_ft_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:dpa_3_1_3m_ft_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:dpa_3_1_3m_ft_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
