trind:dpa_3_1_3m_ft_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun,
        train:MachineLearningAdaptationRun ;
    rdfs:label "dpa_3_1_3m_ft_finetuning"^^xsd:string ;
    rdfs:comment "Finetuning of DPA-3.1-3M on MPTrj and sAlex for Matbench Discovery benchmark"^^xsd:string ;
    train:hasHyperparameterValue trind:dpa_3_1_3m_ft_finetuning_a_dim_value,
        trind:dpa_3_1_3m_ft_finetuning_a_rcut_value,
        trind:dpa_3_1_3m_ft_finetuning_activation_function_threshold_value,
        trind:dpa_3_1_3m_ft_finetuning_ase_optimizer_value,
        trind:dpa_3_1_3m_ft_finetuning_batch_size_value,
        trind:dpa_3_1_3m_ft_finetuning_cell_filter_value,
        trind:dpa_3_1_3m_ft_finetuning_cutoff_radius_value,
        trind:dpa_3_1_3m_ft_finetuning_dimension_of_edge_features_value,
        trind:dpa_3_1_3m_ft_finetuning_dimension_of_vertex_features_value,
        trind:dpa_3_1_3m_ft_finetuning_e_dim_value,
        trind:dpa_3_1_3m_ft_finetuning_e_rcut_value,
        trind:dpa_3_1_3m_ft_finetuning_energy_loss_prefactor_value,
        trind:dpa_3_1_3m_ft_finetuning_force_loss_prefactor_value,
        trind:dpa_3_1_3m_ft_finetuning_graph_construction_radius_value,
        trind:dpa_3_1_3m_ft_finetuning_learning_rate_value,
        trind:dpa_3_1_3m_ft_finetuning_loss_function_value,
        trind:dpa_3_1_3m_ft_finetuning_max_force_value,
        trind:dpa_3_1_3m_ft_finetuning_max_neighbors_value,
        trind:dpa_3_1_3m_ft_finetuning_max_steps_value,
        trind:dpa_3_1_3m_ft_finetuning_maximum_graph_order_value,
        trind:dpa_3_1_3m_ft_finetuning_n_dim_value,
        trind:dpa_3_1_3m_ft_finetuning_n_layers_value,
        trind:dpa_3_1_3m_ft_finetuning_number_of_update_layers_value,
        trind:dpa_3_1_3m_ft_finetuning_optimizer_value,
        trind:dpa_3_1_3m_ft_finetuning_virial_loss_prefactor_value ;
    train:initializedFromModelMaterialization trind:dpa_3_1_3m_materialization ;
    train:trainsModelVariant archind:dpa_3_1_3m_ft_dpa3_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:salex ;
    train:usesOptimizer trind:adam .

