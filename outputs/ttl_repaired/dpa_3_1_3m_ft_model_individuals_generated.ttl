dataind:forces_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "forces"^^xsd:string .

dataind:interatomic_distance_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "interatomic_distance"^^xsd:string .

evalind:matbench_discovery_benchmark_release a owl:NamedIndividual,
        eval:BenchmarkRelease ;
    rdfs:label "matbench_discovery_benchmark_release"^^xsd:string ;
    eval:hasTask evalind:convex_hull_distance_regression_task,
        evalind:phonon_thermal_conductivity_contribution_task,
        evalind:relaxed_structure_matching_rmsd_task,
        evalind:thermodynamic_stability_classification_task .

archind:dpa_3_1_3m_ft_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "dpa-3.1-3m-ft"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2506.01686.pdf> ;
    prov:wasDerivedFrom <https://arxiv.org/pdf/2506.01686.pdf> ;
    arch:hasMachineLearningArchitecture archind:dpa_3_1_3m_ft_dpa3_architecture ;
    arch:hasParameterNumber 3268838 .

