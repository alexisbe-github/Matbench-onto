trind:matris_10m_oam_materialization a owl:NamedIndividual,
        train:ModelMaterialization ;
    rdfs:label "MatRIS-10M-OAM"^^xsd:string ;
    train:generatedBy trind:salex_mptrj_finetuning .

trind:omat24_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "omat24_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of MatRIS-10M-OAM on the OMat24 dataset using AdamW optimizer with MAE loss"^^xsd:string ;
    train:hasHyperparameterValue trind:omat24_pretraining_ase_optimizer_value,
        trind:omat24_pretraining_batch_size_value,
        trind:omat24_pretraining_cell_filter_value,
        trind:omat24_pretraining_corruption_probability_value,
        trind:omat24_pretraining_energy_loss_prefactor_value,
        trind:omat24_pretraining_force_loss_prefactor_value,
        trind:omat24_pretraining_gradient_clipping_norm_value,
        trind:omat24_pretraining_graph_construction_radius_value,
        trind:omat24_pretraining_hidden_dimension_value,
        trind:omat24_pretraining_initial_learning_rate_value,
        trind:omat24_pretraining_learning_rate_schedule_value,
        trind:omat24_pretraining_learning_rate_value,
        trind:omat24_pretraining_loss_function_value,
        trind:omat24_pretraining_loss_value,
        trind:omat24_pretraining_magmom_loss_prefactor_value,
        trind:omat24_pretraining_max_force_value,
        trind:omat24_pretraining_max_neighbors_value,
        trind:omat24_pretraining_max_steps_value,
        trind:omat24_pretraining_maximum_number_of_steps_value,
        trind:omat24_pretraining_maximum_sigma_value,
        trind:omat24_pretraining_minimum_sigma_value,
        trind:omat24_pretraining_n_layers_value,
        trind:omat24_pretraining_noise_schedule_value,
        trind:omat24_pretraining_number_of_epochs_value,
        trind:omat24_pretraining_number_of_layers_value,
        trind:omat24_pretraining_number_of_radial_basis_functions_value,
        trind:omat24_pretraining_optimizer_value,
        trind:omat24_pretraining_pairwise_cutoff_value,
        trind:omat24_pretraining_stress_loss_prefactor_value,
        trind:omat24_pretraining_three_body_cutoff_value,
        trind:omat24_pretraining_weight_decay_value ;
    train:trainsModelVariant archind:matris_10m_oam_matris_model_variant ;
    train:usesDataset dataind:omat24 ;
    train:usesLoss trind:mae ;
    train:usesObjectiveFunction trind:mae ;
    train:usesOptimizer trind:adamw .

trind:omat24_pretraining_ase_optimizer_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "omat24_pretraining ase_optimizer value"^^xsd:string ;
    prov:value "FIRE"^^xsd:string ;
    train:ofHyperparameter trind:ase_optimizer .

trind:omat24_pretraining_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "omat24_pretraining batch_size value"^^xsd:string ;
    prov:value 512 ;
    train:ofHyperparameter trind:batch_size .

trind:omat24_pretraining_cell_filter_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "omat24_pretraining cell_filter value"^^xsd:string ;
    prov:value "FrechetCellFilter"^^xsd:string ;
