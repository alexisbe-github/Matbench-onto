        eval:MetricType ;
    rdfs:label "TN"^^xsd:string .

evalind:tnr_metric_type a owl:NamedIndividual,
        eval:MetricType ;
    rdfs:label "TNR"^^xsd:string .

evalind:tp_metric_type a owl:NamedIndividual,
        eval:MetricType ;
    rdfs:label "TP"^^xsd:string .

evalind:tpr_metric_type a owl:NamedIndividual,
        eval:MetricType ;
    rdfs:label "TPR"^^xsd:string .

evalind:matbench_discovery_benchmark_release a owl:NamedIndividual,
        eval:BenchmarkRelease ;
    rdfs:label "matbench_discovery_benchmark_release"^^xsd:string ;
    eval:hasTask evalind:convex_hull_distance_regression_task,
        evalind:phonon_thermal_conductivity_contribution_task,
        evalind:relaxed_structure_matching_rmsd_task,
        evalind:thermodynamic_stability_classification_task .

trind:mae a owl:NamedIndividual,
        train:LossFunction,
        train:ObjectiveFunction ;
    rdfs:label "MAE"^^xsd:string .

archind:matris_10m_oam_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "matris-10m-oam"^^xsd:string ;
    dcterms:source <https://github.com/HPC-AI-Team/MatRIS> ;
    prov:wasDerivedFrom <https://github.com/HPC-AI-Team/MatRIS> ;
    arch:hasMachineLearningArchitecture archind:matris_10m_oam_matris_architecture ;
    arch:hasParameterNumber 10443505 .

