archind:matris_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MatRIS"^^xsd:string ;
    arch:hasVariant archind:matris_10m_oam_matris_model_variant,
        archind:matris_10m_oam_variant .

evalind:matris_10m_oam_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "matris_10m_oam_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:matris_10m_oam_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:matris_10m_oam_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:matris_10m_oam_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
