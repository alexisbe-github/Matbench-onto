trind:mattersim_v1_5m_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "mattersim_v1_5m_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:mattersim_v1_5m_training_run_description_value ;
    train:trainsModelVariant archind:mattersim_v1_5m_m3gnet_model_variant ;
    train:usesOptimizer trind:adamw .

