archind:mattersim_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MatterSim"^^xsd:string ;
    arch:hasVariant archind:mattersim_v1_5m_m3gnet_model_variant,
        archind:mattersim_v1_5m_variant .

evalind:mattersim_v1_5m_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "mattersim_v1_5m_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:mattersim_v1_5m_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:mattersim_v1_5m_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:mattersim_v1_5m_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
