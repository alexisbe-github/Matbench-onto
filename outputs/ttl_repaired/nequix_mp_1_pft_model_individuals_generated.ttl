archind:nequix_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Nequix"^^xsd:string ;
    arch:hasVariant archind:nequix_mp_1_pft_equivariantmessagepassingneuralnetworkarchitecture_model_variant,
        archind:nequix_mp_1_pft_variant .

evalind:nequix_mp_1_pft_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
