trind:pft_fine_tuning a owl:NamedIndividual,
        train:MachineLearningAdaptationRun,
        train:MachineLearningFinetuningRun ;
    rdfs:label "pft_fine_tuning"^^xsd:string ;
    rdfs:comment "Phonon fine-tuning of Nequix MP on MDR Phonon PBE dataset with co-training on MPtrj"^^xsd:string ;
    train:hasHyperparameterValue trind:pft_fine_tuning_ase_optimizer_value,
        trind:pft_fine_tuning_batch_size_value,
        trind:pft_fine_tuning_cell_filter_value,
        trind:pft_fine_tuning_co_train_ratio_value,
        trind:pft_fine_tuning_ema_decay_value,
        trind:pft_fine_tuning_grad_clip_norm_value,
        trind:pft_fine_tuning_graph_construction_radius_value,
        trind:pft_fine_tuning_hidden_irreps_value,
        trind:pft_fine_tuning_layer_norm_value,
        trind:pft_fine_tuning_learning_rate_value,
        trind:pft_fine_tuning_lmax_value,
        trind:pft_fine_tuning_loss_weight_energy_value,
        trind:pft_fine_tuning_loss_weight_force_constants_value,
        trind:pft_fine_tuning_loss_weight_force_value,
        trind:pft_fine_tuning_loss_weight_stress_value,
        trind:pft_fine_tuning_max_force_value,
        trind:pft_fine_tuning_max_neighbors_value,
        trind:pft_fine_tuning_max_steps_value,
        trind:pft_fine_tuning_n_epochs_value,
        trind:pft_fine_tuning_num_epochs_value,
        trind:pft_fine_tuning_optimizer_value,
        trind:pft_fine_tuning_radial_basis_size_value,
        trind:pft_fine_tuning_radial_mlp_layers_value,
        trind:pft_fine_tuning_radial_mlp_size_value,
        trind:pft_fine_tuning_radial_polynomial_p_value,
        trind:pft_fine_tuning_weight_decay_value ;
    train:initializedFromModelMaterialization trind:nequix_mp_materialization ;
    train:trainsModelVariant archind:nequix_mp_1_pft_equivariantmessagepassingneuralnetworkarchitecture_model_variant ;
    train:usesDataset dataind:mdr_phonon_pbe,
        dataind:mptrj ;
    train:usesLoss trind:pft_loss ;
    train:usesObjectiveFunction trind:pft_loss ;
    train:usesOptimizer trind:adamw ;
    train:usesSamplingMethod trind:stochastic_hessian_column_sampling .

