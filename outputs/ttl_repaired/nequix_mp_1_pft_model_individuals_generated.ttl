    eval:evaluatesModelVariant archind:nequix_mp_1_pft_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:nequix_mp_1_pft_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

