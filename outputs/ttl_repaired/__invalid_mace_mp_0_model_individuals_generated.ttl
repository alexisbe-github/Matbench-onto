archind:mace_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MACE"^^xsd:string ;
    arch:hasVariant archind:mace_mp_0_mace_model_variant,
        archind:mace_mp_0_variant .

trind:mace_mp_0a_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MACE-MP-0a"^^xsd:string ;
    train:generatedBy trind:mptrj_pretraining .

trind:mace_mp_0b3_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MACE-MP-0b3"^^xsd:string ;
    train:generatedBy trind:mptrj_pretraining .

archind:mace_mp_0_mace_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "MACE"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:mace_mp_0_mace_architecture_configuration ;
    arch:hasParameterNumber 4688656 .

archind:mace_mp_0_mace_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MACE architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 128 ;
    arch:hasLayerCount 2 .

archind:mace_mp_0_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "mace_mp_0"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2401.00096.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\mace_mp_0.yml" ;
    arch:hasMachineLearningArchitecture archind:mace_mp_0_mace_architecture ;
    arch:hasParameterNumber 4688656 .

