    train:generatedBy trind:chgnet_mptrj_pretraining .

trind:chgnet_lifepo4_finetuning a owl:NamedIndividual,
        train:MachineLearningAdaptationRun ;
    rdfs:label "chgnet_lifepo4_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning of CHGNet on Li-Fe-P-O chemical space structures for phase diagram calculations"^^xsd:string ;
    train:hasHyperparameterValue trind:chgnet_lifepo4_finetuning_ase_optimizer_value,
        trind:chgnet_lifepo4_finetuning_batch_size_value,
        trind:chgnet_lifepo4_finetuning_bond_graph_cutoff_value,
        trind:chgnet_lifepo4_finetuning_cell_filter_value,
        trind:chgnet_lifepo4_finetuning_epochs_value,
        trind:chgnet_lifepo4_finetuning_feature_dimensions_value,
        trind:chgnet_lifepo4_finetuning_final_learning_rate_value,
        trind:chgnet_lifepo4_finetuning_force_loss_weight_value,
        trind:chgnet_lifepo4_finetuning_graph_construction_radius_value,
        trind:chgnet_lifepo4_finetuning_huber_delta_value,
        trind:chgnet_lifepo4_finetuning_initial_learning_rate_value,
        trind:chgnet_lifepo4_finetuning_interaction_blocks_value,
        trind:chgnet_lifepo4_finetuning_magmom_loss_weight_value,
        trind:chgnet_lifepo4_finetuning_max_expansion_order_value,
        trind:chgnet_lifepo4_finetuning_max_force_value,
        trind:chgnet_lifepo4_finetuning_max_neighbors_value,
        trind:chgnet_lifepo4_finetuning_max_steps_value,
        trind:chgnet_lifepo4_finetuning_rcut_value,
        trind:chgnet_lifepo4_finetuning_stress_loss_weight_value,
        trind:chgnet_lifepo4_finetuning_three_body_cutoff_value ;
    train:initializedFromModelMaterialization trind:chgnet_0_3_0_materialization ;
    train:trainsModelVariant archind:chgnet_0_3_0_chgnet_model_variant ;
    train:usesDataset dataind:mptrj .

