archind:chgnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "CHGNet"^^xsd:string ;
    arch:hasVariant archind:chgnet_0_3_0_chgnet_model_variant,
        archind:chgnet_0_3_0_variant .

evalind:chgnet_0_3_0_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "chgnet_0_3_0_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:chgnet_0_3_0_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:chgnet_0_3_0_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

