@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:esnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ESNet"^^xsd:string ;
    arch:hasVariant archind:esnet_content_guided_attention_model_variant,
        archind:esnet_esnet_model_variant,
        archind:esnet_icomformer_model_variant,
        archind:esnet_rotate_model_variant,
        archind:esnet_variant .

dataind:dataset_names a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "dataset_names"^^xsd:string .

trind:esnet_content_guided_attention_convolutional_kernel_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet Content-Guided Attention convolutional_kernel_size value"^^xsd:string ;
    train:ofHyperparameter trind:convolutional_kernel_size .

trind:esnet_content_guided_attention_number_of_groups_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet Content-Guided Attention number_of_groups value"^^xsd:string ;
    train:ofHyperparameter trind:number_of_groups .

trind:esnet_icomformer_node_wise_transformer_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet iComFormer node_wise_transformer_layers value"^^xsd:string ;
    train:ofHyperparameter trind:node_wise_transformer_layers .

trind:esnet_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "ESNet"^^xsd:string ;
    train:generatedBy trind:esnet_pretraining .

trind:esnet_rotate_sampling_temperature_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet RotatE sampling_temperature value"^^xsd:string ;
    train:ofHyperparameter trind:sampling_temperature .

archind:content_guided_attention_global_average_pooling_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Global Average Pooling"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:content_guided_attention_global_average_pooling_component_configuration .

archind:content_guided_attention_global_average_pooling_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Global Average Pooling component configuration"^^xsd:string .

archind:content_guided_attention_global_maximum_pooling_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Global Maximum Pooling"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:content_guided_attention_global_maximum_pooling_component_configuration .

archind:content_guided_attention_global_maximum_pooling_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Global Maximum Pooling component configuration"^^xsd:string .

archind:content_guided_attention_group_convolutional_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Group Convolutional Layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:content_guided_attention_group_convolutional_layer_component_configuration .

archind:content_guided_attention_group_convolutional_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Group Convolutional Layer component configuration"^^xsd:string .

archind:esnet_content_guided_attention_architecture a owl:NamedIndividual,
        arch:AttentionBasedArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "Content-Guided Attention"^^xsd:string ;
    arch:hasComponent archind:content_guided_attention_global_average_pooling_component,
        archind:content_guided_attention_global_maximum_pooling_component,
        archind:content_guided_attention_group_convolutional_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_content_guided_attention_architecture_configuration .

archind:esnet_content_guided_attention_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Content-Guided Attention architecture configuration"^^xsd:string .

archind:esnet_content_guided_attention_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet Content-Guided Attention"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_content_guided_attention_architecture .

archind:esnet_crystal_structure_encoding_module_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Crystal Structure Encoding Module"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_crystal_structure_encoding_module_component_configuration .

archind:esnet_crystal_structure_encoding_module_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Crystal Structure Encoding Module component configuration"^^xsd:string .

archind:esnet_elemental_composition_encoding_module_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Elemental Composition Encoding Module"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_elemental_composition_encoding_module_component_configuration .

archind:esnet_elemental_composition_encoding_module_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Elemental Composition Encoding Module component configuration"^^xsd:string .

archind:esnet_esnet_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "ESNet"^^xsd:string ;
    arch:hasBackboneArchitecture archind:esnet_icomformer_component ;
    arch:hasComponent archind:esnet_crystal_structure_encoding_module_component,
        archind:esnet_elemental_composition_encoding_module_component,
        archind:esnet_feature_fusion_module_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_esnet_architecture_configuration ;
    arch:hasParameterNumber 5429033 .

archind:esnet_esnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "ESNet architecture configuration"^^xsd:string .

archind:esnet_feature_fusion_module_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Feature Fusion Module"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_feature_fusion_module_component_configuration .

archind:esnet_feature_fusion_module_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Feature Fusion Module component configuration"^^xsd:string .

archind:esnet_icomformer_architecture a owl:NamedIndividual,
        arch:GraphTransformerArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "iComFormer"^^xsd:string ;
    arch:hasComponent archind:icomformer_edge_wise_transformer_layer_component,
        archind:icomformer_node_wise_transformer_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_icomformer_architecture_configuration .

archind:esnet_icomformer_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "iComFormer architecture configuration"^^xsd:string ;
    arch:hasLayerCount 4 .

archind:esnet_icomformer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "iComFormer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_icomformer_component_configuration .

archind:esnet_icomformer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "iComFormer component configuration"^^xsd:string .

archind:esnet_icomformer_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet iComFormer"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_icomformer_architecture .

archind:esnet_rotate_architecture a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "RotatE"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_rotate_architecture_configuration .

archind:esnet_rotate_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "RotatE architecture configuration"^^xsd:string .

archind:esnet_rotate_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet RotatE"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_rotate_architecture .

archind:esnet_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet"^^xsd:string ;
    dcterms:source <https://www.researchsquare.com/article/rs-5979703/v1.pdf?c=1744393806000> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\esnet.yml" ;
    arch:hasMachineLearningArchitecture archind:esnet_esnet_architecture ;
    arch:hasParameterNumber 5429033 .

archind:icomformer_edge_wise_transformer_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Edge-wise Transformer Layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:icomformer_edge_wise_transformer_layer_component_configuration .

archind:icomformer_edge_wise_transformer_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Edge-wise Transformer Layer component configuration"^^xsd:string .

archind:icomformer_node_wise_transformer_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Node-wise Transformer Layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:icomformer_node_wise_transformer_layer_component_configuration .

archind:icomformer_node_wise_transformer_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Node-wise Transformer Layer component configuration"^^xsd:string .

dataind:band_gap_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "band_gap"^^xsd:string .

dataind:band_gap_mbj_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "band_gap_mbj"^^xsd:string .

dataind:band_gap_opt_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "band_gap_opt"^^xsd:string .

dataind:bulk_modulus_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "bulk_modulus"^^xsd:string .

dataind:ehull_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "ehull"^^xsd:string .

dataind:jarvis a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "JARVIS"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 55722 ;
    data:usesAttributeAsInputFeature dataind:atomic_position_attribute,
        dataind:atomic_properties_attribute,
        dataind:elemental_composition_attribute,
        dataind:lattice_matrix_attribute ;
    data:usesAttributeAsTargetFeature dataind:band_gap_mbj_attribute,
        dataind:band_gap_opt_attribute,
        dataind:ehull_attribute,
        dataind:formation_energy_attribute,
        dataind:total_energy_attribute .

dataind:materials_project a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials Project"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 69239 ;
    data:usesAttributeAsInputFeature dataind:atomic_position_attribute,
        dataind:atomic_properties_attribute,
        dataind:elemental_composition_attribute,
        dataind:lattice_matrix_attribute ;
    data:usesAttributeAsTargetFeature dataind:band_gap_attribute,
        dataind:bulk_modulus_attribute,
        dataind:formation_energy_attribute,
        dataind:shear_modulus_attribute .

dataind:shear_modulus_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "shear_modulus"^^xsd:string .

dataind:total_energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "total_energy"^^xsd:string .

trind:convolutional_kernel_size a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "convolutional_kernel_size"^^xsd:string .

trind:esnet_pretraining a owl:NamedIndividual,
        train:PretrainingRun,
        train:MachineLearningTrainingRun ;
    rdfs:label "esnet_pretraining"^^xsd:string ;
    rdfs:comment "ESNet trained on Materials Project and Jarvis datasets for predicting material properties including formation energy, band gap, bulk modulus, shear modulus, total energy, and Ehull."^^xsd:string ;
    train:trainsModelVariant archind:esnet_esnet_model_variant ;
    train:usesDataset dataind:jarvis,
        dataind:materials_project .

trind:node_wise_transformer_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "node_wise_transformer_layers"^^xsd:string .

trind:number_of_groups a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "number_of_groups"^^xsd:string .

trind:sampling_temperature a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "sampling_temperature"^^xsd:string .

archind:esnet_esnet_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet ESNet"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_esnet_architecture .

dataind:atomic_position_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_position"^^xsd:string .

dataind:atomic_properties_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_properties"^^xsd:string .

dataind:crystal_graph_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "crystal graph"^^xsd:string .

dataind:dft_labelling_method a owl:NamedIndividual,
        data:LabellingMethod ;
    rdfs:label "DFT"^^xsd:string .

dataind:elemental_composition_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "elemental_composition"^^xsd:string .

dataind:formation_energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "formation_energy"^^xsd:string .

dataind:lattice_matrix_attribute a owl:NamedIndividual,
