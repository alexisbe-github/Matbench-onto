    eval:producesBenchmarkResult evalind:orb_v2_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:orb_v2_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "orb_v2_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:orb_v2_training_run_adam_beta1_value,
        trind:orb_v2_training_run_adam_beta2_value,
        trind:orb_v2_training_run_ase_optimizer_value,
        trind:orb_v2_training_run_batch_size_per_gpu_value,
        trind:orb_v2_training_run_batch_size_value,
        trind:orb_v2_training_run_cell_filter_value,
        trind:orb_v2_training_run_diffusion_max_epochs_value,
        trind:orb_v2_training_run_ema_decay_rate_value,
        trind:orb_v2_training_run_ema_decay_value,
        trind:orb_v2_training_run_energy_loss_weight_value,
        trind:orb_v2_training_run_features_value,
        trind:orb_v2_training_run_finetune_learning_rate_value,
        trind:orb_v2_training_run_gradient_clip_value,
        trind:orb_v2_training_run_graph_construction_radius_value,
        trind:orb_v2_training_run_initial_learning_rate_value,
        trind:orb_v2_training_run_learning_rate_schedule_value,
        trind:orb_v2_training_run_learning_rate_value,
        trind:orb_v2_training_run_loss_value,
        trind:orb_v2_training_run_lr_schedule_value,
        trind:orb_v2_training_run_max_epochs_value,
        trind:orb_v2_training_run_max_force_value,
        trind:orb_v2_training_run_max_neighbors_value,
        trind:orb_v2_training_run_max_radius_value,
        trind:orb_v2_training_run_max_steps_value,
        trind:orb_v2_training_run_n_layers_value,
        trind:orb_v2_training_run_noise_schedule_value,
        trind:orb_v2_training_run_num_rbfs_value,
        trind:orb_v2_training_run_optimizer_value,
        trind:orb_v2_training_run_warmup_fraction_value ;
    train:trainsModelVariant archind:orb_v2_denoisingdiffusionmodel_model_variant,
        archind:orb_v2_graphattentionnetwork_model_variant,
        archind:orb_v2_graphnetworksimulator_model_variant ;
    train:usesLoss trind:mae ;
    train:usesOptimizer trind:adam .

