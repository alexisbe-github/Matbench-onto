@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:cgcnn_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "CGCNN"^^xsd:string ;
    arch:hasVariant archind:cgcnn_p_cgcnn_model_variant,
        archind:cgcnn_p_variant .

dataind:nb_sr_h_hydrides a owl:NamedIndividual,
        data:Dataset,
        data:LabeledDataset ;
    rdfs:label "Nb-Sr-H Hydrides"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 623 ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_species_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute .

evalind:cgcnn_p_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "cgcnn_p_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:cgcnn_p_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:cgcnn_p_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:cgcnn_p_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "cgcnn_p_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:cgcnn_p_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:cgcnn_p_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:cgcnn_p_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "cgcnn+p"^^xsd:string ;
    train:generatedBy trind:cgcnn_p_pretraining .

archind:cgcnn_fully_connected_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "fully_connected_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_fully_connected_layers_component_configuration .

archind:cgcnn_fully_connected_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "fully_connected_layers component configuration"^^xsd:string .

archind:cgcnn_graph_convolutional_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "graph_convolutional_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_graph_convolutional_layers_component_configuration .

archind:cgcnn_graph_convolutional_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "graph_convolutional_layers component configuration"^^xsd:string .

archind:cgcnn_graphconvolutionarchitecture_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "GraphConvolutionArchitecture"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_graphconvolutionarchitecture_component_configuration .

archind:cgcnn_graphconvolutionarchitecture_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "GraphConvolutionArchitecture component configuration"^^xsd:string .

archind:cgcnn_p_cgcnn_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "CGCNN architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 9 .

dataind:lattice_vectors_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "lattice_vectors"^^xsd:string .

dataind:mp_2022 a owl:NamedIndividual,
        data:Dataset,
        data:LabeledDataset,
        train:TrainingDataset ;
    rdfs:label "MP 2022"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 126000 ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_species_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute .

evalind:cgcnn_p_matbench_discovery_convex_hull_distance_regression_benchmark_result a owl:NamedIndividual,
        eval:BenchmarkResult ;
    rdfs:label "cgcnn_p_matbench_discovery_convex_hull_distance_regression benchmark result"^^xsd:string ;
    eval:hasMetricResult evalind:cgcnn_p_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_mae_metric_result,
        evalind:cgcnn_p_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_missing_preds_metric_result,
