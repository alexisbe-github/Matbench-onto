trind:cgcnn_p_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "cgcnn_p_pretraining"^^xsd:string ;
    rdfs:comment "CGCNN+P trained on MP 2022 relaxed structures augmented with perturbed structures"^^xsd:string ;
    train:hasHyperparameterValue trind:cgcnn_p_pretraining_activation_function_value,
        trind:cgcnn_p_pretraining_graph_construction_radius_value,
        trind:cgcnn_p_pretraining_graph_convolutional_layers_value,
        trind:cgcnn_p_pretraining_hidden_layers_value,
        trind:cgcnn_p_pretraining_hidden_neurons_value,
        trind:cgcnn_p_pretraining_max_neighbors_value,
        trind:cgcnn_p_pretraining_perturbation_count_value,
        trind:cgcnn_p_pretraining_perturbations_value ;
    train:trainsModelVariant archind:cgcnn_p_cgcnn_model_variant ;
    train:usesDataset dataind:mp_2022 .

trind:cgcnn_p_pretraining_activation_function_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_p_pretraining activation_function value"^^xsd:string ;
    prov:value "softplus"^^xsd:string ;
    train:ofHyperparameter trind:activation_function .

trind:cgcnn_p_pretraining_graph_construction_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_p_pretraining graph_construction_radius value"^^xsd:string ;
    prov:value "5.0"^^xsd:float ;
    train:ofHyperparameter trind:graph_construction_radius .

trind:cgcnn_p_pretraining_graph_convolutional_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_p_pretraining graph_convolutional_layers value"^^xsd:string ;
    prov:value 3 ;
    train:ofHyperparameter trind:graph_convolutional_layers .

trind:cgcnn_p_pretraining_hidden_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_p_pretraining hidden_layers value"^^xsd:string ;
    prov:value 6 ;
    train:ofHyperparameter trind:hidden_layers .

trind:cgcnn_p_pretraining_hidden_neurons_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_p_pretraining hidden_neurons value"^^xsd:string ;
    prov:value 64 ;
    train:ofHyperparameter trind:hidden_neurons .

trind:cgcnn_p_pretraining_max_neighbors_value a owl:NamedIndividual,
