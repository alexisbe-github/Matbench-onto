archind:esen_30m_mp_esen_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "eSEN"^^xsd:string ;
    arch:hasBackboneArchitecture archind:esen_escn_component ;
    arch:hasComponent archind:esen_edgewise_convolution_component,
        archind:esen_envelope_function_component,
        archind:esen_equivariant_layer_normalization_component,
        archind:esen_equivariant_spherical_channel_network_component,
        archind:esen_gated_non_linearity_component,
        archind:esen_nodewise_feed_forward_network_component,
        archind:esen_so2_convolution_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:esen_30m_mp_esen_architecture_configuration ;
    arch:hasParameterNumber 30085121 .

archind:esen_30m_mp_esen_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "eSEN architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 128 ;
    arch:hasLayerCount 10 .

archind:esen_30m_mp_esen_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esen_30m_mp eSEN"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esen_30m_mp_esen_architecture .

archind:esen_30m_mp_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esen_30m_mp"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2502.12147.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\esen_30m_oam.yml" ;
    arch:hasParameterNumber 30085121 ;
    arch:hasMachineLearningArchitecture archind:esen_30m_mp_esen_architecture .

