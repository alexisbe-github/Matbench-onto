    eval:evaluatesTask evalind:phonon_thermal_conductivity_contribution_task ;
    eval:producesBenchmarkResult evalind:sevennet_l3i5_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:sevennet_l3i5_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
