evalind:sevennet_l3i5_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_l3i5_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
