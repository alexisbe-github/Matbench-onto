    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:sevennet_0_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "sevennet_0_pretraining"^^xsd:string ;
    rdfs:comment "Pre-training of SevenNet-0 on the M3GNet dataset (derived from Materials Project) covering 89 elements, using 5 interaction blocks with 128 scalars, 64 vectors, and 32 tensors, cutoff radius of 5 Å, Adam optimizer with initial learning rate 0.004, batch size 16, Huber loss with δ=0.01, force loss weight 0.1, stress loss weight 0.01, trained for 450 epochs."^^xsd:string ;
    train:hasHyperparameterValue trind:sevennet_0_pretraining_ase_optimizer_value,
        trind:sevennet_0_pretraining_batch_size_value,
        trind:sevennet_0_pretraining_cell_filter_value,
        trind:sevennet_0_pretraining_cutoff_radius_value,
        trind:sevennet_0_pretraining_epochs_value,
        trind:sevennet_0_pretraining_force_loss_weight_value,
        trind:sevennet_0_pretraining_graph_construction_radius_value,
        trind:sevennet_0_pretraining_huber_loss_threshold_value,
        trind:sevennet_0_pretraining_initial_learning_rate_value,
        trind:sevennet_0_pretraining_learning_rate_schedule_value,
        trind:sevennet_0_pretraining_learning_rate_value,
        trind:sevennet_0_pretraining_loss_value,
        trind:sevennet_0_pretraining_max_force_value,
        trind:sevennet_0_pretraining_max_neighbors_value,
        trind:sevennet_0_pretraining_max_steps_value,
        trind:sevennet_0_pretraining_maximum_degree_of_representation_value,
        trind:sevennet_0_pretraining_n_features_value,
        trind:sevennet_0_pretraining_n_layers_value,
        trind:sevennet_0_pretraining_n_radial_bessel_basis_value,
        trind:sevennet_0_pretraining_number_of_channels_value,
        trind:sevennet_0_pretraining_number_of_message_passing_layers_value,
        trind:sevennet_0_pretraining_optimizer_value,
        trind:sevennet_0_pretraining_sph_harmonics_l_max_value,
        trind:sevennet_0_pretraining_stress_loss_weight_value ;
    train:trainsModelVariant archind:sevennet_l3i5_nequip_model_variant ;
    train:usesDataset dataind:m3gnet_dataset ;
    train:usesLoss trind:huber_loss ;
    train:usesOptimizer trind:adam .

archind:sevennet_l3i5_nequip_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "NequIP architecture configuration"^^xsd:string .

