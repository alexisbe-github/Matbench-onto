archind:sevennet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "SevenNet"^^xsd:string ;
    arch:hasVariant archind:sevennet_l3i5_nequip_model_variant,
        archind:sevennet_l3i5_variant .

evalind:sevennet_l3i5_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "sevennet_l3i5_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:sevennet_l3i5_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:sevennet_l3i5_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:sevennet_l3i5_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
