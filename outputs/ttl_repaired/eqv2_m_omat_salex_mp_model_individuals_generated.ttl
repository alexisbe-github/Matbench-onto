trind:eqv2_m_finetuning_mptrj_salex a owl:NamedIndividual,
        train:MachineLearningAdaptationRun,
        train:MachineLearningFinetuningRun ;
    rdfs:label "eqv2_m_finetuning_mptrj_salex"^^xsd:string ;
    rdfs:comment "Fine-tuning of EquiformerV2 on MPtrj and subsampled Alexandria after OMat24 pretraining."^^xsd:string ;
    train:hasHyperparameterValue trind:eqv2_m_finetuning_mptrj_salex_architectures_value,
        trind:eqv2_m_finetuning_mptrj_salex_ase_optimizer_value,
        trind:eqv2_m_finetuning_mptrj_salex_batch_size_value,
        trind:eqv2_m_finetuning_mptrj_salex_cell_filter_value,
        trind:eqv2_m_finetuning_mptrj_salex_dropout_rate_value,
        trind:eqv2_m_finetuning_mptrj_salex_ema_decay_value,
        trind:eqv2_m_finetuning_mptrj_salex_energy_head_value,
        trind:eqv2_m_finetuning_mptrj_salex_epochs_value,
        trind:eqv2_m_finetuning_mptrj_salex_force_head_value,
        trind:eqv2_m_finetuning_mptrj_salex_grad_clip_threshold_value,
        trind:eqv2_m_finetuning_mptrj_salex_graph_construction_radius_value,
        trind:eqv2_m_finetuning_mptrj_salex_l2_norm_loss_forces_value,
        trind:eqv2_m_finetuning_mptrj_salex_learning_rate_schedule_value,
        trind:eqv2_m_finetuning_mptrj_salex_loss_value,
        trind:eqv2_m_finetuning_mptrj_salex_mae_loss_stress_anisotropic_value,
        trind:eqv2_m_finetuning_mptrj_salex_mae_loss_stress_isotropic_value,
        trind:eqv2_m_finetuning_mptrj_salex_max_force_value,
        trind:eqv2_m_finetuning_mptrj_salex_max_learning_rate_value,
        trind:eqv2_m_finetuning_mptrj_salex_max_neighbors_value,
        trind:eqv2_m_finetuning_mptrj_salex_max_steps_value,
        trind:eqv2_m_finetuning_mptrj_salex_min_learning_rate_factor_value,
        trind:eqv2_m_finetuning_mptrj_salex_optimizer_value,
        trind:eqv2_m_finetuning_mptrj_salex_per_atom_mae_loss_energy_value,
        trind:eqv2_m_finetuning_mptrj_salex_stochastic_depth_value,
        trind:eqv2_m_finetuning_mptrj_salex_stress_head_value,
        trind:eqv2_m_finetuning_mptrj_salex_warmup_epochs_value,
        trind:eqv2_m_finetuning_mptrj_salex_warmup_factor_value,
        trind:eqv2_m_finetuning_mptrj_salex_weight_decay_value ;
    train:initializedFromModelMaterialization trind:eqv2_m_materialization ;
    train:trainsModelVariant archind:eqv2_m_omat_salex_mp_equiformerv2_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:per_atom_mae_loss_for_energy_l2_norm_loss_for_forces_mae_losses_for_stress_components ;
    train:usesObjectiveFunction trind:per_atom_mae_loss_for_energy_l2_norm_loss_for_forces_mae_losses_for_stress_components ;
    train:usesOptimizer trind:adamw .

trind:eqv2_m_finetuning_mptrj_salex_architectures_value a owl:NamedIndividual,
