archind:alphanet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "AlphaNet"^^xsd:string ;
    arch:hasVariant archind:alphanet_v1_oam_alphanet_model_variant,
        archind:alphanet_v1_oam_variant .

evalind:alphanet_v1_oam_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "alphanet_v1_oam_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:alphanet_v1_oam_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:alphanet_v1_oam_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

