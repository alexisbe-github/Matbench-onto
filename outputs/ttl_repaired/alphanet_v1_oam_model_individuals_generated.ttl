archind:alphanet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "AlphaNet"^^xsd:string ;
    arch:hasVariant archind:alphanet_v1_mptrj_alphanet_model_variant,
        archind:alphanet_v1_mptrj_variant .

trind:alphanet_v1_mptrj_alphanet_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alphanet-v1-mptrj AlphaNet batch_size value"^^xsd:string ;
    train:ofHyperparameter trind:batch_size .

trind:alphanet_v1_mptrj_alphanet_cutoff_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alphanet-v1-mptrj AlphaNet cutoff value"^^xsd:string ;
    train:ofHyperparameter trind:cutoff .

