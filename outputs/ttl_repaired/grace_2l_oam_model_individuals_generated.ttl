evalind:grace_2l_oam_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "grace_2l_oam_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:grace_2l_oam_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
