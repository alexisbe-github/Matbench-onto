    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:grace_2l_oam_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "grace_2l_oam_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:grace_2l_oam_training_run_ase_optimizer_value,
        trind:grace_2l_oam_training_run_cell_filter_value,
        trind:grace_2l_oam_training_run_graph_construction_radius_value,
        trind:grace_2l_oam_training_run_max_force_value,
        trind:grace_2l_oam_training_run_max_neighbors_value,
        trind:grace_2l_oam_training_run_max_steps_value ;
    train:trainsModelVariant archind:grace_2l_oam_uip_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:omat24,
        dataind:salex .

archind:grace_2l_oam_uip_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "UIP architecture configuration"^^xsd:string .

dataind:kappa_103_phonon_benchmark_set a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "kappa-103 phonon benchmark set"^^xsd:string .

dataind:mptrj a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MPtrj"^^xsd:string .

dataind:omat24 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "OMat24"^^xsd:string .

dataind:salex a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "sAlex"^^xsd:string .

