archind:grace_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "GRACE"^^xsd:string ;
    arch:hasVariant archind:grace_2l_oam_uip_model_variant,
        archind:grace_2l_oam_variant .

evalind:grace_2l_oam_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "grace_2l_oam_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:grace_2l_oam_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:grace_2l_oam_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:grace_2l_oam_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "grace_2l_oam_matbench_discovery_phonon_thermal_conductivity_contribution"^^xsd:string ;
    eval:evaluatesModelVariant archind:grace_2l_oam_variant ;
    eval:evaluatesTask evalind:phonon_thermal_conductivity_contribution_task ;
    eval:producesBenchmarkResult evalind:grace_2l_oam_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:grace_2l_oam_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
