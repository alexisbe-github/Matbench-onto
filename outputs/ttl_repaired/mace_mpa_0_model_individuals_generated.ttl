archind:mace_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MACE"^^xsd:string ;
    arch:hasVariant archind:mace_mpa_0_mace_model_variant,
        archind:mace_mpa_0_variant .

evalind:mace_mpa_0_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "mace_mpa_0_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:mace_mpa_0_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:mace_mpa_0_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:mace_mpa_0_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
