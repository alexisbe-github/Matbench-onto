archind:m3gnet_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "m3gnet"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2202.02450.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\m3gnet.yml" ;
    arch:hasMachineLearningArchitecture archind:m3gnet_m3gnet_architecture ;
    arch:hasParameterNumber 227549 .

