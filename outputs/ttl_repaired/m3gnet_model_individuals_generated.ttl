    rdfs:label "BondUpdate"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:m3gnet_bondupdate_component_configuration .

archind:m3gnet_bondupdate_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "BondUpdate component configuration"^^xsd:string .

