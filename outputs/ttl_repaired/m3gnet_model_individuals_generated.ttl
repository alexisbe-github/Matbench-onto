@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:m3gnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "M3GNet"^^xsd:string ;
    arch:hasVariant archind:m3gnet_m3gnet_model_variant,
        archind:m3gnet_variant .

trind:dataset_details a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "dataset_details"^^xsd:string .

trind:datasets a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "datasets"^^xsd:string .

trind:m3gnet_m3gnet_basis_functions_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet basis_functions value"^^xsd:string ;
    train:ofHyperparameter trind:basis_functions .

trind:m3gnet_m3gnet_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet batch_size value"^^xsd:string ;
    train:ofHyperparameter trind:batch_size .

trind:m3gnet_m3gnet_cutoff_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet cutoff_radius value"^^xsd:string ;
    train:ofHyperparameter trind:cutoff_radius .

trind:m3gnet_m3gnet_embedding_dimension_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet embedding_dimension value"^^xsd:string ;
    train:ofHyperparameter trind:embedding_dimension .

trind:m3gnet_m3gnet_force_loss_weight_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet force_loss_weight value"^^xsd:string ;
    train:ofHyperparameter trind:force_loss_weight .

trind:m3gnet_m3gnet_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet learning_rate value"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate .

trind:m3gnet_m3gnet_main_block_count_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet main_block_count value"^^xsd:string ;
    train:ofHyperparameter trind:main_block_count .

trind:m3gnet_m3gnet_max_epochs_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet max_epochs value"^^xsd:string ;
    train:ofHyperparameter trind:max_epochs .

trind:m3gnet_m3gnet_mlp_hidden_neurons_value a owl:NamedIndividual,
