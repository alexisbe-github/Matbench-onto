    rdfs:label "m3gnet M3GNet patience value"^^xsd:string ;
    train:ofHyperparameter trind:patience .

trind:m3gnet_m3gnet_stress_loss_weight_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet stress_loss_weight value"^^xsd:string ;
    train:ofHyperparameter trind:stress_loss_weight .

trind:m3gnet_m3gnet_three_body_cutoff_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet M3GNet three_body_cutoff value"^^xsd:string ;
    train:ofHyperparameter trind:three_body_cutoff .

trind:training_run_details a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "training_run_details"^^xsd:string .

archind:m3gnet_atomupdate_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "AtomUpdate"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:m3gnet_atomupdate_component_configuration .

archind:m3gnet_atomupdate_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "AtomUpdate component configuration"^^xsd:string .

