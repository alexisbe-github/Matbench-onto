    rdfs:label "GraphFeaturizer component configuration"^^xsd:string .

archind:m3gnet_m3gnet_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture,
        arch:MachineLearningArchitecture ;
    rdfs:label "M3GNet"^^xsd:string ;
    arch:hasComponent archind:m3gnet_atomupdate_component,
        archind:m3gnet_bondupdate_component,
        archind:m3gnet_gatedmlp_component,
        archind:m3gnet_graphfeaturizer_component,
        archind:m3gnet_manybodycomputation_component,
        archind:m3gnet_readoutmodule_component,
        archind:m3gnet_stateupdate_component ;
    arch:hasHeadArchitecture archind:m3gnet_gatedmlp_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:m3gnet_m3gnet_architecture_configuration ;
    arch:hasParameterNumber 227549 .

archind:m3gnet_m3gnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "M3GNet architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 3 .

archind:m3gnet_m3gnet_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "m3gnet M3GNet"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:m3gnet_m3gnet_architecture .

archind:m3gnet_manybodycomputation_component a owl:NamedIndividual,
