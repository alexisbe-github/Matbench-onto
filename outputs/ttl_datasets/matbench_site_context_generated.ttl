evalind:diatomics_task a owl:NamedIndividual,
        eval:RegressionTask ;
    rdfs:label "Diatomics"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/tasks/diatomics> ;
    rdfs:comment "Evaluates machine learning interatomic potentials on self-consistency metrics and reference-relative errors of homonuclear diatomic curves."^^xsd:string ;
    eval:usesDataset dataind:diatomic_reference_curves .

evalind:geometry_optimization_task a owl:NamedIndividual,
        eval:RegressionTask ;
    rdfs:label "MLFF Geometry Optimization Analysis"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/tasks/geo-opt> ;
    rdfs:comment "Evaluates the quality of MLFF relaxations for crystal structures by comparing ML- and DFT-relaxed ground state structures."^^xsd:string ;
    eval:usesDataset dataind:wbm_test_set .

evalind:matbench_discovery_benchmark_release a owl:NamedIndividual,
        eval:BenchmarkRelease ;
    rdfs:label "Matbench Discovery benchmark release"^^xsd:string ;
    eval:hasTask evalind:diatomics_task,
        evalind:geometry_optimization_task,
        evalind:matbench_discovery_discovery_task,
        evalind:molecular_dynamics_task,
        evalind:phonons_task .

evalind:matbench_discovery_discovery_task a owl:NamedIndividual,
        eval:ClassificationTask ;
    rdfs:label "Crystal Stability Prediction Metrics"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/tasks/discovery> ;
    rdfs:comment "Predicts crystal stability by evaluating formation energy and hull distance errors against DFT reference energies."^^xsd:string ;
    eval:usesDataset dataind:materials_project_reference_hull,
        dataind:wbm_test_set .

evalind:molecular_dynamics_task a owl:NamedIndividual,
        eval:RegressionTask ;
    rdfs:label "Molecular Dynamics Metrics beta"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/tasks/md> ;
    rdfs:comment "Evaluates how well machine-learning interatomic potentials reproduce structural, thermodynamic and vibrational observables of ab-initio molecular dynamics trajectories."^^xsd:string ;
    eval:usesDataset dataind:md_benchmark_set .

evalind:phonons_task a owl:NamedIndividual,
        eval:RegressionTask ;
    rdfs:label "MLFF Phonon Modeling Metrics"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/tasks/phonons> ;
    rdfs:comment "Evaluates ML force fields on thermal conductivity prediction and phonon frequency spectra accuracy using 2nd and 3rd order derivatives of the potential energy surface."^^xsd:string ;
    eval:usesDataset dataind:kappa_103_phonon_benchmark_set,
        dataind:mdr_mp_pbe_omega_q .

dataind:wbm_test_set a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "WBM test set"^^xsd:string ;
    dcterms:source <https://matbench-discovery.materialsproject.org/data/sets> .

