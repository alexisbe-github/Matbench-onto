    eval:evaluatesTask evalind:relaxed_structure_matching_rmsd_task ;
    eval:producesBenchmarkResult evalind:grace_2l_mptrj_matbench_discovery_relaxed_structure_matching_rmsd_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:grace_2l_mptrj_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "grace_2l_mptrj_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:grace_2l_mptrj_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:grace_2l_mptrj_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:grace_2l_mptrj_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "grace_2l_mptrj_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:grace_2l_mptrj_training_run_ase_optimizer_value,
        trind:grace_2l_mptrj_training_run_cell_filter_value,
        trind:grace_2l_mptrj_training_run_graph_construction_radius_value,
        trind:grace_2l_mptrj_training_run_max_force_value,
        trind:grace_2l_mptrj_training_run_max_neighbors_value,
        trind:grace_2l_mptrj_training_run_max_steps_value ;
    train:trainsModelVariant archind:grace_2l_mptrj_uip_model_variant ;
    train:usesDataset dataind:mptrj .

archind:grace_2l_mptrj_uip_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "UIP architecture configuration"^^xsd:string .

dataind:kappa_103_phonon_benchmark_set a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "kappa-103 phonon benchmark set"^^xsd:string .

dataind:mptrj a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MPtrj"^^xsd:string .

