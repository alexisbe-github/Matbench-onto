archind:allegro_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Allegro"^^xsd:string ;
    arch:hasVariant archind:allegro_mp_l_0_1_allegro_model_variant,
        archind:allegro_mp_l_0_1_variant .

evalind:allegro_mp_l_0_1_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "allegro_mp_l_0_1_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:allegro_mp_l_0_1_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:allegro_mp_l_0_1_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

