trind:allegro_mptrj_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "allegro_mptrj_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of Allegro-MP-L on MPtrj dataset for S2EFS task"^^xsd:string ;
    train:hasHyperparameterValue trind:allegro_mptrj_pretraining_allegro_mlp_depth_value,
        trind:allegro_mptrj_pretraining_allegro_mlp_width_value,
        trind:allegro_mptrj_pretraining_ase_optimizer_value,
        trind:allegro_mptrj_pretraining_batch_size_value,
        trind:allegro_mptrj_pretraining_cell_filter_value,
        trind:allegro_mptrj_pretraining_epochs_value,
        trind:allegro_mptrj_pretraining_gradient_clip_val_value,
        trind:allegro_mptrj_pretraining_graph_construction_radius_value,
        trind:allegro_mptrj_pretraining_initial_learning_rate_value,
        trind:allegro_mptrj_pretraining_learning_rate_schedule_value,
        trind:allegro_mptrj_pretraining_loss_value,
        trind:allegro_mptrj_pretraining_max_force_value,
        trind:allegro_mptrj_pretraining_max_neighbors_value,
        trind:allegro_mptrj_pretraining_max_steps_value,
        trind:allegro_mptrj_pretraining_maximum_rotation_order_value,
        trind:allegro_mptrj_pretraining_n_features_value,
        trind:allegro_mptrj_pretraining_n_layers_value,
        trind:allegro_mptrj_pretraining_n_radial_bessel_basis_value,
        trind:allegro_mptrj_pretraining_number_of_allegro_layers_value,
        trind:allegro_mptrj_pretraining_number_of_tensor_features_value,
        trind:allegro_mptrj_pretraining_optimizer_value,
        trind:allegro_mptrj_pretraining_parity_value,
        trind:allegro_mptrj_pretraining_polynomial_cutoff_value,
        trind:allegro_mptrj_pretraining_radial_cutoff_value,
        trind:allegro_mptrj_pretraining_sph_harmonics_l_max_value,
        trind:allegro_mptrj_pretraining_tensor_path_channel_coupling_value,
        trind:allegro_mptrj_pretraining_weight_decay_value,
        trind:allegro_mptrj_pretraining_zbl_potential_value ;
    train:trainsModelVariant archind:allegro_mp_l_0_1_allegro_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:huber_delta_0_01_for_energy_delta_0_1_for_stress_stratified_delta_0_01_0_007_0_004_0_001_for_force ;
    train:usesOptimizer trind:adamw .

