        train:MachineLearningHyperparameterValue ;
    rdfs:label "allegro_mptrj_pretraining allegro_mlp_depth value"^^xsd:string ;
    prov:value 3 ;
    train:ofHyperparameter trind:allegro_mlp_depth .

