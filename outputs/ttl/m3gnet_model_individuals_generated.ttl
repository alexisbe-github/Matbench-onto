trind:m3gnet_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "m3gnet_pretraining"^^xsd:string ;
    rdfs:comment "M3GNet trained on MPF.2021.2.8 dataset with energies, forces, and stresses using Huber loss"^^xsd:string ;
    train:hasHyperparameterValue trind:m3gnet_pretraining_ase_optimizer_value,
        trind:m3gnet_pretraining_basis_functions_value,
        trind:m3gnet_pretraining_batch_size_value,
        trind:m3gnet_pretraining_cell_filter_value,
        trind:m3gnet_pretraining_cutoff_radius_value,
        trind:m3gnet_pretraining_embedding_dimension_value,
        trind:m3gnet_pretraining_force_weight_value,
        trind:m3gnet_pretraining_graph_construction_radius_value,
        trind:m3gnet_pretraining_learning_rate_value,
        trind:m3gnet_pretraining_loss_function_value,
        trind:m3gnet_pretraining_main_blocks_value,
        trind:m3gnet_pretraining_max_force_value,
        trind:m3gnet_pretraining_max_neighbors_value,
        trind:m3gnet_pretraining_max_steps_value,
        trind:m3gnet_pretraining_optimizer_value,
        trind:m3gnet_pretraining_stress_weight_value,
        trind:m3gnet_pretraining_three_body_cutoff_value ;
    train:trainsModelVariant archind:m3gnet_m3gnet_model_variant ;
    train:usesDataset dataind:mpf ;
    train:usesLoss trind:huber ;
    train:usesObjectiveFunction trind:huber ;
    train:usesOptimizer trind:adam .

