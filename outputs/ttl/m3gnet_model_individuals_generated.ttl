archind:m3gnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "M3GNet"^^xsd:string ;
    arch:hasVariant archind:m3gnet_m3gnet_model_variant,
        archind:m3gnet_variant .

evalind:full_test_set_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "full_test_set"^^xsd:string ;
    eval:hasTestSplit dataind:full_test_set .

evalind:m3gnet_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "m3gnet_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:m3gnet_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:m3gnet_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

