    rdfs:label "m3gnet_pretraining max_steps value"^^xsd:string ;
    prov:value 500 ;
    train:ofHyperparameter trind:max_steps .

trind:m3gnet_pretraining_optimizer_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet_pretraining optimizer value"^^xsd:string ;
    prov:value "Adam"^^xsd:string ;
    train:ofHyperparameter trind:optimizer .

trind:m3gnet_pretraining_stress_weight_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "m3gnet_pretraining stress_weight value"^^xsd:string ;
    train:ofHyperparameter trind:stress_weight .

