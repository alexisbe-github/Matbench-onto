archind:equiformer_v3_mp_equiformerv3_architecture a owl:NamedIndividual,
        arch:GraphTransformerArchitecture ;
    rdfs:label "EquiformerV3"^^xsd:string ;
    arch:hasBackboneArchitecture archind:equiformerv3_equiformerv2_component ;
    arch:hasComponent archind:equiformerv3_embeddingmodule_component,
        archind:equiformerv3_equivariantgraphattention_component,
        archind:equiformerv3_equivariantmergedlayernormalization_component,
        archind:equiformerv3_escnconvolution_component,
        archind:equiformerv3_feedforwardnetwork_component,
        archind:equiformerv3_outputhead_component,
        archind:equiformerv3_smoothradiuscutoffattention_component,
        archind:equiformerv3_swiglu_s2activation_component ;
    arch:hasHeadArchitecture archind:equiformerv3_gateactivationoutputhead_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:equiformer_v3_mp_equiformerv3_architecture_configuration ;
    arch:hasParameterNumber 30278113 .

archind:equiformer_v3_mp_equiformerv3_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "EquiformerV3 architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 512 ;
    arch:hasLayerCount 8 .

