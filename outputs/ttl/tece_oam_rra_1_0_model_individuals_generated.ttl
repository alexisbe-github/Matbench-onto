archind:tece_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "TECE"^^xsd:string ;
    arch:hasVariant archind:tece_oam_rra_1_0_atomic_cluster_expansion_model_variant,
        archind:tece_oam_rra_1_0_edge_cluster_expansion_model_variant,
        archind:tece_oam_rra_1_0_radial_rotary_attention_model_variant,
