archind:chgnet_0_3_0_crystal_hamiltonian_graph_neural_network_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture ;
    rdfs:label "Crystal Hamiltonian Graph Neural Network"^^xsd:string ;
    arch:hasBackboneArchitecture archind:crystal_hamiltonian_graph_neural_network_graphneuralnetwork_component ;
    arch:hasComponent archind:crystal_hamiltonian_graph_neural_network_angleupdate_component,
        archind:crystal_hamiltonian_graph_neural_network_atomconvolution_component,
        archind:crystal_hamiltonian_graph_neural_network_autodifferentiation_component,
