        archind:crystal_hamiltonian_graph_neural_network_smoothrbf_component,
        archind:crystal_hamiltonian_graph_neural_network_weightedmessagepassing_component ;
    arch:hasHeadArchitecture archind:crystal_hamiltonian_graph_neural_network_linearprojection_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:chgnet_0_3_0_crystal_hamiltonian_graph_neural_network_architecture_configuration ;
    arch:hasParameterNumber 400438 .

archind:chgnet_0_3_0_crystal_hamiltonian_graph_neural_network_architecture_configuration a owl:NamedIndividual,
