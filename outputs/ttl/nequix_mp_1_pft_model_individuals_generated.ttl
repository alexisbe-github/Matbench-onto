@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:nequix_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Nequix"^^xsd:string ;
    arch:hasVariant archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_model_variant,
        archind:nequix_mp_pft_variant .

trind:nequix_mp_pft_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "Nequix MP PFT"^^xsd:string ;
    train:generatedBy trind:pft_fine_tuning .

archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture ;
    rdfs:label "EquivariantMessagePassingNeuralNetworkArchitecture"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_architecture_configuration ;
    arch:hasParameterNumber 707658 .

archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "EquivariantMessagePassingNeuralNetworkArchitecture architecture configuration"^^xsd:string .

archind:nequix_mp_pft_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "nequix_mp_pft"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2601.07742.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\nequix_mp_1_pft.yml" ;
    arch:hasParameterNumber 707658 .

dataind:atomic_structure_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "atomic structure"^^xsd:string .

dataind:crystal_structure_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "crystal structure"^^xsd:string .

dataind:force_constants_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "force constants"^^xsd:string .

dataind:mdr_phonon_pbe a owl:NamedIndividual,
        data:Dataset,
        data:LabeledDataset ;
    rdfs:label "MDR Phonon PBE"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 9959 ;
    data:usesAttributeAsInputFeature dataind:atomic_positions_attribute,
        dataind:atomic_species_attribute,
        dataind:supercell_structure_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:force_constants_attribute,
        dataind:forces_attribute,
        dataind:stress_attribute .

dataind:mptrj a owl:NamedIndividual,
        data:Dataset,
        train:TrainingDataset ;
    rdfs:label "MPtrj"^^xsd:string ;
    data:hasDataRepresentation dataind:atomic_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 145923 ;
    data:usesAttributeAsInputFeature dataind:atomic_positions_attribute,
        dataind:atomic_species_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_attribute,
        dataind:forces_attribute,
        dataind:stress_attribute .

dataind:supercell_structure_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "supercell structure"^^xsd:string .

trind:adamw a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "AdamW"^^xsd:string .

trind:batch_size a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "batch_size"^^xsd:string .

trind:co_train_ratio a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "co_train_ratio"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "learning_rate"^^xsd:string .

trind:loss_weight_energy a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "loss_weight_energy"^^xsd:string .

trind:loss_weight_force a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "loss_weight_force"^^xsd:string .

trind:loss_weight_force_constants a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "loss_weight_force_constants"^^xsd:string .

trind:loss_weight_stress a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "loss_weight_stress"^^xsd:string .

trind:nequix_mp_materialization a owl:NamedIndividual,
        train:ModelMaterialization ;
    rdfs:label "Nequix MP"^^xsd:string .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture batch_size value"^^xsd:string ;
    train:ofHyperparameter trind:batch_size .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_co_train_ratio_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture co_train_ratio value"^^xsd:string ;
    train:ofHyperparameter trind:co_train_ratio .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture learning_rate value"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_energy_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture loss_weight_energy value"^^xsd:string ;
    train:ofHyperparameter trind:loss_weight_energy .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_force_constants_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture loss_weight_force_constants value"^^xsd:string ;
    train:ofHyperparameter trind:loss_weight_force_constants .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_force_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture loss_weight_force value"^^xsd:string ;
    train:ofHyperparameter trind:loss_weight_force .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_stress_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture loss_weight_stress value"^^xsd:string ;
    train:ofHyperparameter trind:loss_weight_stress .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_num_epochs_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture num_epochs value"^^xsd:string ;
    train:ofHyperparameter trind:num_epochs .

trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_weight_decay_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture weight_decay value"^^xsd:string ;
    train:ofHyperparameter trind:weight_decay .

trind:num_epochs a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "num_epochs"^^xsd:string .

trind:pft_fine_tuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "pft_fine_tuning"^^xsd:string ;
    rdfs:comment "Phonon fine-tuning of Nequix MP on MDR Phonon PBE dataset with co-training on MPtrj"^^xsd:string ;
    train:hasHyperparameterValue trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_batch_size_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_co_train_ratio_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_learning_rate_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_energy_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_force_constants_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_force_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_loss_weight_stress_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_num_epochs_value,
        trind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_weight_decay_value ;
    train:initializedFromModelMaterialization trind:nequix_mp_materialization ;
    train:trainsModelVariant archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_model_variant ;
    train:usesDataset dataind:mdr_phonon_pbe,
        dataind:mptrj ;
    train:usesLoss trind:pft_loss ;
    train:usesObjectiveFunction trind:pft_loss ;
    train:usesOptimizer trind:adamw ;
    train:usesSamplingMethod trind:stochastic_hessian_column_sampling .

trind:stochastic_hessian_column_sampling a owl:NamedIndividual,
        train:SamplingMethod ;
    rdfs:label "stochastic Hessian column sampling"^^xsd:string .

trind:weight_decay a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "weight_decay"^^xsd:string .

archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "nequix_mp_pft EquivariantMessagePassingNeuralNetworkArchitecture"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:nequix_mp_pft_equivariantmessagepassingneuralnetworkarchitecture_architecture .

dataind:atomic_positions_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic positions"^^xsd:string .

dataind:atomic_species_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic species"^^xsd:string .

dataind:dft_labelling_method a owl:NamedIndividual,
        data:LabellingMethod ;
    rdfs:label "DFT"^^xsd:string .

dataind:energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "energy"^^xsd:string .

dataind:forces_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "forces"^^xsd:string .

dataind:stress_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "stress"^^xsd:string .

trind:pft_loss a owl:NamedIndividual,
        train:LossFunction,
        train:ObjectiveFunction ;
    rdfs:label "PFT loss"^^xsd:string .



