@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:tace_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "TACE"^^xsd:string ;
    arch:hasVariant archind:tace_oam_l_tensor_atomic_cluster_expansion_model_variant,
        archind:tace_oam_l_variant .

evalind:tace_oam_l_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "tace_oam_l_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:tace_oam_l_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:tace_oam_l_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:tace_oam_l_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "tace_oam_l_matbench_discovery_phonon_thermal_conductivity_contribution"^^xsd:string ;
    eval:evaluatesModelVariant archind:tace_oam_l_variant ;
    eval:evaluatesTask evalind:phonon_thermal_conductivity_contribution_task ;
    eval:producesBenchmarkResult evalind:tace_oam_l_matbench_discovery_phonon_thermal_conductivity_contribution_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:tace_oam_l_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "tace_oam_l_matbench_discovery_relaxed_structure_matching_rmsd"^^xsd:string ;
    eval:evaluatesModelVariant archind:tace_oam_l_variant ;
    eval:evaluatesTask evalind:relaxed_structure_matching_rmsd_task ;
    eval:producesBenchmarkResult evalind:tace_oam_l_matbench_discovery_relaxed_structure_matching_rmsd_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:tace_oam_l_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "tace_oam_l_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:tace_oam_l_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:tace_oam_l_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:fine_tuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "fine_tuning"^^xsd:string ;
    rdfs:comment "Fine-tuning pretrained TACE models on the RECIO-AgPdCHO dataset with 100,000 randomly selected structures for heterogeneous catalysis applications including adsorption and transition state searches"^^xsd:string ;
    train:hasHyperparameterValue trind:fine_tuning_activation_function_value,
        trind:fine_tuning_ase_optimizer_value,
        trind:fine_tuning_batch_size_value,
        trind:fine_tuning_batch_value,
        trind:fine_tuning_cell_filter_value,
        trind:fine_tuning_correlation_order_value,
        trind:fine_tuning_correlation_value,
        trind:fine_tuning_cutoff_radius_value,
        trind:fine_tuning_envelope_function_value,
        trind:fine_tuning_epochs_value,
        trind:fine_tuning_graph_construction_radius_value,
        trind:fine_tuning_initial_learning_rate_value,
        trind:fine_tuning_l1l2_value,
        trind:fine_tuning_learning_rate_value,
        trind:fine_tuning_lmax_value,
        trind:fine_tuning_loss_function_value,
        trind:fine_tuning_max_angular_momentum_value,
        trind:fine_tuning_max_force_value,
        trind:fine_tuning_max_neighbors_value,
        trind:fine_tuning_max_steps_value,
        trind:fine_tuning_max_tensor_rank_value,
        trind:fine_tuning_num_channel_value,
        trind:fine_tuning_num_channels_value,
        trind:fine_tuning_num_layers_value,
        trind:fine_tuning_optimizer_value,
        trind:fine_tuning_radial_basis_size_value ;
    train:trainsModelVariant archind:tace_oam_l_tensor_atomic_cluster_expansion_model_variant ;
    train:usesDataset dataind:recio_agpdcho ;
    train:usesLoss trind:weighted_sum_of_mse_for_energy_per_atom_forces_virials ;
    train:usesOptimizer trind:adam_with_amsgrad_variant .

trind:from_scratch_training a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "from_scratch_training"^^xsd:string ;
    rdfs:comment "Training from scratch on the RECIO-AgPdCHO dataset containing 116,516 structures with a cutoff of 6A, using warmup followed by cosine annealing learning rate scheduler, for heterogeneous catalysis benchmarks"^^xsd:string ;
    train:hasHyperparameterValue trind:from_scratch_training_activation_function_value,
        trind:from_scratch_training_ase_optimizer_value,
        trind:from_scratch_training_batch_size_value,
        trind:from_scratch_training_batch_value,
        trind:from_scratch_training_cell_filter_value,
        trind:from_scratch_training_correlation_order_value,
        trind:from_scratch_training_correlation_value,
        trind:from_scratch_training_cutoff_radius_value,
        trind:from_scratch_training_envelope_function_value,
        trind:from_scratch_training_epochs_value,
        trind:from_scratch_training_graph_construction_radius_value,
        trind:from_scratch_training_initial_learning_rate_value,
        trind:from_scratch_training_l1l2_value,
        trind:from_scratch_training_learning_rate_value,
        trind:from_scratch_training_lmax_value,
        trind:from_scratch_training_loss_function_value,
        trind:from_scratch_training_max_angular_momentum_value,
        trind:from_scratch_training_max_force_value,
        trind:from_scratch_training_max_neighbors_value,
        trind:from_scratch_training_max_steps_value,
        trind:from_scratch_training_max_tensor_rank_value,
        trind:from_scratch_training_num_channel_value,
        trind:from_scratch_training_num_channels_value,
        trind:from_scratch_training_num_layers_value,
        trind:from_scratch_training_optimizer_value,
        trind:from_scratch_training_radial_basis_size_value ;
    train:trainsModelVariant archind:tace_oam_l_tensor_atomic_cluster_expansion_model_variant ;
    train:usesDataset dataind:recio_agpdcho ;
    train:usesLoss trind:weighted_sum_of_mse_for_energy_per_atom_forces_virials ;
    train:usesOptimizer trind:adam_with_amsgrad_variant .

trind:multi_fidelity_training a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "multi_fidelity_training"^^xsd:string ;
    rdfs:comment "Training on the QeMFi dataset with five DFT fidelity levels (STO-3G, 3-21G, 6-31G, def2-SVP, def2-TZVP) simultaneously using universal invariant embeddings for fidelity tags, enabling cross-fidelity generalization"^^xsd:string ;
    train:hasHyperparameterValue trind:multi_fidelity_training_activation_function_value,
        trind:multi_fidelity_training_ase_optimizer_value,
        trind:multi_fidelity_training_batch_size_value,
        trind:multi_fidelity_training_batch_value,
        trind:multi_fidelity_training_cell_filter_value,
        trind:multi_fidelity_training_correlation_order_value,
        trind:multi_fidelity_training_correlation_value,
        trind:multi_fidelity_training_cutoff_radius_value,
        trind:multi_fidelity_training_envelope_function_value,
        trind:multi_fidelity_training_epochs_value,
        trind:multi_fidelity_training_graph_construction_radius_value,
        trind:multi_fidelity_training_initial_learning_rate_value,
        trind:multi_fidelity_training_l1l2_value,
        trind:multi_fidelity_training_learning_rate_value,
        trind:multi_fidelity_training_lmax_value,
        trind:multi_fidelity_training_loss_function_value,
        trind:multi_fidelity_training_max_angular_momentum_value,
        trind:multi_fidelity_training_max_force_value,
        trind:multi_fidelity_training_max_neighbors_value,
        trind:multi_fidelity_training_max_steps_value,
        trind:multi_fidelity_training_max_tensor_rank_value,
        trind:multi_fidelity_training_num_channel_value,
        trind:multi_fidelity_training_num_channels_value,
        trind:multi_fidelity_training_num_layers_value,
        trind:multi_fidelity_training_optimizer_value,
        trind:multi_fidelity_training_radial_basis_size_value ;
    train:trainsModelVariant archind:tace_oam_l_tensor_atomic_cluster_expansion_model_variant ;
    train:usesDataset dataind:qemfi ;
    train:usesLoss trind:weighted_sum_of_mse_for_energy_per_atom_forces_virials ;
    train:usesOptimizer trind:adam_with_amsgrad_variant .

trind:multi_head_training a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "multi_head_training"^^xsd:string ;
    rdfs:comment "Training with separate output heads for each fidelity level while sharing a common representation, evaluated on the QeMFi dataset and compared against multi-fidelity TACE and multi-head MACE"^^xsd:string ;
    train:hasHyperparameterValue trind:multi_head_training_activation_function_value,
