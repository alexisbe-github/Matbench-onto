trind:pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pretraining"^^xsd:string ;
    rdfs:comment "Pretraining on large-scale materials datasets such as OMat24 to learn general atomic representations before fine-tuning on specific tasks"^^xsd:string ;
