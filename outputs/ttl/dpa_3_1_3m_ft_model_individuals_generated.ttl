@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:dpa_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "DPA"^^xsd:string ;
    arch:hasVariant archind:dpa_3_1_3m_ft_variant .

trind:finetuning_mptrj_salex a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "finetuning_mptrj_salex"^^xsd:string ;
    rdfs:comment "Fine-tuning of the pretrained DPA-3.1-3M model on MPtrj and sAlex datasets to align the XC functional for improved performance on inorganic materials benchmarks such as Matbench Discovery."^^xsd:string ;
    train:trainsModelVariant archind:dpa_3_1_3m_ft_dpa3_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:salex .

trind:multitask_pretraining_openlam_v1 a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "multitask_pretraining_openlam_v1"^^xsd:string ;
    rdfs:comment "Multitask pretraining of DPA-3.1-3M on the OpenLAM-v1 dataset collection using dataset encoding for multi-task training across 31 diverse datasets. Training performed for 4 million steps on 128 GPUs with Adam optimizer, exponential learning rate scheduling from 1e-3 to 1e-6, and MSE loss function."^^xsd:string ;
    train:trainsModelVariant archind:dpa_3_1_3m_ft_dpa3_model_variant ;
    train:usesDataset dataind:openlam_v1 ;
    train:usesLoss trind:mse ;
    train:usesOptimizer trind:adam .

trind:scaling_law_omat24 a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "scaling_law_omat24"^^xsd:string ;
    rdfs:comment "Scaling law investigation of DPA3 models on the OMat24 dataset. Training experiments conducted with varying model sizes (L3, L6, L9, L16, 24) under six fixed IsoFLOP settings to demonstrate power-law scaling of validation energy MAE with model parameters, dataset size, and compute budget."^^xsd:string ;
    train:trainsModelVariant archind:dpa_3_1_3m_ft_dpa3_model_variant ;
    train:usesDataset dataind:omat24 ;
    train:usesLoss trind:mse ;
    train:usesOptimizer trind:adamw .

archind:dpa_3_1_3m_ft_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "dpa_3.1_3m_ft"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2506.01686.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\dpa_3_1_3m_ft.yml" ;
    arch:hasParameterNumber 3268838 .

dataind:mptrj a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MPtrj"^^xsd:string .

dataind:omat24 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "OMat24"^^xsd:string .

dataind:openlam_v1 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "OpenLAM-v1"^^xsd:string .

dataind:salex a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "sAlex"^^xsd:string .

trind:adam a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "Adam"^^xsd:string .

trind:adamw a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "AdamW"^^xsd:string .

trind:mse a owl:NamedIndividual,
        train:LossFunction ;
    rdfs:label "MSE"^^xsd:string .



