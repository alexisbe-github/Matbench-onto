    rdfs:comment "Pretraining of MatRIS-10M-MP on MPTrj dataset with denoising"^^xsd:string ;
    train:hasHyperparameterValue trind:matris_10m_mp_pretraining_ase_optimizer_value,
        trind:matris_10m_mp_pretraining_batch_size_value,
