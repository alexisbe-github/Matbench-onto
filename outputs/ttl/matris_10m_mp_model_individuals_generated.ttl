    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:matris_10m_mp_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "matris-10m-mp"^^xsd:string ;
    train:generatedBy trind:matris_10m_mp_pretraining .

archind:matris_10m_mp_matris_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MatRIS architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 128 ;
    arch:hasLayerCount 10 .

