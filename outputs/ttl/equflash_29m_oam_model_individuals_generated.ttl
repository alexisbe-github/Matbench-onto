trind:equflash_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "equflash_pretraining"^^xsd:string ;
    rdfs:comment "EquFlash is trained on OMat24, MPtrj, and sAlex datasets using Huber loss on energy, forces, and stress (S2EFS task) with Adam optimizer, learning rate 0.001, batch size 16, and linear scheduler."^^xsd:string ;
    train:hasHyperparameterValue trind:equflash_pretraining_activation_even_value,
        trind:equflash_pretraining_activation_odd_value,
        trind:equflash_pretraining_ase_optimizer_value,
        trind:equflash_pretraining_batch_size_value,
        trind:equflash_pretraining_cell_filter_value,
        trind:equflash_pretraining_cutoff_radius_value,
        trind:equflash_pretraining_graph_construction_radius_value,
        trind:equflash_pretraining_learning_rate_value,
        trind:equflash_pretraining_loss_function_value,
        trind:equflash_pretraining_max_force_value,
        trind:equflash_pretraining_max_neighbors_value,
        trind:equflash_pretraining_max_steps_value,
        trind:equflash_pretraining_optimizer_value,
        trind:equflash_pretraining_radial_basis_value,
        trind:equflash_pretraining_scheduler_value ;
    train:trainsModelVariant archind:equflash_29m_oam_sevennet_0_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:omat24,
        dataind:salex ;
    train:usesLoss trind:huberloss ;
    train:usesObjectiveFunction trind:huberloss ;
    train:usesOptimizer trind:adam .

