trind:eqv2_s_dens_mp_materialization a owl:NamedIndividual,
        train:Checkpoint,
        train:ModelMaterialization ;
    rdfs:label "eqV2-s-dens-mp"^^xsd:string ;
    train:generatedBy trind:mptrj_finetuning,
        trind:omat24_pretraining .

trind:mptrj_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "mptrj_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning of OMat24-pretrained EquiformerV2 on MPtrj dataset"^^xsd:string ;
    train:hasHyperparameterValue trind:mptrj_finetuning_ase_optimizer_value,
        trind:mptrj_finetuning_batch_size_value,
        trind:mptrj_finetuning_cell_filter_value,
        trind:mptrj_finetuning_denoising_loss_value,
        trind:mptrj_finetuning_dens_probability_value,
        trind:mptrj_finetuning_dropout_rate_value,
        trind:mptrj_finetuning_ema_decay_value,
        trind:mptrj_finetuning_energy_loss_value,
        trind:mptrj_finetuning_epochs_value,
        trind:mptrj_finetuning_force_loss_value,
        trind:mptrj_finetuning_grad_clip_threshold_value,
        trind:mptrj_finetuning_graph_construction_radius_value,
        trind:mptrj_finetuning_learning_rate_schedule_value,
        trind:mptrj_finetuning_loss_value,
        trind:mptrj_finetuning_max_force_value,
        trind:mptrj_finetuning_max_learning_rate_value,
        trind:mptrj_finetuning_max_neighbors_value,
        trind:mptrj_finetuning_max_steps_value,
        trind:mptrj_finetuning_min_learning_rate_factor_value,
        trind:mptrj_finetuning_noise_std_value,
        trind:mptrj_finetuning_optimizer_value,
        trind:mptrj_finetuning_stochastic_depth_value,
        trind:mptrj_finetuning_stress_loss_value,
        trind:mptrj_finetuning_warmup_epochs_value,
        trind:mptrj_finetuning_warmup_factor_value,
        trind:mptrj_finetuning_weight_decay_value ;
    train:initializedFromModelMaterialization trind:eqv2_s_dens_mp_materialization ;
    train:trainsModelVariant archind:eqv2_s_dens_mp_equiformerv2_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:mae ;
    train:usesOptimizer trind:adamw .

