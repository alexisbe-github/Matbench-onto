archind:equiformerv2_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "EquiformerV2"^^xsd:string ;
    arch:hasVariant archind:eqv2_s_dens_mp_equiformerv2_model_variant,
        archind:eqv2_s_dens_mp_variant .

