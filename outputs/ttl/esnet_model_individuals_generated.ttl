@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eval: <https://k.loria.fr/ontologies/evaluationonto#> .
@prefix evalind: <https://k.loria.fr/ontologies/evaluationonto-individuals#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:esnet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ESNet"^^xsd:string ;
    arch:hasVariant archind:esnet_cga_model_variant,
        archind:esnet_esnet_model_variant,
        archind:esnet_icomformer_model_variant,
        archind:esnet_rotate_model_variant,
        archind:esnet_variant .

evalind:esnet_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "esnet_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:esnet_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:esnet_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:esnet_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "esnet_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:esnet_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:esnet_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:full_test_set_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "full_test_set"^^xsd:string ;
    eval:hasTestSplit dataind:full_test_set .

evalind:most_stable_10k_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "most_stable_10k"^^xsd:string ;
    eval:hasTestSplit dataind:most_stable_10k .

evalind:test_split_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "test_split"^^xsd:string ;
    eval:hasTestSplit dataind:test_split .

evalind:unique_prototypes_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "unique_prototypes"^^xsd:string ;
    eval:hasTestSplit dataind:unique_prototypes .

trind:esnet_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "esnet"^^xsd:string ;
    train:generatedBy trind:esnet_pretraining .

archind:esnet_cga_architecture a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "CGA"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_cga_architecture_configuration .

archind:esnet_cga_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "CGA architecture configuration"^^xsd:string .

archind:esnet_cga_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet CGA"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_cga_architecture .

archind:esnet_crystal_structure_encoding_module_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Crystal Structure Encoding Module"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:esnet_crystal_structure_encoding_module_component_configuration .

archind:esnet_crystal_structure_encoding_module_component_configuration a owl:NamedIndividual,
