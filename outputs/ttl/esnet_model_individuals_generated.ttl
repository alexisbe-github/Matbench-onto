trind:esnet_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "esnet_pretraining"^^xsd:string ;
    rdfs:comment "ESNet pretrained on MP 2022 dataset for crystal structure to energy prediction (RS2RE task)."^^xsd:string ;
    train:hasHyperparameterValue trind:esnet_pretraining_graph_construction_radius_value,
        trind:esnet_pretraining_max_neighbors_value ;
    train:trainsModelVariant archind:esnet_esnet_model_variant ;
    train:usesDataset dataind:mp_2022 .

trind:esnet_pretraining_graph_construction_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet_pretraining graph_construction_radius value"^^xsd:string ;
    prov:value "8.0"^^xsd:float ;
    train:ofHyperparameter trind:graph_construction_radius .

trind:esnet_pretraining_max_neighbors_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "esnet_pretraining max_neighbors value"^^xsd:string ;
    prov:value 25 ;
    train:ofHyperparameter trind:max_neighbors .

trind:graph_construction_radius a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "graph_construction_radius"^^xsd:string .

trind:max_neighbors a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "max_neighbors"^^xsd:string .

archind:esnet_esnet_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet ESNet"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:esnet_esnet_architecture .

dataind:wbm_test_set a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "WBM test set"^^xsd:string .

evalind:matbench_discovery_benchmark_release a owl:NamedIndividual,
        eval:BenchmarkRelease ;
    rdfs:label "matbench_discovery_benchmark_release"^^xsd:string ;
    eval:hasTask evalind:convex_hull_distance_regression_task,
        evalind:thermodynamic_stability_classification_task .

archind:esnet_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "esnet"^^xsd:string ;
    dcterms:source <https://www.researchsquare.com/article/rs-5979703/v1> ;
    prov:wasDerivedFrom <https://www.researchsquare.com/article/rs-5979703/v1> ;
    arch:hasParameterNumber 5429033 .

