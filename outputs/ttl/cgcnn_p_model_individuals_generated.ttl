@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:cgcnn_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "CGCNN"^^xsd:string ;
    arch:hasVariant archind:cgcnn_p_cgcnn_hd_model_variant,
        archind:cgcnn_p_cgcnn_model_variant,
        archind:cgcnn_p_variant .

dataind:augmented_dataset a owl:NamedIndividual,
        train:TrainingDataset ;
    rdfs:label "augmented dataset"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 252000 ;
    data:usesAttributeAsInputFeature dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute,
        dataind:perturbed_atomic_coordinates_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute ;
    data:wasDerivedFromDataset dataind:relaxed_dataset .

dataind:h_relaxed a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "H-Relaxed"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute ;
    data:wasDerivedFromDataset dataind:nb_sr_h_hydride_structures .

dataind:h_unrelaxed a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "H-Unrelaxed"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute,
        dataind:unrelaxed_atomic_coordinates_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute ;
    data:wasDerivedFromDataset dataind:nb_sr_h_hydride_structures .

trind:cgcnn_hd_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "CGCNN-HD"^^xsd:string ;
    train:generatedBy trind:cgcnn_hd_pretraining .

trind:cgcnn_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "CGCNN"^^xsd:string ;
    train:generatedBy trind:cgcnn_pretraining .

trind:cgcnn_p_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "CGCNN+P"^^xsd:string ;
    train:generatedBy trind:cgcnn_pretraining .

archind:cgcnn_graph_convolutional_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "graph_convolutional_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_graph_convolutional_layers_component_configuration .

archind:cgcnn_graph_convolutional_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "graph_convolutional_layers component configuration"^^xsd:string .

archind:cgcnn_hd_dropout_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "dropout_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hd_dropout_layers_component_configuration .

archind:cgcnn_hd_dropout_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "dropout_layers component configuration"^^xsd:string .

archind:cgcnn_hd_graph_convolutional_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "graph_convolutional_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hd_graph_convolutional_layers_component_configuration .

archind:cgcnn_hd_graph_convolutional_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "graph_convolutional_layers component configuration"^^xsd:string .

archind:cgcnn_hd_hidden_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "hidden_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hd_hidden_layers_component_configuration .

archind:cgcnn_hd_hidden_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "hidden_layers component configuration"^^xsd:string .

archind:cgcnn_hd_pooling_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "pooling_layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hd_pooling_layer_component_configuration .

archind:cgcnn_hd_pooling_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "pooling_layer component configuration"^^xsd:string .

archind:cgcnn_hd_readout_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "readout_layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hd_readout_layer_component_configuration .

archind:cgcnn_hd_readout_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "readout_layer component configuration"^^xsd:string .

archind:cgcnn_hidden_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "hidden_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_hidden_layers_component_configuration .

archind:cgcnn_hidden_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "hidden_layers component configuration"^^xsd:string .

archind:cgcnn_p_cgcnn_architecture a owl:NamedIndividual,
        arch:GraphConvolutionArchitecture ;
    rdfs:label "CGCNN"^^xsd:string ;
    arch:hasComponent archind:cgcnn_graph_convolutional_layers_component,
        archind:cgcnn_hidden_layers_component,
        archind:cgcnn_pooling_layer_component,
        archind:cgcnn_readout_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_p_cgcnn_architecture_configuration .

archind:cgcnn_p_cgcnn_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "CGCNN architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 9 .

archind:cgcnn_p_cgcnn_hd_architecture a owl:NamedIndividual,
        arch:GraphConvolutionArchitecture ;
    rdfs:label "CGCNN-HD"^^xsd:string ;
    arch:hasComponent archind:cgcnn_hd_dropout_layers_component,
        archind:cgcnn_hd_graph_convolutional_layers_component,
        archind:cgcnn_hd_hidden_layers_component,
        archind:cgcnn_hd_pooling_layer_component,
        archind:cgcnn_hd_readout_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_p_cgcnn_hd_architecture_configuration .

archind:cgcnn_p_cgcnn_hd_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "CGCNN-HD architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 9 .

archind:cgcnn_p_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "cgcnn+p"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2202.13947.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\cgcnn_p.yml" ;
    arch:hasParameterNumber 128450 .

archind:cgcnn_pooling_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "pooling_layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_pooling_layer_component_configuration .

archind:cgcnn_pooling_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "pooling_layer component configuration"^^xsd:string .

archind:cgcnn_readout_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "readout_layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_readout_layer_component_configuration .

archind:cgcnn_readout_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "readout_layer component configuration"^^xsd:string .

dataind:perturbed_atomic_coordinates_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "perturbed_atomic_coordinates"^^xsd:string .

dataind:relaxed_dataset a owl:NamedIndividual,
        data:Dataset,
        train:TrainingDataset ;
    rdfs:label "relaxed dataset"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 126000 ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute ;
    data:wasDerivedFromDataset dataind:materials_project_database .

dataind:unrelaxed_atomic_coordinates_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "unrelaxed_atomic_coordinates"^^xsd:string .

trind:cgcnn_hd_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "cgcnn_hd_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of CGCNN-HD with dropout and hyperbolic tangent activation on Materials Project database"^^xsd:string ;
    train:hasHyperparameterValue trind:cgcnn_p_cgcnn_hd_activation_function_value,
        trind:cgcnn_p_cgcnn_hd_dropout_value,
        trind:cgcnn_p_cgcnn_hd_graph_convolutional_layers_value,
        trind:cgcnn_p_cgcnn_hd_hidden_layers_value,
        trind:cgcnn_p_cgcnn_hd_hidden_neurons_value,
        trind:cgcnn_p_cgcnn_hd_learning_rate_value ;
    train:trainsModelVariant archind:cgcnn_p_cgcnn_hd_model_variant ;
    train:usesDataset dataind:materials_project_database .

trind:cgcnn_p_cgcnn_activation_function_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN activation_function value"^^xsd:string ;
    train:ofHyperparameter trind:activation_function .

trind:cgcnn_p_cgcnn_graph_convolutional_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN graph_convolutional_layers value"^^xsd:string ;
    train:ofHyperparameter trind:graph_convolutional_layers .

trind:cgcnn_p_cgcnn_hd_activation_function_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD activation_function value"^^xsd:string ;
    train:ofHyperparameter trind:activation_function .

trind:cgcnn_p_cgcnn_hd_dropout_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD dropout value"^^xsd:string ;
    train:ofHyperparameter trind:dropout .

trind:cgcnn_p_cgcnn_hd_graph_convolutional_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD graph_convolutional_layers value"^^xsd:string ;
    train:ofHyperparameter trind:graph_convolutional_layers .

trind:cgcnn_p_cgcnn_hd_hidden_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD hidden_layers value"^^xsd:string ;
    train:ofHyperparameter trind:hidden_layers .

trind:cgcnn_p_cgcnn_hd_hidden_neurons_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD hidden_neurons value"^^xsd:string ;
    train:ofHyperparameter trind:hidden_neurons .

trind:cgcnn_p_cgcnn_hd_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN-HD learning_rate value"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate .

trind:cgcnn_p_cgcnn_hidden_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN hidden_layers value"^^xsd:string ;
    train:ofHyperparameter trind:hidden_layers .

trind:cgcnn_p_cgcnn_hidden_neurons_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN hidden_neurons value"^^xsd:string ;
    train:ofHyperparameter trind:hidden_neurons .

trind:cgcnn_p_cgcnn_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn+p CGCNN learning_rate value"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate .

trind:dropout a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "dropout"^^xsd:string .

archind:cgcnn_p_cgcnn_hd_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "cgcnn+p CGCNN-HD"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:cgcnn_p_cgcnn_hd_architecture .

archind:cgcnn_p_cgcnn_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "cgcnn+p CGCNN"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:cgcnn_p_cgcnn_architecture .

dataind:nb_sr_h_hydride_structures a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Nb-Sr-H hydride structures"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 623 ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute .

trind:activation_function a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "activation_function"^^xsd:string .

trind:cgcnn_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "cgcnn_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of CGCNN on Materials Project database of relaxed crystal structures for formation energy prediction"^^xsd:string ;
    train:hasHyperparameterValue trind:cgcnn_p_cgcnn_activation_function_value,
        trind:cgcnn_p_cgcnn_graph_convolutional_layers_value,
        trind:cgcnn_p_cgcnn_hidden_layers_value,
        trind:cgcnn_p_cgcnn_hidden_neurons_value,
        trind:cgcnn_p_cgcnn_learning_rate_value ;
    train:trainsModelVariant archind:cgcnn_p_cgcnn_model_variant ;
    train:usesDataset dataind:materials_project_database .

trind:graph_convolutional_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "graph_convolutional_layers"^^xsd:string .

trind:hidden_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "hidden_layers"^^xsd:string .

trind:hidden_neurons a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "hidden_neurons"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "learning_rate"^^xsd:string .

dataind:materials_project_database a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials Project database"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 126000 ;
    data:usesAttributeAsInputFeature dataind:atomic_coordinates_attribute,
        dataind:atomic_numbers_attribute,
        dataind:crystal_graph_attribute,
        dataind:lattice_vectors_attribute ;
    data:usesAttributeAsTargetFeature dataind:formation_energy_attribute .

dataind:atomic_coordinates_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_coordinates"^^xsd:string .

dataind:atomic_numbers_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_numbers"^^xsd:string .

dataind:crystal_graph_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "crystal_graph"^^xsd:string .

dataind:crystal_graph_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "crystal graph"^^xsd:string .

dataind:dft_labelling_method a owl:NamedIndividual,
        data:LabellingMethod ;
    rdfs:label "DFT"^^xsd:string .

dataind:formation_energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "formation_energy"^^xsd:string .

dataind:lattice_vectors_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "lattice_vectors"^^xsd:string .



