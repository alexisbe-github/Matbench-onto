@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eval: <https://k.loria.fr/ontologies/evaluationonto#> .
@prefix evalind: <https://k.loria.fr/ontologies/evaluationonto-individuals#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:bert_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "BERT"^^xsd:string ;
    arch:hasVariant archind:alchembert_transformer_model_variant,
        archind:alchembert_variant .

evalind:alchembert_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "alchembert_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:alchembert_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:alchembert_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:alchembert_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "alchembert_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:alchembert_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:alchembert_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:full_test_set_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "full_test_set"^^xsd:string ;
    eval:hasTestSplit dataind:full_test_set .

evalind:most_stable_10k_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "most_stable_10k"^^xsd:string ;
    eval:hasTestSplit dataind:most_stable_10k .

evalind:unique_prototypes_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "unique_prototypes"^^xsd:string ;
    eval:hasTestSplit dataind:unique_prototypes .

trind:alchembert_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "AlchemBERT"^^xsd:string ;
    train:generatedBy trind:alchembert_finetuning .

archind:alchembert_transformer_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Transformer architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 768 ;
    arch:hasLayerCount 12 .

archind:transformer_bert_base_cased_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "BERT-base-cased"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:transformer_bert_base_cased_component_configuration .

archind:transformer_bert_base_cased_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "BERT-base-cased component configuration"^^xsd:string .

archind:transformer_regression_head_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "regression_head component configuration"^^xsd:string .

dataind:full_test_set a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "full_test_set"^^xsd:string .

dataind:most_stable_10k a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "most_stable_10k"^^xsd:string .

dataind:mp_2022 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MP 2022"^^xsd:string .

dataind:unique_prototypes a owl:NamedIndividual,
        data:DatasetSplit ;
    rdfs:label "unique_prototypes"^^xsd:string .

evalind:alchembert_matbench_discovery_convex_hull_distance_regression_benchmark_result a owl:NamedIndividual,
        eval:BenchmarkResult ;
    rdfs:label "alchembert_matbench_discovery_convex_hull_distance_regression benchmark result"^^xsd:string ;
    eval:hasMetricResult evalind:alchembert_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_mae_metric_result,
        evalind:alchembert_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_missing_preds_metric_result,
