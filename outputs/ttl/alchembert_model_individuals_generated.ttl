        evalind:alchembert_matbench_discovery_convex_hull_distance_regression_discovery_most_stable_10k_missing_preds_metric_result,
        evalind:alchembert_matbench_discovery_convex_hull_distance_regression_discovery_most_stable_10k_r2_metric_result,
