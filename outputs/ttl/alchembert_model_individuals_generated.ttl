trind:alchembert_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "alchembert_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning BERT-base-cased with regression head on MP 2022 for IS2RE task"^^xsd:string ;
    train:hasHyperparameterValue trind:alchembert_finetuning_batch_size_value,
        trind:alchembert_finetuning_early_stopping_patience_value,
        trind:alchembert_finetuning_learning_rate_value ;
    train:initializedFromModelMaterialization trind:bert_base_cased_materialization ;
    train:trainsModelVariant archind:alchembert_transformer_model_variant ;
    train:usesDataset dataind:mp_2022 .

trind:alchembert_finetuning_batch_size_value a owl:NamedIndividual,
