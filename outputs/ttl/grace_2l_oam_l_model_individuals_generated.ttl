trind:grace_2l_omat_base_materialization a owl:NamedIndividual,
        train:Checkpoint,
        train:ModelMaterialization ;
    rdfs:label "GRACE-2L-OMAT-base"^^xsd:string ;
    train:generatedBy trind:omat24_pretraining .

trind:oam_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "oam_finetuning"^^xsd:string ;
    rdfs:comment "Fine-tuning of GRACE-2L-OMAT-base on MPTraj and sAlex combined dataset for 4 epochs with adjusted loss weights"^^xsd:string ;
    train:hasHyperparameterValue trind:oam_finetuning_ase_optimizer_value,
        trind:oam_finetuning_batch_size_value,
        trind:oam_finetuning_cell_filter_value,
        trind:oam_finetuning_chemical_embedding_dimension_value,
        trind:oam_finetuning_cutoff_radius_value,
        trind:oam_finetuning_graph_construction_radius_value,
        trind:oam_finetuning_learning_rate_value,
        trind:oam_finetuning_loss_weights_value,
        trind:oam_finetuning_max_angular_momentum_value,
        trind:oam_finetuning_max_force_value,
        trind:oam_finetuning_max_neighbors_value,
        trind:oam_finetuning_max_steps_value,
        trind:oam_finetuning_product_order_value,
        trind:oam_finetuning_radial_basis_size_value ;
    train:initializedFromModelMaterialization trind:grace_2l_omat_base_materialization ;
    train:trainsModelVariant archind:grace_2l_oam_l_grace_2l_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:salex ;
    train:usesLoss trind:huber_loss ;
    train:usesObjectiveFunction trind:combined_energy_force_stress_loss ;
    train:usesOptimizer trind:adam .

trind:oam_finetuning_ase_optimizer_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "oam_finetuning ase_optimizer value"^^xsd:string ;
    prov:value "FIRE"^^xsd:string ;
    train:ofHyperparameter trind:ase_optimizer .

trind:oam_finetuning_batch_size_value a owl:NamedIndividual,
