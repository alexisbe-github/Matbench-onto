    train:trainsModelVariant archind:grace_2l_oam_l_grace_2l_model_variant ;
    train:usesDataset dataind:omat24 ;
    train:usesLoss trind:huber_loss ;
    train:usesObjectiveFunction trind:combined_energy_force_stress_loss ;
