trind:conservative_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "conservative_finetuning"^^xsd:string ;
    rdfs:comment "Conservative fine-tuning of eSEN-30M on MPTrj for 40 epochs starting from direct-force pretrained model"^^xsd:string ;
    train:hasHyperparameterValue trind:conservative_finetuning_ase_optimizer_value,
        trind:conservative_finetuning_batch_size_value,
        trind:conservative_finetuning_cell_filter_value,
        trind:conservative_finetuning_cutoff_radius_value,
        trind:conservative_finetuning_energy_loss_coefficient_value,
        trind:conservative_finetuning_force_loss_coefficient_value,
        trind:conservative_finetuning_gradient_clipping_norm_value,
        trind:conservative_finetuning_graph_construction_radius_value,
        trind:conservative_finetuning_learning_rate_schedule_value,
        trind:conservative_finetuning_learning_rate_value,
        trind:conservative_finetuning_max_force_value,
        trind:conservative_finetuning_max_learning_rate_value,
        trind:conservative_finetuning_max_neighbors_value,
        trind:conservative_finetuning_max_steps_value,
        trind:conservative_finetuning_maximum_degree_value,
        trind:conservative_finetuning_maximum_order_value,
        trind:conservative_finetuning_model_ema_decay_value,
        trind:conservative_finetuning_number_of_channels_value,
        trind:conservative_finetuning_number_of_epochs_value,
        trind:conservative_finetuning_number_of_esen_layer_blocks_value,
        trind:conservative_finetuning_number_of_radial_basis_functions_value,
        trind:conservative_finetuning_optimizer_type_value,
        trind:conservative_finetuning_radial_basis_function_type_value,
        trind:conservative_finetuning_stress_loss_coefficient_value,
        trind:conservative_finetuning_warmup_epochs_value,
        trind:conservative_finetuning_warmup_factor_value,
        trind:conservative_finetuning_weight_decay_value ;
    train:initializedFromModelMaterialization trind:esen_30m_direct_force_pretrained_materialization ;
    train:trainsModelVariant archind:esen_30m_mp_esen_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesOptimizer trind:adamw .

