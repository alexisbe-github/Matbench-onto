archind:esen_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "eSEN"^^xsd:string ;
    arch:hasVariant archind:esen_30m_mp_esen_model_variant,
        archind:esen_30m_mp_variant .

