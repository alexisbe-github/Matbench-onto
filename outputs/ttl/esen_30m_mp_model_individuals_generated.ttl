trind:esen_30m_mp_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "eSEN-30M-MP"^^xsd:string ;
    train:generatedBy trind:conservative_finetuning,
        trind:direct_force_pretraining .

