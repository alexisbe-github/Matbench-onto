archind:voronoi_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Voronoi"^^xsd:string ;
    arch:hasVariant archind:voronoi_rf_fingerprint_model_variant,
        archind:voronoi_rf_variant .

evalind:voronoi_rf_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "voronoi_rf_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:voronoi_rf_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:voronoi_rf_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:voronoi_rf_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "voronoi_rf_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:voronoi_rf_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:voronoi_rf_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:voronoi_rf_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "voronoi_rf_training_run"^^xsd:string ;
    train:trainsModelVariant archind:voronoi_rf_fingerprint_model_variant ;
    train:usesDataset dataind:mp_2022 .

archind:voronoi_rf_fingerprint_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Fingerprint architecture configuration"^^xsd:string .

dataind:mp_2022 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MP 2022"^^xsd:string .

