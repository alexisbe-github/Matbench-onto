    rdfs:label "NequIP"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:gnome_graph_neural_network_nequip_component_configuration .

archind:gnome_graph_neural_network_nequip_component_configuration a owl:NamedIndividual,
