    rdfs:label "graph_construction_radius"^^xsd:string .

trind:huber_loss a owl:NamedIndividual,
        train:LossFunction ;
    rdfs:label "Huber_loss"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "learning_rate"^^xsd:string .

trind:loss_function a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "loss_function"^^xsd:string .

trind:max_neighbors a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "max_neighbors"^^xsd:string .

trind:message_passing_iterations a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "message_passing_iterations"^^xsd:string .

trind:n_features a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "n_features"^^xsd:string .

trind:n_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "n_layers"^^xsd:string .

trind:optimizer a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "optimizer"^^xsd:string .

trind:radial_cutoff a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "radial_cutoff"^^xsd:string .

archind:gnome_gnome_graph_neural_network_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "gnome GNoME_graph_neural_network"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:gnome_gnome_graph_neural_network_architecture .



