@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:gnome_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "GNoME"^^xsd:string ;
    arch:hasVariant archind:gnome_gnome_compositional_gnn_model_variant,
        archind:gnome_gnome_graph_neural_network_model_variant,
        archind:gnome_variant .

evalind:gnome_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "gnome_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:gnome_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:gnome_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:gnome_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "gnome_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:gnome_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:gnome_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:gnome_final_ensemble_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "GNoME_final_ensemble"^^xsd:string ;
    train:generatedBy trind:gnome_active_learning_finetuning .

trind:gnome_pretrained_nequip_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "GNoME_pretrained_NequIP"^^xsd:string ;
    train:generatedBy trind:gnome_interatomic_potential_pretraining .

archind:gnome_compositional_gnn_linear_readout_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "linear_readout component configuration"^^xsd:string .

archind:gnome_gnome_compositional_gnn_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture ;
    rdfs:label "GNoME_compositional_GNN"^^xsd:string ;
    arch:hasComponent archind:gnome_compositional_gnn_linear_readout_component ;
    arch:hasHeadArchitecture archind:gnome_compositional_gnn_linear_readout_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:gnome_gnome_compositional_gnn_architecture_configuration .

archind:gnome_gnome_compositional_gnn_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "GNoME_compositional_GNN architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 256 ;
    arch:hasLayerCount 3 .

archind:gnome_gnome_graph_neural_network_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture ;
    rdfs:label "GNoME_graph_neural_network"^^xsd:string ;
    arch:hasBackboneArchitecture archind:gnome_graph_neural_network_nequip_component ;
    arch:hasComponent archind:gnome_graph_neural_network_gated_equivariant_nonlinearity_component,
        archind:gnome_graph_neural_network_radial_mlp_component,
        archind:gnome_graph_neural_network_self_connection_component ;
    arch:hasHeadArchitecture archind:gnome_graph_neural_network_linear_readout_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:gnome_gnome_graph_neural_network_architecture_configuration ;
    arch:hasParameterNumber 16240000 .

archind:gnome_gnome_graph_neural_network_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "GNoME_graph_neural_network architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 128 ;
    arch:hasLayerCount 5 .

archind:gnome_graph_neural_network_gated_equivariant_nonlinearity_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "gated_equivariant_nonlinearity"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:gnome_graph_neural_network_gated_equivariant_nonlinearity_component_configuration .

archind:gnome_graph_neural_network_gated_equivariant_nonlinearity_component_configuration a owl:NamedIndividual,
