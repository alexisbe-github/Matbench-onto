    rdfs:label "radial_MLP component configuration"^^xsd:string .

archind:gnome_graph_neural_network_self_connection_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "self_connection"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:gnome_graph_neural_network_self_connection_component_configuration .

archind:gnome_graph_neural_network_self_connection_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "self_connection component configuration"^^xsd:string .

dataind:oqmd a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "OQMD"^^xsd:string .

