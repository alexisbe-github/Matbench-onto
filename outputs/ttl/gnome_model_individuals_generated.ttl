        data:LabellingMethod ;
    rdfs:label "experimental_measurement"^^xsd:string .

dataind:icsd a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "ICSD"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:experimental_measurement_labelling_method ;
    data:hasNumberOfSamples 200000 ;
    data:usesAttributeAsInputFeature dataind:atom_type_attribute,
        dataind:lattice_attribute,
        dataind:structure_attribute ;
