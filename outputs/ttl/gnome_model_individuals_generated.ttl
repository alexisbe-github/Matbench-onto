    rdfs:label "gnome_active_learning_finetuning graph_construction_radius value"^^xsd:string ;
    prov:value "5.0"^^xsd:float ;
    train:ofHyperparameter trind:graph_construction_radius .

trind:gnome_active_learning_finetuning_learning_rate_value a owl:NamedIndividual,
