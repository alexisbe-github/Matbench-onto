trind:active_learning_sampling a owl:NamedIndividual,
        train:SamplingMethod ;
    rdfs:label "active_learning_sampling"^^xsd:string .

trind:gnome_active_learning_finetuning a owl:NamedIndividual,
        train:MachineLearningActiveLearningRun ;
    rdfs:label "gnome_active_learning_finetuning"^^xsd:string ;
    rdfs:comment "Six rounds of active learning where GNoME models filter candidates, DFT verifies predictions, and new data is added to training set. Final MAE improved to 11 meV/atom."^^xsd:string ;
    train:hasHyperparameterValue trind:gnome_active_learning_finetuning_batch_size_value,
        trind:gnome_active_learning_finetuning_embedding_dimension_value,
        trind:gnome_active_learning_finetuning_epochs_value,
        trind:gnome_active_learning_finetuning_graph_construction_radius_value,
        trind:gnome_active_learning_finetuning_learning_rate_value,
        trind:gnome_active_learning_finetuning_loss_function_value,
        trind:gnome_active_learning_finetuning_max_neighbors_value,
        trind:gnome_active_learning_finetuning_message_passing_iterations_value,
        trind:gnome_active_learning_finetuning_n_features_value,
        trind:gnome_active_learning_finetuning_n_layers_value,
        trind:gnome_active_learning_finetuning_optimizer_value,
        trind:gnome_active_learning_finetuning_radial_cutoff_value ;
    train:initializedFromModelMaterialization trind:gnome_initial_model_materialization ;
    train:trainsModelVariant archind:gnome_gnome_compositional_gnn_model_variant,
        archind:gnome_gnome_graph_neural_network_model_variant ;
    train:usesBatchedSelection true ;
    train:usesDataset dataind:gnome,
        dataind:materials_project,
        dataind:oqmd ;
    train:usesLoss trind:huber_loss ;
    train:usesObjectiveFunction trind:energy_and_force_prediction ;
    train:usesOptimizer trind:adam ;
    train:usesSamplingMethod trind:active_learning_sampling .

trind:gnome_active_learning_finetuning_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "gnome_active_learning_finetuning batch_size value"^^xsd:string ;
    prov:value 32 ;
    train:ofHyperparameter trind:batch_size .

trind:gnome_active_learning_finetuning_embedding_dimension_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "gnome_active_learning_finetuning embedding_dimension value"^^xsd:string ;
    train:ofHyperparameter trind:embedding_dimension .

trind:gnome_active_learning_finetuning_epochs_value a owl:NamedIndividual,
