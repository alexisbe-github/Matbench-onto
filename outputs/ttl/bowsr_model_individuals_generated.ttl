@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:bowsr_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "BOWSR"^^xsd:string ;
    arch:hasVariant archind:bowsr_bowsr_model_variant,
        archind:bowsr_megnet_model_variant,
        archind:bowsr_variant .

evalind:bowsr_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "bowsr_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:bowsr_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:bowsr_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:bowsr_matbench_discovery_relaxed_structure_matching_rmsd_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "bowsr_matbench_discovery_relaxed_structure_matching_rmsd"^^xsd:string ;
    eval:evaluatesModelVariant archind:bowsr_variant ;
    eval:evaluatesTask evalind:relaxed_structure_matching_rmsd_task ;
    eval:producesBenchmarkResult evalind:bowsr_matbench_discovery_relaxed_structure_matching_rmsd_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:bowsr_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "bowsr_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:bowsr_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:bowsr_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:megnet_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MEGNet"^^xsd:string ;
    train:generatedBy trind:megnet_pretraining .

archind:bowsr_bowsr_architecture a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "BOWSR"^^xsd:string ;
    arch:hasBackboneArchitecture archind:bowsr_megnet_component ;
    arch:hasComponent archind:bowsr_megnet_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_bowsr_architecture_configuration .

archind:bowsr_bowsr_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "BOWSR architecture configuration"^^xsd:string .

archind:bowsr_bowsr_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "bowsr BOWSR"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:bowsr_bowsr_architecture .

archind:bowsr_megnet_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture ;
    rdfs:label "MEGNet"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_megnet_architecture_configuration .

archind:bowsr_megnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MEGNet architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 3 .

archind:bowsr_megnet_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MEGNet component configuration"^^xsd:string .

dataind:mp_graphs a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MP Graphs"^^xsd:string .

