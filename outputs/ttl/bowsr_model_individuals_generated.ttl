@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:bowsr_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "BOWSR"^^xsd:string ;
    arch:hasVariant archind:bowsr_bowsr_model_variant,
        archind:bowsr_gaussian_process_model_variant,
        archind:bowsr_megnet_model_variant,
        archind:bowsr_variant .

dataind:elastic_moduli_dataset a owl:NamedIndividual,
        data:LabeledDataset ;
    rdfs:label "Elastic Moduli Dataset"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 1672 ;
    data:usesAttributeAsInputFeature dataind:atomic_positions_attribute,
        dataind:crystal_structure_attribute,
        dataind:lattice_parameters_attribute ;
    data:usesAttributeAsTargetFeature dataind:bulk_modulus_attribute,
        dataind:shear_modulus_attribute ;
    data:wasDerivedFromDataset dataind:materials_project .

dataind:property_prediction_dataset a owl:NamedIndividual,
        data:LabeledDataset ;
    rdfs:label "Property Prediction Dataset"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 12277 ;
    data:usesAttributeAsInputFeature dataind:atomic_positions_attribute,
        dataind:crystal_structure_attribute,
        dataind:lattice_parameters_attribute ;
    data:usesAttributeAsTargetFeature dataind:bulk_modulus_attribute,
        dataind:formation_energy_attribute,
        dataind:shear_modulus_attribute ;
    data:wasDerivedFromDataset dataind:materials_project .

dataind:screening_candidates a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Screening Candidates"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasNumberOfSamples 399960 ;
    data:usesAttributeAsInputFeature dataind:composition_attribute,
        dataind:crystal_structure_attribute ;
    data:wasDerivedFromDataset dataind:icsd .

trind:bowsr_bowsr_acquisition_function_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr BOWSR acquisition_function value"^^xsd:string ;
    train:ofHyperparameter trind:acquisition_function .

trind:bowsr_bowsr_kernel_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr BOWSR kernel value"^^xsd:string ;
    train:ofHyperparameter trind:kernel .

trind:bowsr_bowsr_max_iterations_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr BOWSR max_iterations value"^^xsd:string ;
    train:ofHyperparameter trind:max_iterations .

trind:bowsr_bowsr_noise_level_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr BOWSR noise_level value"^^xsd:string ;
    train:ofHyperparameter trind:noise_level .

trind:bowsr_bowsr_xi_parameter_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr BOWSR xi_parameter value"^^xsd:string ;
    train:ofHyperparameter trind:xi_parameter .

trind:bowsr_gaussian_process_kernel_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr Gaussian Process kernel value"^^xsd:string ;
    train:ofHyperparameter trind:kernel .

trind:bowsr_gaussian_process_noise_level_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "bowsr Gaussian Process noise_level value"^^xsd:string ;
    train:ofHyperparameter trind:noise_level .

trind:megnet_elasticity_model_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MEGNet_elasticity_model"^^xsd:string ;
    train:generatedBy trind:megnet_elasticity_pretraining .

trind:megnet_formation_energy_model_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "MEGNet_formation_energy_model"^^xsd:string ;
    train:generatedBy trind:megnet_formation_energy_pretraining .

archind:bowsr_bowsr_architecture a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "BOWSR"^^xsd:string ;
    arch:hasBackboneArchitecture archind:bowsr_megnet_component ;
    arch:hasComponent archind:bowsr_gaussian_process_component,
        archind:bowsr_megnet_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_bowsr_architecture_configuration .

archind:bowsr_bowsr_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "BOWSR architecture configuration"^^xsd:string .

archind:bowsr_bowsr_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "bowsr BOWSR"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:bowsr_bowsr_architecture .

archind:bowsr_gaussian_process_architecture a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Gaussian Process"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_gaussian_process_architecture_configuration .

archind:bowsr_gaussian_process_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Gaussian Process architecture configuration"^^xsd:string .

archind:bowsr_gaussian_process_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Gaussian Process"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_gaussian_process_component_configuration .

archind:bowsr_gaussian_process_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Gaussian Process component configuration"^^xsd:string .

archind:bowsr_gaussian_process_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "bowsr Gaussian Process"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:bowsr_gaussian_process_architecture .

archind:bowsr_megnet_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture ;
    rdfs:label "MEGNet"^^xsd:string ;
    arch:hasBackboneArchitecture archind:megnet_graph_convolutional_layers_component ;
    arch:hasComponent archind:megnet_graph_convolutional_layers_component,
        archind:megnet_set2set_readout_component,
        archind:megnet_shifted_softplus_activation_component ;
    arch:hasHeadArchitecture archind:megnet_set2set_readout_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_megnet_architecture_configuration .

archind:bowsr_megnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MEGNet architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 64 ;
    arch:hasLayerCount 3 .

archind:bowsr_megnet_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "MEGNet component configuration"^^xsd:string .

archind:bowsr_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "bowsr"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2104.10242.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\bowsr.yml" ;
    arch:hasParameterNumber 167761 .

archind:megnet_graph_convolutional_layers_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Graph Convolutional Layers component configuration"^^xsd:string .

archind:megnet_set2set_readout_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Set2set Readout component configuration"^^xsd:string .

archind:megnet_shifted_softplus_activation_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "Shifted Softplus Activation"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:megnet_shifted_softplus_activation_component_configuration .

archind:megnet_shifted_softplus_activation_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Shifted Softplus Activation component configuration"^^xsd:string .

dataind:atomic_nodes_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_nodes"^^xsd:string .

dataind:bond_edges_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "bond_edges"^^xsd:string .

dataind:composition_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "composition"^^xsd:string .

dataind:crystal_graph_representation a owl:NamedIndividual,
        data:DataRepresentation ;
    rdfs:label "crystal graph"^^xsd:string .

dataind:icsd a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "ICSD"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_structure_representation ;
    data:hasNumberOfSamples 5555 ;
    data:usesAttributeAsInputFeature dataind:atomic_positions_attribute,
        dataind:crystal_structure_attribute,
        dataind:lattice_parameters_attribute,
        dataind:space_group_attribute .

dataind:space_group_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "space_group"^^xsd:string .

trind:acquisition_function a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "acquisition_function"^^xsd:string .

trind:batch_size a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "batch_size"^^xsd:string .

trind:cutoff_radius a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "cutoff_radius"^^xsd:string .

trind:early_stopping_patience a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "early_stopping_patience"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "learning_rate"^^xsd:string .

trind:max_epochs a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "max_epochs"^^xsd:string .

trind:max_iterations a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "max_iterations"^^xsd:string .

trind:megnet_elasticity_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "megnet_elasticity_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of MEGNet elasticity model on 12,179 crystals from Materials Project"^^xsd:string ;
    train:hasHyperparameterValue trind:bowsr_megnet_batch_size_value,
        trind:bowsr_megnet_cutoff_radius_value,
        trind:bowsr_megnet_early_stopping_patience_value,
        trind:bowsr_megnet_learning_rate_value,
        trind:bowsr_megnet_max_epochs_value,
        trind:bowsr_megnet_neurons_per_layer_value,
        trind:bowsr_megnet_set2set_passes_value ;
    train:trainsModelVariant archind:bowsr_megnet_model_variant ;
    train:usesDataset dataind:materials_project ;
    train:usesOptimizer trind:adam .

trind:megnet_formation_energy_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "megnet_formation_energy_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of MEGNet formation energy model on 133,420 crystals from Materials Project"^^xsd:string ;
    train:hasHyperparameterValue trind:bowsr_megnet_batch_size_value,
        trind:bowsr_megnet_cutoff_radius_value,
        trind:bowsr_megnet_early_stopping_patience_value,
        trind:bowsr_megnet_learning_rate_value,
        trind:bowsr_megnet_max_epochs_value,
        trind:bowsr_megnet_neurons_per_layer_value,
        trind:bowsr_megnet_set2set_passes_value ;
    train:trainsModelVariant archind:bowsr_megnet_model_variant ;
    train:usesDataset dataind:materials_project ;
    train:usesOptimizer trind:adam .

trind:neurons_per_layer a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "neurons_per_layer"^^xsd:string .

trind:set2set_passes a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "set2set_passes"^^xsd:string .

trind:xi_parameter a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "xi_parameter"^^xsd:string .

archind:bowsr_megnet_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "MEGNet"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:bowsr_megnet_component_configuration .

archind:megnet_graph_convolutional_layers_component a owl:NamedIndividual,
