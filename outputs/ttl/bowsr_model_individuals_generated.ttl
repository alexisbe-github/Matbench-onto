        arch:ModelVariant ;
    rdfs:label "bowsr MEGNet"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:bowsr_megnet_architecture .

dataind:atomic_positions_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "atomic_positions"^^xsd:string .

