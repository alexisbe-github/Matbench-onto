dataind:formation_energy_attribute a owl:NamedIndividual,
        data:DatasetAttribute ;
    rdfs:label "formation_energy"^^xsd:string .

trind:adam a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "Adam"^^xsd:string .

trind:bowsr_megnet_batch_size_value a owl:NamedIndividual,
