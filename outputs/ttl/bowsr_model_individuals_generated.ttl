trind:megnet_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "megnet_pretraining"^^xsd:string ;
    rdfs:comment "MEGNet formation energy and elasticity models trained on Materials Project DFT data using Adam optimizer with learning rate 0.001, batch size 128, up to 1500 epochs with early stopping patience of 500"^^xsd:string ;
    train:hasHyperparameterValue trind:megnet_pretraining_batch_size_value,
        trind:megnet_pretraining_cutoff_radius_value,
        trind:megnet_pretraining_early_stopping_patience_value,
        trind:megnet_pretraining_graph_convolution_layers_value,
        trind:megnet_pretraining_learning_rate_value,
        trind:megnet_pretraining_max_epochs_value,
        trind:megnet_pretraining_readout_passes_value ;
    train:trainsModelVariant archind:bowsr_megnet_model_variant ;
    train:usesDataset dataind:mp_graphs ;
    train:usesOptimizer trind:adam .

trind:megnet_pretraining_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "megnet_pretraining batch_size value"^^xsd:string ;
    train:ofHyperparameter trind:batch_size .

