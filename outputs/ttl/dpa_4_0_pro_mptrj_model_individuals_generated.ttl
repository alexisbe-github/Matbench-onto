trind:dpa_4_0_pro_mptrj_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "dpa_4_0_pro_mptrj_pretraining"^^xsd:string ;
    rdfs:comment "Pretraining of DPA4.0-Pro-MPtrj on MPtrj dataset using conservative energy-gradient training"^^xsd:string ;
    train:hasHyperparameterValue trind:dpa_4_0_pro_mptrj_pretraining_ase_optimizer_value,
