        trind:dpa_4_0_pro_mptrj_pretraining_optimizer_value,
        trind:dpa_4_0_pro_mptrj_pretraining_weight_decay_value ;
    train:trainsModelVariant archind:dpa_4_0_pro_mptrj_dpa4_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:conservative_energy_gradient_loss ;
    train:usesObjectiveFunction trind:energy_and_force_matching ;
    train:usesOptimizer trind:hybridmuon .

