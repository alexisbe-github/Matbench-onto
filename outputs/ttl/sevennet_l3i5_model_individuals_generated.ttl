@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:sevennet_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "SevenNet"^^xsd:string ;
    arch:hasVariant archind:sevennet_0_nequip_model_variant,
        archind:sevennet_0_variant .

trind:sevennet_0_nequip_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP batch size value"^^xsd:string ;
    train:ofHyperparameter trind:batch_size .

trind:sevennet_0_nequip_cutoff_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP cutoff radius value"^^xsd:string ;
    train:ofHyperparameter trind:cutoff_radius .

trind:sevennet_0_nequip_force_loss_weight_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP force loss weight value"^^xsd:string ;
    train:ofHyperparameter trind:force_loss_weight .

trind:sevennet_0_nequip_huber_loss_threshold_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP Huber loss threshold value"^^xsd:string ;
    train:ofHyperparameter trind:huber_loss_threshold .

trind:sevennet_0_nequip_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP learning rate value"^^xsd:string ;
    train:ofHyperparameter trind:learning_rate .

trind:sevennet_0_nequip_maximum_degree_of_representation_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP maximum degree of representation value"^^xsd:string ;
    train:ofHyperparameter trind:maximum_degree_of_representation .

trind:sevennet_0_nequip_number_of_channels_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP number of channels value"^^xsd:string ;
    train:ofHyperparameter trind:number_of_channels .

trind:sevennet_0_nequip_number_of_message_passing_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP number of message-passing layers value"^^xsd:string ;
    train:ofHyperparameter trind:number_of_message_passing_layers .

trind:sevennet_0_nequip_stress_loss_weight_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "sevennet_0 NequIP stress loss weight value"^^xsd:string ;
    train:ofHyperparameter trind:stress_loss_weight .

trind:training_run_details a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "training_run_details"^^xsd:string .

archind:sevennet_0_nequip_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture ;
    rdfs:label "NequIP"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:sevennet_0_nequip_architecture_configuration .

archind:sevennet_0_nequip_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "NequIP architecture configuration"^^xsd:string .

archind:sevennet_0_nequip_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "sevennet_0 NequIP"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:sevennet_0_nequip_architecture .

archind:sevennet_0_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "sevennet_0"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2402.03789.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\sevennet_l3i5.yml" ;
    arch:hasParameterNumber 842440 .

trind:batch_size a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "batch size"^^xsd:string .

trind:cutoff_radius a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "cutoff radius"^^xsd:string .

trind:force_loss_weight a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "force loss weight"^^xsd:string .

trind:huber_loss_threshold a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Huber loss threshold"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "learning rate"^^xsd:string .

trind:maximum_degree_of_representation a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "maximum degree of representation"^^xsd:string .

trind:number_of_channels a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "number of channels"^^xsd:string .

trind:number_of_message_passing_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "number of message-passing layers"^^xsd:string .

trind:stress_loss_weight a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "stress loss weight"^^xsd:string .



