trind:orb_v2_mptrj_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "orb_v2_mptrj_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:orb_v2_mptrj_training_run_ase_optimizer_value,
        trind:orb_v2_mptrj_training_run_batch_size_value,
        trind:orb_v2_mptrj_training_run_cell_filter_value,
        trind:orb_v2_mptrj_training_run_ema_decay_value,
        trind:orb_v2_mptrj_training_run_features_value,
        trind:orb_v2_mptrj_training_run_gradient_clip_value,
        trind:orb_v2_mptrj_training_run_graph_construction_radius_value,
        trind:orb_v2_mptrj_training_run_initial_learning_rate_value,
        trind:orb_v2_mptrj_training_run_learning_rate_schedule_value,
        trind:orb_v2_mptrj_training_run_loss_value,
        trind:orb_v2_mptrj_training_run_max_force_value,
        trind:orb_v2_mptrj_training_run_max_neighbors_value,
        trind:orb_v2_mptrj_training_run_max_steps_value,
        trind:orb_v2_mptrj_training_run_n_layers_value,
        trind:orb_v2_mptrj_training_run_num_rbfs_value,
        trind:orb_v2_mptrj_training_run_optimizer_value ;
    train:trainsModelVariant archind:orb_v2_mptrj_graphnetworksimulator_model_variant ;
    train:usesLoss trind:mae ;
    train:usesOptimizer trind:adam .

