archind:orb_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ORB"^^xsd:string ;
    arch:hasVariant archind:orb_v2_mptrj_graphnetworksimulator_model_variant,
        archind:orb_v2_mptrj_variant .

evalind:orb_v2_mptrj_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "orb_v2_mptrj_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:orb_v2_mptrj_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:orb_v2_mptrj_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:orb_v2_mptrj_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
