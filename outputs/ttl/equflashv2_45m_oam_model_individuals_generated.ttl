trind:equflashv2_45m_oam_training_run a owl:NamedIndividual,
        train:MachineLearningTrainingRun ;
    rdfs:label "equflashv2_45m_oam_training_run"^^xsd:string ;
    train:hasHyperparameterValue trind:equflashv2_45m_oam_training_run_ase_optimizer_value,
        trind:equflashv2_45m_oam_training_run_cell_filter_value,
        trind:equflashv2_45m_oam_training_run_graph_construction_radius_value,
        trind:equflashv2_45m_oam_training_run_max_force_value,
        trind:equflashv2_45m_oam_training_run_max_neighbors_value,
        trind:equflashv2_45m_oam_training_run_max_steps_value ;
    train:trainsModelVariant archind:equflashv2_45m_oam_uip_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:omat24,
        dataind:salex .

archind:equflashv2_45m_oam_uip_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "UIP architecture configuration"^^xsd:string .

dataind:kappa_103_phonon_benchmark_set a owl:NamedIndividual,
