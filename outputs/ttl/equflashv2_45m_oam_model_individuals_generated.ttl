archind:equflashv2_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "EquFlashV2"^^xsd:string ;
    arch:hasVariant archind:equflashv2_45m_oam_uip_model_variant,
        archind:equflashv2_45m_oam_variant .

evalind:equflashv2_45m_oam_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "equflashv2_45m_oam_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:equflashv2_45m_oam_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:equflashv2_45m_oam_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

