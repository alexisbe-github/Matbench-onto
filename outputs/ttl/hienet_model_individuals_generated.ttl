trind:hienet_mptrj_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "hienet_mptrj_pretraining"^^xsd:string ;
    rdfs:comment "HIENet trained on MPtrj dataset for 250 epochs using AdamW optimizer with cosine annealing learning rate schedule. Loss combines energy, force, and stress Huber losses with weights 1.0, 1.0, and 0.01."^^xsd:string ;
    train:hasHyperparameterValue trind:hienet_mptrj_pretraining_activation_gate_value,
        trind:hienet_mptrj_pretraining_activation_scalar_value,
        trind:hienet_mptrj_pretraining_ase_optimizer_value,
        trind:hienet_mptrj_pretraining_batch_size_value,
        trind:hienet_mptrj_pretraining_cell_filter_value,
        trind:hienet_mptrj_pretraining_conv_denominator_value,
        trind:hienet_mptrj_pretraining_cutoff_function_value,
        trind:hienet_mptrj_pretraining_dropout_attention_value,
        trind:hienet_mptrj_pretraining_dropout_value,
        trind:hienet_mptrj_pretraining_ema_decay_value,
        trind:hienet_mptrj_pretraining_epochs_value,
        trind:hienet_mptrj_pretraining_forces_rms_scale_value,
        trind:hienet_mptrj_pretraining_graph_construction_radius_value,
        trind:hienet_mptrj_pretraining_initial_learning_rate_value,
        trind:hienet_mptrj_pretraining_irreps_value,
        trind:hienet_mptrj_pretraining_learning_rate_schedule_value,
        trind:hienet_mptrj_pretraining_lmax_value,
        trind:hienet_mptrj_pretraining_loss_value,
        trind:hienet_mptrj_pretraining_max_force_value,
        trind:hienet_mptrj_pretraining_max_neighbors_value,
        trind:hienet_mptrj_pretraining_max_steps_value,
        trind:hienet_mptrj_pretraining_n_radial_bessel_basis_value,
        trind:hienet_mptrj_pretraining_num_invariant_conv_value,
        trind:hienet_mptrj_pretraining_optimizer_value,
        trind:hienet_mptrj_pretraining_radial_basis_value,
        trind:hienet_mptrj_pretraining_weight_decay_value ;
    train:trainsModelVariant archind:hienet_hienet_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:huber_loss ;
    train:usesObjectiveFunction trind:huber_loss ;
    train:usesOptimizer trind:adamw .

