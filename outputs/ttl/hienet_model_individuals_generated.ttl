    eval:producesBenchmarkResult evalind:hienet_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:hienet_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "hienet"^^xsd:string ;
    train:generatedBy trind:hienet_mptrj_pretraining .

archind:hienet_e_3_invariant_message_passing_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "E(3) Invariant Message Passing Layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:hienet_e_3_invariant_message_passing_layer_component_configuration .

archind:hienet_e_3_invariant_message_passing_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "E(3) Invariant Message Passing Layer component configuration"^^xsd:string .

archind:hienet_hienet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "HIENet architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 512 ;
    arch:hasLayerCount 4 .

archind:hienet_o_3_equivariant_message_passing_layer_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "O(3) Equivariant Message Passing Layer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:hienet_o_3_equivariant_message_passing_layer_component_configuration .

archind:hienet_o_3_equivariant_message_passing_layer_component_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "O(3) Equivariant Message Passing Layer component configuration"^^xsd:string .

