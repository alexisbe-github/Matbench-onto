trind:hienet_mptrj_training a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "hienet_mptrj_training"^^xsd:string ;
    rdfs:comment "HIENet was trained on the MPtrj dataset (1.58M crystal structures) with a 95%/5% train/validation split for 250 epochs using the AdamW optimizer with cosine annealing learning rate schedule. The loss function combines Huber losses for energy, force, and stress predictions with weights λE=1.0, λF=1.0, λσ=0.01. An exponential moving average (EMA) of model parameters with decay 0.999 was maintained."^^xsd:string ;
    train:hasHyperparameterValue trind:hienet_hienet_attention_dropout_rate_value,
        trind:hienet_hienet_batch_size_value,
        trind:hienet_hienet_dropout_rate_value,
        trind:hienet_hienet_ema_decay_value,
        trind:hienet_hienet_energy_loss_weight_value,
        trind:hienet_hienet_force_loss_weight_value,
        trind:hienet_hienet_huber_delta_value,
        trind:hienet_hienet_learning_rate_scheduler_value,
        trind:hienet_hienet_learning_rate_value,
        trind:hienet_hienet_max_learning_rate_value,
        trind:hienet_hienet_min_learning_rate_value,
        trind:hienet_hienet_number_of_epochs_value,
        trind:hienet_hienet_optimizer_value,
        trind:hienet_hienet_stress_loss_weight_value,
        trind:hienet_hienet_warmup_epochs_value,
        trind:hienet_hienet_warmup_factor_value,
        trind:hienet_hienet_weight_decay_value ;
    train:trainsModelVariant archind:hienet_hienet_model_variant ;
    train:usesDataset dataind:mptrj ;
    train:usesLoss trind:huberloss ;
    train:usesObjectiveFunction trind:huberloss ;
    train:usesOptimizer trind:adamw .

