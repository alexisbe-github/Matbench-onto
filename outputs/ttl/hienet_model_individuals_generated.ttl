<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_family> <https://k.loria.fr/ontologies/architectureonto#hasVariant> <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_variant> >> prov:wasDerivedFrom "YAML model_key: hienet" ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_variant> <https://k.loria.fr/ontologies/architectureonto#hasParameterNumber> "7510280"^^<http://www.w3.org/2001/XMLSchema#integer> >> prov:wasDerivedFrom "YAML model_params: 7510280" ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_family> <https://k.loria.fr/ontologies/architectureonto#hasVariant> <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_model_variant> >> prov:wasDerivedFrom "HIENet is described as a graph neural network interatomic potential combining invariant and equivariant message passing layers. Ontology: MessagePassingNeuralNetworkArchitecture is a subclass of GraphNeuralNetworkArchitecture." ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_model_variant> <https://k.loria.fr/ontologies/architectureonto#hasMachineLearningArchitecture> <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> >> prov:wasDerivedFrom "HIENet is described as a graph neural network interatomic potential combining invariant and equivariant message passing layers. Ontology: MessagePassingNeuralNetworkArchitecture is a subclass of GraphNeuralNetworkArchitecture." ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture> <https://k.loria.fr/ontologies/architectureonto#hasParameterNumber> "7510280"^^<http://www.w3.org/2001/XMLSchema#integer> >> prov:wasDerivedFrom "YAML model_params: 7510280. PDF Table 5 also lists HIENet as 7,860,155 parameters; YAML value 7,510,280 is used as the primary source." ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
<< <https://k.loria.fr/ontologies/architectureonto-individuals#hienet_hienet_architecture_configuration> <https://k.loria.fr/ontologies/architectureonto#hasLayerCount> "4"^^<http://www.w3.org/2001/XMLSchema#integer> >> prov:wasDerivedFrom "PDF Sec F.1: 'HIENet consists of 1 invariant and 3 equivariant message passing layers.' Total = 4 layers." ; dcterms:source <https://arxiv.org/pdf/2503.05771> .
