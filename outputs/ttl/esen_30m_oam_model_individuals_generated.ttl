trind:esen_30m_omat_materialization a owl:NamedIndividual,
        train:Checkpoint,
        train:ModelMaterialization ;
    rdfs:label "eSEN-30M-OMat"^^xsd:string ;
    train:generatedBy trind:omat24_pretraining .

trind:oam_finetuning a owl:NamedIndividual,
        train:MachineLearningFinetuningRun ;
    rdfs:label "oam_finetuning"^^xsd:string ;
    rdfs:comment "Conservative fine-tuning for 1 epoch on combined sAlex + 8x MPTrj from eSEN-30M-OMat checkpoint"^^xsd:string ;
    train:hasHyperparameterValue trind:oam_finetuning_ase_optimizer_value,
        trind:oam_finetuning_batch_size_value,
        trind:oam_finetuning_cell_filter_value,
        trind:oam_finetuning_cutoff_radius_value,
        trind:oam_finetuning_ema_decay_value,
        trind:oam_finetuning_energy_loss_coefficient_value,
        trind:oam_finetuning_force_loss_coefficient_value,
        trind:oam_finetuning_gradient_clipping_norm_value,
        trind:oam_finetuning_graph_construction_radius_value,
        trind:oam_finetuning_learning_rate_value,
        trind:oam_finetuning_max_degree_value,
        trind:oam_finetuning_max_force_value,
        trind:oam_finetuning_max_neighbors_value,
        trind:oam_finetuning_max_order_value,
        trind:oam_finetuning_max_steps_value,
        trind:oam_finetuning_num_channels_value,
        trind:oam_finetuning_num_layers_value,
        trind:oam_finetuning_num_radial_basis_value,
        trind:oam_finetuning_optimizer_value,
        trind:oam_finetuning_radial_basis_type_value,
        trind:oam_finetuning_stress_loss_coefficient_value,
        trind:oam_finetuning_warmup_epochs_value,
        trind:oam_finetuning_weight_decay_value ;
    train:initializedFromModelMaterialization trind:esen_30m_omat_materialization ;
    train:trainsModelVariant archind:esen_30m_oam_esen_model_variant ;
    train:usesDataset dataind:mptrj,
        dataind:salex ;
    train:usesOptimizer trind:adamw .

