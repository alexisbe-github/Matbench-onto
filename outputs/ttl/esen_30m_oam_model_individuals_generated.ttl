archind:esen_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "eSEN"^^xsd:string ;
    arch:hasVariant archind:esen_30m_oam_esen_model_variant,
        archind:esen_30m_oam_variant .

evalind:esen_30m_oam_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "esen_30m_oam_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:esen_30m_oam_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:esen_30m_oam_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:esen_30m_oam_matbench_discovery_phonon_thermal_conductivity_contribution_evaluation_run a owl:NamedIndividual,
