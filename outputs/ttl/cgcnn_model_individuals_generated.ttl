    rdfs:label "cgcnn_pretraining regularization_term value"^^xsd:string ;
    train:ofHyperparameter trind:regularization_term .

trind:cgcnn_pretraining_scaling_factor_of_gaussian_initialization_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining scaling_factor_of_gaussian_initialization value"^^xsd:string ;
