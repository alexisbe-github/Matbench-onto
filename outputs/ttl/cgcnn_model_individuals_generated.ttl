@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:cgcnn_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "CGCNN"^^xsd:string ;
    arch:hasVariant archind:cgcnn_cgcnn_model_variant,
        archind:cgcnn_variant .

dataind:mp_2022 a owl:NamedIndividual,
        data:LabeledDataset,
        train:TrainingDataset ;
    rdfs:label "MP 2022"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:usesAttributeAsInputFeature dataind:atom_distance_attribute,
        dataind:atomic_volume_attribute,
        dataind:block_attribute,
        dataind:covalent_radius_attribute,
        dataind:electron_affinity_attribute,
        dataind:electronegativity_attribute,
        dataind:first_ionization_energy_attribute,
        dataind:group_number_attribute,
        dataind:period_number_attribute,
        dataind:valence_electrons_attribute ;
    data:usesAttributeAsTargetFeature dataind:e_attribute .

dataind:perovskite_database a owl:NamedIndividual,
        data:Dataset,
        data:LabeledDataset,
        train:TrainingDataset ;
    rdfs:label "Perovskite database"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 18928 ;
    data:usesAttributeAsInputFeature dataind:atom_distance_attribute,
        dataind:atomic_volume_attribute,
        dataind:block_attribute,
        dataind:covalent_radius_attribute,
        dataind:electron_affinity_attribute,
        dataind:electronegativity_attribute,
        dataind:first_ionization_energy_attribute,
        dataind:group_number_attribute,
        dataind:period_number_attribute,
        dataind:valence_electrons_attribute ;
    data:usesAttributeAsTargetFeature dataind:energy_above_hull_attribute .

evalind:cgcnn_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "cgcnn_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:cgcnn_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:cgcnn_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:cgcnn_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "cgcnn_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:cgcnn_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:cgcnn_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:full_test_set_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "full_test_set"^^xsd:string ;
    eval:hasTestSplit dataind:full_test_set .

evalind:most_stable_10k_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "most_stable_10k"^^xsd:string ;
    eval:hasTestSplit dataind:most_stable_10k .

evalind:unique_prototypes_fold a owl:NamedIndividual,
        eval:Fold ;
    rdfs:label "unique_prototypes"^^xsd:string ;
    eval:hasTestSplit dataind:unique_prototypes .

trind:cgcnn_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "cgcnn"^^xsd:string ;
    train:generatedBy trind:cgcnn_pretraining .

archind:cgcnn_cgcnn_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "cgcnn architecture configuration"^^xsd:string .

archind:cgcnn_convolutional_layers_component a owl:NamedIndividual,
        arch:MachineLearningArchitecture ;
    rdfs:label "convolutional_layers"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_convolutional_layers_component_configuration .

