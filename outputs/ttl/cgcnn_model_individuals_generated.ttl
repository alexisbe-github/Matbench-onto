trind:adam a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "Adam"^^xsd:string .

trind:cgcnn_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "cgcnn_pretraining"^^xsd:string ;
    rdfs:comment "CGCNN trained on Materials Project DFT data for formation energy and other property prediction using crystal graph representation"^^xsd:string ;
    train:hasHyperparameterValue trind:cgcnn_pretraining_dropout_fraction_value,
        trind:cgcnn_pretraining_graph_construction_radius_value,
        trind:cgcnn_pretraining_length_of_learned_atom_feature_vector_value,
        trind:cgcnn_pretraining_max_neighbors_value,
        trind:cgcnn_pretraining_number_of_convolutional_layers_value,
        trind:cgcnn_pretraining_number_of_hidden_layers_l1_value,
        trind:cgcnn_pretraining_number_of_hidden_layers_l2_value,
        trind:cgcnn_pretraining_regularization_term_value,
        trind:cgcnn_pretraining_scaling_factor_of_gaussian_initialization_value,
        trind:cgcnn_pretraining_step_size_value ;
    train:trainsModelVariant archind:cgcnn_cgcnn_model_variant ;
    train:usesDataset dataind:materials_project ;
    train:usesOptimizer trind:adam .

trind:cgcnn_pretraining_dropout_fraction_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining dropout_fraction value"^^xsd:string ;
    train:ofHyperparameter trind:dropout_fraction .

trind:cgcnn_pretraining_graph_construction_radius_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining graph_construction_radius value"^^xsd:string ;
    prov:value "5.0"^^xsd:float ;
    train:ofHyperparameter trind:graph_construction_radius .

trind:cgcnn_pretraining_length_of_learned_atom_feature_vector_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining length_of_learned_atom_feature_vector value"^^xsd:string ;
    train:ofHyperparameter trind:length_of_learned_atom_feature_vector .

trind:cgcnn_pretraining_max_neighbors_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining max_neighbors value"^^xsd:string ;
    prov:value "INF"^^xsd:float ;
    train:ofHyperparameter trind:max_neighbors .

trind:cgcnn_pretraining_number_of_convolutional_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "cgcnn_pretraining number_of_convolutional_layers value"^^xsd:string ;
    train:ofHyperparameter trind:number_of_convolutional_layers .

trind:cgcnn_pretraining_number_of_hidden_layers_l1_value a owl:NamedIndividual,
