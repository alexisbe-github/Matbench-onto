archind:cgcnn_cgcnn_architecture a owl:NamedIndividual,
        arch:GraphConvolutionArchitecture ;
    rdfs:label "cgcnn"^^xsd:string ;
    arch:hasComponent archind:cgcnn_convolutional_layers_component,
        archind:cgcnn_hidden_layers_component,
        archind:cgcnn_output_layer_component,
        archind:cgcnn_pooling_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:cgcnn_cgcnn_architecture_configuration ;
    arch:hasParameterNumber 128450 .

archind:cgcnn_cgcnn_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "cgcnn cgcnn"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:cgcnn_cgcnn_architecture .

evalind:matbench_discovery_benchmark_release a owl:NamedIndividual,
        eval:BenchmarkRelease ;
    rdfs:label "matbench_discovery_benchmark_release"^^xsd:string ;
    eval:hasTask evalind:convex_hull_distance_regression_task,
        evalind:thermodynamic_stability_classification_task .

archind:cgcnn_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "cgcnn"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/1710.10324.pdf> ;
    prov:wasDerivedFrom <https://arxiv.org/pdf/1710.10324.pdf> ;
    arch:hasMachineLearningArchitecture archind:cgcnn_cgcnn_architecture ;
    arch:hasParameterNumber 128450 .

