@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eval: <https://k.loria.fr/ontologies/evaluationonto#> .
@prefix evalind: <https://k.loria.fr/ontologies/evaluationonto-individuals#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:transformer_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "Transformer"^^xsd:string ;
    arch:hasVariant archind:wrenformer_transformer_model_variant,
        archind:wrenformer_variant .

evalind:wrenformer_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "wrenformer_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:wrenformer_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:wrenformer_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:wrenformer_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "wrenformer_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:wrenformer_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:wrenformer_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:pretraining_run a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pretraining_run"^^xsd:string ;
    rdfs:comment "Pretraining of Wren model on Materials Project and WBM datasets using AdamW optimizer with robust L1 loss function for predicting formation energies of inorganic crystalline materials"^^xsd:string ;
    train:hasHyperparameterValue trind:pretraining_run_attention_heads_value,
        trind:pretraining_run_batch_size_value,
        trind:pretraining_run_epochs_value,
        trind:pretraining_run_hidden_units_value,
        trind:pretraining_run_learning_rate_value,
        trind:pretraining_run_message_passing_layers_value,
        trind:pretraining_run_weight_decay_value ;
    train:trainsModelVariant archind:wrenformer_transformer_model_variant ;
    train:usesDataset dataind:materials_project,
        dataind:wbm ;
    train:usesLoss trind:robust_l1_loss ;
    train:usesOptimizer trind:adamw .

trind:prospective_validation_run a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "prospective_validation_run"^^xsd:string ;
    rdfs:comment "Prospective validation run for discovering new theoretically stable materials using Wren model trained on union of MP and WBM datasets, identifying 1,569 new materials below the known convex hull from 5,675 ab-initio calculations"^^xsd:string ;
    train:hasHyperparameterValue trind:prospective_validation_run_attention_heads_value,
        trind:prospective_validation_run_batch_size_value,
        trind:prospective_validation_run_epochs_value,
        trind:prospective_validation_run_hidden_units_value,
        trind:prospective_validation_run_learning_rate_value,
        trind:prospective_validation_run_message_passing_layers_value,
        trind:prospective_validation_run_weight_decay_value ;
    train:trainsModelVariant archind:wrenformer_transformer_model_variant ;
    train:usesDataset dataind:materials_project,
        dataind:wbm ;
    train:usesLoss trind:robust_l1_loss ;
    train:usesOptimizer trind:adamw .

archind:wrenformer_transformer_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Transformer architecture configuration"^^xsd:string .

evalind:wrenformer_matbench_discovery_convex_hull_distance_regression_benchmark_result a owl:NamedIndividual,
        eval:BenchmarkResult ;
    rdfs:label "wrenformer_matbench_discovery_convex_hull_distance_regression benchmark result"^^xsd:string ;
    eval:hasMetricResult evalind:wrenformer_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_mae_metric_result,
        evalind:wrenformer_matbench_discovery_convex_hull_distance_regression_discovery_full_test_set_missing_preds_metric_result,
