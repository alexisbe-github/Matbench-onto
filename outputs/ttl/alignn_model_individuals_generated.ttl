        train:MachineLearningHyperparameter ;
    rdfs:label "alignn_layers"^^xsd:string .

trind:alignn_pretraining a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "alignn_pretraining"^^xsd:string ;
    rdfs:comment "ALIGNN model trained on MP 2022 dataset for formation energy prediction using RS2RE task"^^xsd:string ;
    train:hasHyperparameterValue trind:alignn_pretraining_activation_function_value,
        trind:alignn_pretraining_alignn_layers_value,
        trind:alignn_pretraining_batch_size_value,
        trind:alignn_pretraining_edge_input_features_value,
        trind:alignn_pretraining_embedding_features_value,
        trind:alignn_pretraining_epochs_value,
        trind:alignn_pretraining_gcn_layers_value,
        trind:alignn_pretraining_graph_construction_radius_value,
        trind:alignn_pretraining_hidden_features_value,
        trind:alignn_pretraining_learning_rate_value,
        trind:alignn_pretraining_max_neighbors_value,
        trind:alignn_pretraining_normalization_value,
        trind:alignn_pretraining_triplet_input_features_value,
        trind:alignn_pretraining_weight_decay_value ;
    train:trainsModelVariant archind:alignn_alignn_model_variant ;
    train:usesDataset dataind:mp_2022 ;
    train:usesLoss trind:mean_squared_error ;
    train:usesObjectiveFunction trind:mean_squared_error ;
    train:usesOptimizer trind:adamw .

trind:alignn_pretraining_activation_function_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining activation_function value"^^xsd:string ;
    prov:value "SiLU"^^xsd:string ;
    train:ofHyperparameter trind:activation_function .

trind:alignn_pretraining_alignn_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining alignn_layers value"^^xsd:string ;
    prov:value 4 ;
    train:ofHyperparameter trind:alignn_layers .

trind:alignn_pretraining_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining batch_size value"^^xsd:string ;
    prov:value 64 ;
    train:ofHyperparameter trind:batch_size .

trind:alignn_pretraining_edge_input_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining edge_input_features value"^^xsd:string ;
    prov:value 80 ;
    train:ofHyperparameter trind:edge_input_features .

trind:alignn_pretraining_embedding_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining embedding_features value"^^xsd:string ;
    prov:value 64 ;
    train:ofHyperparameter trind:embedding_features .

trind:alignn_pretraining_epochs_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining epochs value"^^xsd:string ;
    prov:value 300 ;
    train:ofHyperparameter trind:epochs .

trind:alignn_pretraining_gcn_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining gcn_layers value"^^xsd:string ;
    prov:value 4 ;
    train:ofHyperparameter trind:gcn_layers .

trind:alignn_pretraining_graph_construction_radius_value a owl:NamedIndividual,
