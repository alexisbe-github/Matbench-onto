trind:alignn_pretraining_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn_pretraining learning_rate value"^^xsd:string ;
    prov:value "0.001"^^xsd:float ;
