archind:alignn_alignn_architecture a owl:NamedIndividual,
        arch:GraphNeuralNetworkArchitecture ;
    rdfs:label "ALIGNN"^^xsd:string ;
    arch:hasBackboneArchitecture archind:alignn_atomistic_line_graph_neural_network_component ;
    arch:hasComponent archind:alignn_edge_gated_graph_convolution_component,
        archind:alignn_fully_connected_layer_component,
        archind:alignn_global_average_pooling_component,
        archind:alignn_line_graph_convolution_component ;
    arch:hasHeadArchitecture archind:alignn_fully_connected_regression_or_classification_layer_component ;
    arch:hasMachineLearningArchitectureConfiguration archind:alignn_alignn_architecture_configuration ;
    arch:hasParameterNumber 4026753 .

archind:alignn_alignn_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "alignn ALIGNN"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:alignn_alignn_architecture .

