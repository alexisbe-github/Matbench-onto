@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:alignn_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ALIGNN"^^xsd:string ;
    arch:hasVariant archind:alignn_atomistic_line_graph_neural_network_model_variant,
        archind:alignn_variant .

trind:pretraining_run a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pretraining_run"^^xsd:string ;
    rdfs:comment "ALIGNN models trained for 300 epochs using AdamW optimizer with one-cycle learning rate policy, batch size 64, on JARVIS-DFT, Materials Project, and QM9 datasets for various solid-state and molecular property prediction tasks."^^xsd:string ;
    train:trainsModelVariant archind:alignn_atomistic_line_graph_neural_network_model_variant ;
    train:usesDataset dataind:jarvis_dft,
        dataind:materials_project,
        dataind:qm9 ;
    train:usesLoss trind:mean_squared_error ;
    train:usesOptimizer trind:adamw .

archind:alignn_atomistic_line_graph_neural_network_architecture a owl:NamedIndividual,
        arch:EquivariantMessagePassingNeuralNetworkArchitecture ;
    rdfs:label "Atomistic Line Graph Neural Network"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:alignn_atomistic_line_graph_neural_network_architecture_configuration ;
    arch:hasParameterNumber 4026753 ;
    train:usesDataset dataind:jarvis_dft,
        dataind:materials_project,
        dataind:qm9 .

archind:alignn_atomistic_line_graph_neural_network_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Atomistic Line Graph Neural Network architecture configuration"^^xsd:string ;
    train:hasHyperparameterValue trind:alignn_atomistic_line_graph_neural_network_alignn_layers_value,
        trind:alignn_atomistic_line_graph_neural_network_batch_size_value,
        trind:alignn_atomistic_line_graph_neural_network_edge_input_features_value,
        trind:alignn_atomistic_line_graph_neural_network_embedding_features_value,
        trind:alignn_atomistic_line_graph_neural_network_gcn_layers_value,
        trind:alignn_atomistic_line_graph_neural_network_hidden_features_value,
        trind:alignn_atomistic_line_graph_neural_network_learning_rate_value,
        trind:alignn_atomistic_line_graph_neural_network_normalization_value,
        trind:alignn_atomistic_line_graph_neural_network_triplet_input_features_value .

archind:alignn_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "alignn"^^xsd:string ;
    dcterms:source <https://arxiv.org/pdf/2106.01829.pdf> ;
    prov:wasDerivedFrom "C:\\Users\\user\\Desktop\\Matbench-onto\\model_yamls\\alignn.yml" ;
    arch:hasParameterNumber 4026753 .

trind:adamw a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "AdamW"^^xsd:string .

trind:alignn_atomistic_line_graph_neural_network_alignn_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network ALIGNN layers value"^^xsd:string ;
    prov:value 4 ;
    train:ofHyperparameter trind:alignn_layers .

trind:alignn_atomistic_line_graph_neural_network_batch_size_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Batch size value"^^xsd:string ;
    prov:value 64 ;
    train:ofHyperparameter trind:batch_size .

trind:alignn_atomistic_line_graph_neural_network_edge_input_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Edge input features value"^^xsd:string ;
    prov:value 80 ;
    train:ofHyperparameter trind:edge_input_features .

trind:alignn_atomistic_line_graph_neural_network_embedding_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Embedding features value"^^xsd:string ;
    prov:value 64 ;
    train:ofHyperparameter trind:embedding_features .

trind:alignn_atomistic_line_graph_neural_network_gcn_layers_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network GCN layers value"^^xsd:string ;
    prov:value 4 ;
    train:ofHyperparameter trind:gcn_layers .

trind:alignn_atomistic_line_graph_neural_network_hidden_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Hidden features value"^^xsd:string ;
    prov:value 256 ;
    train:ofHyperparameter trind:hidden_features .

trind:alignn_atomistic_line_graph_neural_network_learning_rate_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Learning rate value"^^xsd:string ;
    prov:value "0.001"^^xsd:float ;
    train:ofHyperparameter trind:learning_rate .

trind:alignn_atomistic_line_graph_neural_network_normalization_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Normalization value"^^xsd:string ;
    prov:value "Batch normalization"^^xsd:string ;
    train:ofHyperparameter trind:normalization .

trind:alignn_atomistic_line_graph_neural_network_triplet_input_features_value a owl:NamedIndividual,
        train:MachineLearningHyperparameterValue ;
    rdfs:label "alignn Atomistic Line Graph Neural Network Triplet input features value"^^xsd:string ;
    prov:value 40 ;
    train:ofHyperparameter trind:triplet_input_features .

trind:alignn_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "ALIGNN layers"^^xsd:string .

trind:batch_size a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Batch size"^^xsd:string .

trind:edge_input_features a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Edge input features"^^xsd:string .

trind:embedding_features a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Embedding features"^^xsd:string .

trind:gcn_layers a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "GCN layers"^^xsd:string .

trind:hidden_features a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Hidden features"^^xsd:string .

trind:learning_rate a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Learning rate"^^xsd:string .

trind:mean_squared_error a owl:NamedIndividual,
        train:LossFunction ;
    rdfs:label "Mean Squared Error"^^xsd:string .

trind:normalization a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Normalization"^^xsd:string .

trind:triplet_input_features a owl:NamedIndividual,
        train:MachineLearningHyperparameter ;
    rdfs:label "Triplet input features"^^xsd:string .

archind:alignn_atomistic_line_graph_neural_network_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "alignn Atomistic Line Graph Neural Network"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:alignn_atomistic_line_graph_neural_network_architecture .

dataind:jarvis_dft a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "JARVIS-DFT"^^xsd:string .

dataind:materials_project a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials Project"^^xsd:string .

dataind:qm9 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "QM9"^^xsd:string .



