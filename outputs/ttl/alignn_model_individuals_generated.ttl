@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:alignn_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "ALIGNN"^^xsd:string ;
    arch:hasVariant archind:alignn_alignn_model_variant,
        archind:alignn_variant .

dataind:jarvis_dft a owl:NamedIndividual,
        train:TrainingDataset ;
    rdfs:label "JARVIS-DFT"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 55722 ;
    data:usesAttributeAsInputFeature dataind:atomic_volume_attribute,
        dataind:block_attribute,
        dataind:covalent_radius_attribute,
        dataind:electron_affinity_attribute,
        dataind:electronegativity_attribute,
        dataind:first_ionization_energy_attribute,
        dataind:group_number_attribute,
        dataind:interatomic_bond_distances_attribute,
        dataind:valence_electrons_attribute ;
    data:usesAttributeAsTargetFeature dataind:bandgap_attribute,
        dataind:bulk_modulus_attribute,
        dataind:convex_hull_distance_attribute,
        dataind:dielectric_constant_attribute,
        dataind:formation_energy_attribute,
        dataind:magnetic_moment_attribute,
        dataind:piezoelectric_coefficients_attribute,
        dataind:power_factor_attribute,
        dataind:seebeck_coefficient_attribute,
        dataind:shear_modulus_attribute,
        dataind:total_energy_attribute .

dataind:mp_2018_6_1 a owl:NamedIndividual,
        train:TrainingDataset ;
    rdfs:label "MP 2018.6.1"^^xsd:string ;
    data:hasDataRepresentation dataind:crystal_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 69239 ;
    data:usesAttributeAsInputFeature dataind:atomic_volume_attribute,
        dataind:block_attribute,
        dataind:covalent_radius_attribute,
        dataind:electron_affinity_attribute,
        dataind:electronegativity_attribute,
        dataind:first_ionization_energy_attribute,
        dataind:group_number_attribute,
        dataind:interatomic_bond_distances_attribute,
        dataind:valence_electrons_attribute ;
    data:usesAttributeAsTargetFeature dataind:bandgap_attribute,
        dataind:formation_energy_attribute .

dataind:qm9 a owl:NamedIndividual,
        train:TrainingDataset ;
    rdfs:label "QM9"^^xsd:string ;
    data:hasDataRepresentation dataind:molecule_graph_representation ;
    data:hasLabellingMethod dataind:dft_labelling_method ;
    data:hasNumberOfSamples 130829 ;
    data:usesAttributeAsInputFeature dataind:atomic_volume_attribute,
        dataind:block_attribute,
        dataind:covalent_radius_attribute,
        dataind:electron_affinity_attribute,
        dataind:electronegativity_attribute,
        dataind:first_ionization_energy_attribute,
        dataind:group_number_attribute,
        dataind:interatomic_bond_distances_attribute,
        dataind:valence_electrons_attribute ;
    data:usesAttributeAsTargetFeature dataind:dipole_moment_attribute,
        dataind:energy_gap_attribute,
        dataind:homo_attribute,
        dataind:internal_energy_attribute,
        dataind:isotropic_polarizability_attribute,
        dataind:lumo_attribute,
        dataind:zpve_attribute .

evalind:alignn_matbench_discovery_convex_hull_distance_regression_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "alignn_matbench_discovery_convex_hull_distance_regression"^^xsd:string ;
    eval:evaluatesModelVariant archind:alignn_variant ;
    eval:evaluatesTask evalind:convex_hull_distance_regression_task ;
    eval:producesBenchmarkResult evalind:alignn_matbench_discovery_convex_hull_distance_regression_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

evalind:alignn_matbench_discovery_thermodynamic_stability_classification_evaluation_run a owl:NamedIndividual,
        eval:MachineLearningEvaluationRun ;
    rdfs:label "alignn_matbench_discovery_thermodynamic_stability_classification"^^xsd:string ;
    eval:evaluatesModelVariant archind:alignn_variant ;
    eval:evaluatesTask evalind:thermodynamic_stability_classification_task ;
    eval:producesBenchmarkResult evalind:alignn_matbench_discovery_thermodynamic_stability_classification_benchmark_result ;
    eval:usesBenchmarkRelease evalind:matbench_discovery_benchmark_release .

trind:alignn_mp22_materialization a owl:NamedIndividual,
        train:Checkpoint ;
    rdfs:label "alignn-mp22"^^xsd:string ;
    train:generatedBy trind:alignn_pretraining .

archind:alignn_alignn_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "ALIGNN architecture configuration"^^xsd:string ;
    arch:hasHiddenDimension 256 ;
    arch:hasLayerCount 8 .

