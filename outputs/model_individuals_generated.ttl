@prefix arch: <https://k.loria.fr/ontologies/architectureonto#> .
@prefix archind: <https://k.loria.fr/ontologies/architectureonto-individuals#> .
@prefix data: <https://k.loria.fr/ontologies/datasetonto#> .
@prefix dataind: <https://k.loria.fr/ontologies/dataset-individuals#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix train: <https://k.loria.fr/ontologies/trainingonto#> .
@prefix trind: <https://k.loria.fr/ontologies/trainingonto-individuals#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

archind:mattersim_family a owl:NamedIndividual,
        arch:ModelFamily ;
    rdfs:label "MatterSim"^^xsd:string ;
    arch:hasVariant archind:mattersim_v1_5m_graphormer_model_variant,
        archind:mattersim_v1_5m_m3gnet_model_variant,
        archind:mattersim_v1_5m_variant .

trind:pretraining_run a owl:NamedIndividual,
        train:PretrainingRun ;
    rdfs:label "pretraining_run"^^xsd:string ;
    rdfs:comment "Pretraining of MatterSim models (M3GNet and Graphormer) on large-scale first-principles computations using active learning from a curated dataset of approximately 17M structures labeled with GGA-PBE level of theory with Hubbard U correction."^^xsd:string ;
    train:trainsModelVariant archind:mattersim_v1_5m_graphormer_model_variant,
        archind:mattersim_v1_5m_m3gnet_model_variant ;
    train:usesDataset dataind:alexandria,
        dataind:in_house_generated_dataset,
        dataind:materials_project,
        dataind:mpf2021,
        dataind:mptrj ;
    train:usesLoss trind:huber_loss ;
    train:usesOptimizer trind:adam_m3gnet_adamw_graphormer .

archind:mattersim_v1_5m_graphormer_architecture a owl:NamedIndividual,
        arch:GraphTransformerArchitecture ;
    rdfs:label "Graphormer"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:mattersim_v1_5m_graphormer_architecture_configuration ;
    arch:hasParameterNumber 182000000 ;
    train:usesDataset dataind:alexandria,
        dataind:in_house_generated_dataset,
        dataind:materials_project,
        dataind:mpf2021,
        dataind:mptrj .

archind:mattersim_v1_5m_graphormer_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "Graphormer architecture configuration"^^xsd:string .

archind:mattersim_v1_5m_m3gnet_architecture a owl:NamedIndividual,
        arch:MessagePassingNeuralNetworkArchitecture ;
    rdfs:label "M3GNet"^^xsd:string ;
    arch:hasMachineLearningArchitectureConfiguration archind:mattersim_v1_5m_m3gnet_architecture_configuration ;
    arch:hasParameterNumber 4549142 ;
    train:usesDataset dataind:alexandria,
        dataind:in_house_generated_dataset,
        dataind:materials_project,
        dataind:mpf2021,
        dataind:mptrj .

archind:mattersim_v1_5m_m3gnet_architecture_configuration a owl:NamedIndividual,
        arch:MachineLearningArchitectureConfiguration ;
    rdfs:label "M3GNet architecture configuration"^^xsd:string .

archind:mattersim_v1_5m_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "mattersim_v1_5M"^^xsd:string ;
    arch:hasParameterNumber 4549142 .

trind:adam_m3gnet_adamw_graphormer a owl:NamedIndividual,
        train:Optimizer ;
    rdfs:label "Adam (M3GNet), AdamW (Graphormer)"^^xsd:string .

trind:huber_loss a owl:NamedIndividual,
        train:LossFunction ;
    rdfs:label "Huber loss"^^xsd:string .

archind:mattersim_v1_5m_graphormer_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "mattersim_v1_5M Graphormer"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:mattersim_v1_5m_graphormer_architecture .

archind:mattersim_v1_5m_m3gnet_model_variant a owl:NamedIndividual,
        arch:ModelVariant ;
    rdfs:label "mattersim_v1_5M M3GNet"^^xsd:string ;
    arch:hasMachineLearningArchitecture archind:mattersim_v1_5m_m3gnet_architecture .

dataind:alexandria a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Alexandria"^^xsd:string .

dataind:in_house_generated_dataset a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "in-house generated dataset"^^xsd:string .

dataind:materials_project a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "Materials Project"^^xsd:string .

dataind:mpf2021 a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MPF2021"^^xsd:string .

dataind:mptrj a owl:NamedIndividual,
        data:Dataset ;
    rdfs:label "MPtrj"^^xsd:string .



