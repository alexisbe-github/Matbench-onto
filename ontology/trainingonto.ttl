#################################################################

###  https://k.loria.fr/ontologies/trainingonto#usesBatchedSelection
:usesBatchedSelection rdf:type owl:DatatypeProperty ;
                      rdfs:domain :MachineLearningActiveLearningRun ;
                      rdfs:range xsd:boolean .


