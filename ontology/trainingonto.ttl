#################################################################

###  https://k.loria.fr/ontologies/trainingonto#generatedBy
:generatedBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf prov:wasGeneratedBy ;
             rdfs:domain :ModelMaterialization ;
             rdfs:range :MachineLearningTrainingRun .


###  https://k.loria.fr/ontologies/trainingonto#hasHyperparameterValue
:hasHyperparameterValue rdf:type owl:ObjectProperty ;
                        rdfs:domain :MachineLearningTrainingRun ;
                        rdfs:range :MachineLearningHyperparameterValue .


###  https://k.loria.fr/ontologies/trainingonto#hasStudentModel
:hasStudentModel rdf:type owl:ObjectProperty ;
                 rdfs:domain :MachineLearningDistillationRun ;
                 rdfs:range :ModelMaterialization .


###  https://k.loria.fr/ontologies/trainingonto#hasTeacherModel
:hasTeacherModel rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :MachineLearningDistillationRun ;
                 rdfs:range :ModelMaterialization .


###  https://k.loria.fr/ontologies/trainingonto#initializedFromModelMaterialization
:initializedFromModelMaterialization rdf:type owl:ObjectProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain :MachineLearningAdaptationRun ;
                                     rdfs:range :ModelMaterialization .


###  https://k.loria.fr/ontologies/trainingonto#ofHyperparameter
:ofHyperparameter rdf:type owl:ObjectProperty ;
                  rdfs:domain :MachineLearningHyperparameterValue ;
                  rdfs:range :MachineLearningHyperparameter .


###  https://k.loria.fr/ontologies/trainingonto#trainsModelVariant
:trainsModelVariant rdf:type owl:ObjectProperty ;
                    rdfs:domain :MachineLearningTrainingRun ;
                    rdfs:range <https://k.loria.fr/ontologies/architectureonto#ModelVariant> .


###  https://k.loria.fr/ontologies/trainingonto#usesDataset
:usesDataset rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf prov:used ;
             rdfs:domain :MachineLearningTrainingRun ;
             rdfs:range <https://k.loria.fr/ontologies/datasetonto#Dataset> .


###  https://k.loria.fr/ontologies/trainingonto#usesLoss
:usesLoss rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :usesObjectiveFunction ;
          rdfs:domain :MachineLearningTrainingRun ;
          rdfs:range :LossFunction .


###  https://k.loria.fr/ontologies/trainingonto#usesObjectiveFunction
:usesObjectiveFunction rdf:type owl:ObjectProperty ;
                       rdfs:domain :MachineLearningTrainingRun ;
                       rdfs:range :ObjectiveFunction .


###  https://k.loria.fr/ontologies/trainingonto#usesOptimizer
:usesOptimizer rdf:type owl:ObjectProperty ;
               rdfs:domain :MachineLearningTrainingRun ;
               rdfs:range :Optimizer .


###  https://k.loria.fr/ontologies/trainingonto#usesSamplingMethod
:usesSamplingMethod rdf:type owl:ObjectProperty ;
                    rdfs:domain :MachineLearningTrainingRun ;
                    rdfs:range :SamplingMethod .


#################################################################
