###  https://k.loria.fr/ontologies/evaluationonto-individuals#matbench_discovery_benchmark_release
:matbench_discovery_benchmark_release rdf:type owl:NamedIndividual ,
                                               eval:BenchmarkRelease ;
                                      eval:hasTask :convex_hull_distance_regression_task ,
                                                   :phonon_thermal_conductivity_contribution_task ,
                                                   :relaxed_structure_matching_rmsd_task ,
                                                   :thermodynamic_stability_classification_task ;
                                      rdfs:label "Matbench Discovery benchmark release" .


###  https://k.loria.fr/ontologies/evaluationonto-individuals#matbench_discovery_benchmark_suite
:matbench_discovery_benchmark_suite rdf:type owl:NamedIndividual ,
                                             eval:BenchmarkSuite ;
                                    eval:hasBenchmarkRelease :matbench_discovery_benchmark_release ;
                                    rdfs:label "Matbench Discovery" .


###  https://k.loria.fr/ontologies/evaluationonto-individuals#missing_preds_metric_type
:missing_preds_metric_type rdf:type owl:NamedIndividual ,
                                    eval:MetricType ;
                           rdfs:label "Missing predictions" .


###  https://k.loria.fr/ontologies/evaluationonto-individuals#n_structures_metric_type
