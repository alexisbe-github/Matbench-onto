#################################################################
#    Individuals
#################################################################

###  https://k.loria.fr/ontologies/evaluationonto-individuals#accuracy_metric_type
:accuracy_metric_type rdf:type owl:NamedIndividual ,
                               eval:MetricType ;
                      rdfs:label "Accuracy" .


###  https://k.loria.fr/ontologies/evaluationonto-individuals#convex_hull_distance_regression_task
:convex_hull_distance_regression_task rdf:type owl:NamedIndividual ,
                                               eval:RegressionTask ;
                                      rdfs:comment "Evaluate the mean absolute error between predicted and DFT convex hull distance." ;
                                      rdfs:label "Convex hull distance regression" .


###  https://k.loria.fr/ontologies/evaluationonto-individuals#daf_metric_type
:daf_metric_type rdf:type owl:NamedIndividual ,
                          eval:MetricType ;
                 rdfs:label "DAF" .


