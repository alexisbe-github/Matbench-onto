@prefix : <https://k.loria.fr/ontologies/datasetonto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://k.loria.fr/ontologies/datasetonto#> .

<https://k.loria.fr/ontologies/datasetonto> rdf:type owl:Ontology ;
                                             owl:versionIRI <https://k.loria.fr/ontologies/datasetonto> ;
                                             owl:imports <http://www.w3.org/ns/dcat3> ,
                                                         <http://www.w3.org/ns/prov-o-inverses-20130430> .

#################################################################
#    Object Properties
#################################################################

###  https://k.loria.fr/ontologies/datasetonto#hasDataRepresentation
:hasDataRepresentation rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :Dataset ;
                       rdfs:range :DataRepresentation .


###  https://k.loria.fr/ontologies/datasetonto#hasLabellingMethod
:hasLabellingMethod rdf:type owl:ObjectProperty ;
                    rdfs:domain :LabeledDataset ;
                    rdfs:range :LabellingMethod .


###  https://k.loria.fr/ontologies/datasetonto#usesAttribute
:usesAttribute rdf:type owl:ObjectProperty ;
               rdfs:domain :Dataset ;
               rdfs:range :DatasetAttribute .


###  https://k.loria.fr/ontologies/datasetonto#usesAttributeAsInputFeature
:usesAttributeAsInputFeature rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf :usesAttribute ;
                             rdfs:domain <https://k.loria.fr/ontologies/trainingonto#TrainingDataset> ;
                             rdfs:range :DatasetAttribute .


###  https://k.loria.fr/ontologies/datasetonto#usesAttributeAsTargetFeature
:usesAttributeAsTargetFeature rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :usesAttribute ;
                              rdfs:domain :LabeledDataset ;
                              rdfs:range :DatasetAttribute .


###  https://k.loria.fr/ontologies/datasetonto#wasDerivedFromDataset
:wasDerivedFromDataset rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf prov:wasDerivedFrom ;
                       rdfs:domain :Dataset ;
                       rdfs:range :Dataset .


#################################################################
#    Data properties
#################################################################

###  https://k.loria.fr/ontologies/datasetonto#hasNumberOfSamples
:hasNumberOfSamples rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Dataset ;
                    rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  https://k.loria.fr/ontologies/datasetonto#DataRepresentation
:DataRepresentation rdf:type owl:Class ;
                    rdfs:subClassOf prov:Entity .


###  https://k.loria.fr/ontologies/datasetonto#Dataset
:Dataset rdf:type owl:Class ;
         rdfs:subClassOf dcat:Dataset ,
                         prov:Collection ;
         rdfs:comment "A collection of values." .


###  https://k.loria.fr/ontologies/datasetonto#DatasetAttribute
:DatasetAttribute rdf:type owl:Class ;
                  rdfs:subClassOf prov:Entity .


###  https://k.loria.fr/ontologies/datasetonto#DatasetSplit
:DatasetSplit rdf:type owl:Class ;
              rdfs:subClassOf :Dataset ;
              rdfs:comment "A subset of a dataset." .


###  https://k.loria.fr/ontologies/datasetonto#LabeledDataset
:LabeledDataset rdf:type owl:Class ;
                rdfs:subClassOf <https://k.loria.fr/ontologies/trainingonto#TrainingDataset> .


###  https://k.loria.fr/ontologies/datasetonto#LabellingMethod
:LabellingMethod rdf:type owl:Class ;
                 rdfs:subClassOf prov:Plan .


###  https://k.loria.fr/ontologies/trainingonto#TrainingDataset
<https://k.loria.fr/ontologies/trainingonto#TrainingDataset> rdf:type owl:Class ;
                                                             rdfs:subClassOf :Dataset .


