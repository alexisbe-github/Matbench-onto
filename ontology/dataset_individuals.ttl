dcterms:hasPart dcterms:description "This property is intended to be used with non-literal values. This property is an inverse property of Is Part Of."@en ;
                rdfs:comment "A related resource that is included either physically or logically in the described resource."@en ;
                rdfs:isDefinedBy dcterms: ;
