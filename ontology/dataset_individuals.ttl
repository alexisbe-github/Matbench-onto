                        <https://k.loria.fr/ontologies/datasetonto#hasDataRepresentation> :atomistic_graph_data ;
                        <https://k.loria.fr/ontologies/datasetonto#hasLabellingMethod> :first_principles_labelling ;
                        <https://k.loria.fr/ontologies/datasetonto#usesAttributeAsInputFeature> :atomic_numbers_attribute ,
