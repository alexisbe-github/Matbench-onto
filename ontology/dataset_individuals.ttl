                                                                                                 :force_attribute ,
                                                                                                 :stress_attribute ;
                        <https://k.loria.fr/ontologies/datasetonto#wasDerivedFromDataset> :alexandria_dataset ,
                                                                                          :materials_project_dataset_2021 ,
                                                                                          :mattersim_generated_dataset ,
                                                                                          :molecular_dynamics_trajectories_dataset ;
                        <https://k.loria.fr/ontologies/datasetonto#hasNumberOfSamples> 17000000 ;
                        <http://purl.org/dc/elements/1.1/description> "Large-scale first-principles-Labeled atomistic dataset used to train MatterSim." ;
                        <http://purl.org/dc/elements/1.1/title> "Mattersim training dataset" ;
                        <http://www.w3.org/ns/dcat#distribution> :mattersim_training_dataset_distribution .


