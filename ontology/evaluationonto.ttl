<https://k.loria.fr/ontologies/evaluationonto> rdf:type owl:Ontology ;
                                                owl:imports <http://www.w3.org/ns/prov-o-20130430> ,
                                                            <https://k.loria.fr/ontologies/architectureonto> ,
                                                            <https://k.loria.fr/ontologies/datasetonto> ,
                                                            <https://k.loria.fr/ontologies/trainingonto> .

#################################################################
#    Object Properties
#################################################################

###  https://k.loria.fr/ontologies/evaluationonto#evaluatesModelVariant
:evaluatesModelVariant rdf:type owl:ObjectProperty ;
                       rdfs:domain :MachineLearningEvaluationRun ;
                       rdfs:range <https://k.loria.fr/ontologies/architectureonto#ModelVariant> .


###  https://k.loria.fr/ontologies/evaluationonto#evaluatesTask
:evaluatesTask rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :MachineLearningEvaluationRun ;
               rdfs:range :Task .


###  https://k.loria.fr/ontologies/evaluationonto#hasBenchmarkRelease
:hasBenchmarkRelease rdf:type owl:ObjectProperty ;
                     rdfs:domain :BenchmarkSuite ;
                     rdfs:range :BenchmarkRelease .


###  https://k.loria.fr/ontologies/evaluationonto#hasMetricResult
:hasMetricResult rdf:type owl:ObjectProperty ;
                 rdfs:domain :BenchmarkResult ;
                 rdfs:range :MetricResult .


###  https://k.loria.fr/ontologies/evaluationonto#hasResultTask
:hasResultTask rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :BenchmarkResult ;
               rdfs:range :Task .


###  https://k.loria.fr/ontologies/evaluationonto#hasMetricType
:hasMetricType rdf:type owl:ObjectProperty ;
               rdfs:domain :MetricResult ;
               rdfs:range :MetricType .


###  https://k.loria.fr/ontologies/evaluationonto#hasSplit
:hasSplit rdf:type owl:ObjectProperty ;
          rdfs:domain :Fold ;
          rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasTask
:hasTask rdf:type owl:ObjectProperty ;
         rdfs:domain :BenchmarkRelease .


###  https://k.loria.fr/ontologies/evaluationonto#hasTestSplit
:hasTestSplit rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasSplit ;
              rdfs:domain :Fold ;
              rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasTrainSplit
:hasTrainSplit rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasSplit ;
               rdfs:domain :Fold ;
               rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasValidationSplit
:hasValidationSplit rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasSplit .


###  https://k.loria.fr/ontologies/evaluationonto#producesMetricResult
:producesMetricResult rdf:type owl:ObjectProperty ;
                      rdfs:domain :Fold ;
                      rdfs:range :MetricResult .


###  https://k.loria.fr/ontologies/evaluationonto#producesBenchmarkResult
:producesBenchmarkResult rdf:type owl:ObjectProperty ;
                         rdfs:domain :MachineLearningEvaluationRun ;
                         rdfs:range :BenchmarkResult .


###  https://k.loria.fr/ontologies/evaluationonto#usesBenchmarkRelease
:usesBenchmarkRelease rdf:type owl:ObjectProperty ;
                      rdfs:domain :MachineLearningEvaluationRun ;
                      rdfs:range :BenchmarkRelease .


###  https://k.loria.fr/ontologies/evaluationonto#usesDataset
:usesDataset rdf:type owl:ObjectProperty ;
             rdfs:domain :Task ;
             rdfs:range <https://k.loria.fr/ontologies/datasetonto#Dataset> .


#################################################################
#    Data properties
#################################################################

###  https://k.loria.fr/ontologies/evaluationonto#hasIndex
:hasIndex rdf:type owl:DatatypeProperty ;
          rdfs:domain :Fold .


###  https://k.loria.fr/ontologies/evaluationonto#hasMetricValue
:hasMetricValue rdf:type owl:DatatypeProperty ;
                rdfs:domain :MetricResult ;
                rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  https://k.loria.fr/ontologies/evaluationonto#AggregationFunction
:AggregationFunction rdf:type owl:Class ;
                     rdfs:subClassOf <https://k.loria.fr/ontologies/trainingonto#MathematicalFunction> .


###  https://k.loria.fr/ontologies/evaluationonto#BenchmarkRelease
:BenchmarkRelease rdf:type owl:Class ;
                  rdfs:subClassOf :BenchmarkSuite .


###  https://k.loria.fr/ontologies/evaluationonto#BenchmarkResult
:BenchmarkResult rdf:type owl:Class .


###  https://k.loria.fr/ontologies/evaluationonto#BenchmarkSuite
:BenchmarkSuite rdf:type owl:Class .


###  https://k.loria.fr/ontologies/evaluationonto#ClassificationTask
:ClassificationTask rdf:type owl:Class ;
                    rdfs:subClassOf :Task .


###  https://k.loria.fr/ontologies/evaluationonto#Fold
:Fold rdf:type owl:Class .


###  https://k.loria.fr/ontologies/evaluationonto#MachineLearningEvaluationRun
:MachineLearningEvaluationRun rdf:type owl:Class ;
                              rdfs:subClassOf prov:Activity .


###  https://k.loria.fr/ontologies/evaluationonto#MetricResult
:MetricResult rdf:type owl:Class .


###  https://k.loria.fr/ontologies/evaluationonto#MetricType
:MetricType rdf:type owl:Class .


###  https://k.loria.fr/ontologies/evaluationonto#RegressionTask
:RegressionTask rdf:type owl:Class ;
                rdfs:subClassOf :Task .


###  https://k.loria.fr/ontologies/evaluationonto#Task
:Task rdf:type owl:Class .


