###  https://k.loria.fr/ontologies/evaluationonto#hasSplit
:hasSplit rdf:type owl:ObjectProperty ;
          rdfs:domain :Fold ;
          rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasTask
:hasTask rdf:type owl:ObjectProperty ;
         rdfs:domain :BenchmarkRelease ;
         rdfs:range :BenchmarkTask .


###  https://k.loria.fr/ontologies/evaluationonto#hasTestSplit
:hasTestSplit rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasSplit ;
              rdfs:domain :Fold ;
              rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasTrainSplit
:hasTrainSplit rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasSplit ;
               rdfs:domain :Fold ;
               rdfs:range <https://k.loria.fr/ontologies/datasetonto#DatasetSplit> .


###  https://k.loria.fr/ontologies/evaluationonto#hasValidationSplit
:hasValidationSplit rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasSplit .


###  https://k.loria.fr/ontologies/evaluationonto#producesMetricResult
:producesMetricResult rdf:type owl:ObjectProperty ;
                      rdfs:domain :Fold ;
                      rdfs:range :MetricResult .


###  https://k.loria.fr/ontologies/evaluationonto#usesDataset
:usesDataset rdf:type owl:ObjectProperty ;
             rdfs:domain :BenchmarkResult ;
             rdfs:range <https://k.loria.fr/ontologies/datasetonto#Dataset> .


